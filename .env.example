# ============================================================================
# .env.example - Template de Variáveis de Ambiente
# chatgpt-docker-puppeteer
# ============================================================================
#
# INSTRUÇÕES:
# 1. Use `.env` como baseline local e `.env.local` para segredos/overrides pessoais
# 2. Para criar um override local, prefira: cp .env.local.example .env.local
# 3. Use `.env.expert.example` como catálogo dos knobs avançados que não entram no baseline
# 4. Ajuste os valores conforme seu ambiente
# 5. NUNCA commite arquivos .env locais no git (apenas templates versionados)
#
# RESOLUÇÃO DE CONFIGURAÇÃO:
# 1. O processo nasce com o ambiente do container/shell (containerEnv, --env-file, remoteEnv, export)
# 2. `.env` adiciona defaults locais sem sobrescrever o que já existe
# 3. `.env.${NODE_ENV}`, `.env.local` e `.env.${NODE_ENV}.local` sobrescrevem chaves repetidas
# 4. Para chaves cobertas por `ConfigurationManager`, `config.json` sobrescreve os defaults vindos do env
# 5. Na ausência de override explícito, valem os defaults embutidos no código/schema
#
# ============================================================================

# ============================================================================
# [1] AMBIENTE E EXECUÇÃO
# ============================================================================

# Ambiente de execução (development, production, test)
NODE_ENV=development

# Modo do servidor (split, integrated)
# split: Agente + Dashboard em processos separados (PM2)
# integrated: Tudo em um processo único
SERVER_MODE=split

# Autoridade do servidor (standalone, orchestrated)
# standalone: Processo autônomo
# orchestrated: Parte de um cluster gerenciado
SERVER_AUTHORITY=standalone

# Compat transitória de entrypoint:
# false = import puro não dispara boot
# true  = permite auto-start explícito fora de execução direta
MAESTRO_ENTRY_AUTOSTART=false

# ============================================================================
# [2] PORTAS E NETWORKING
# ============================================================================

# Porta do Dashboard Web
SERVER_PORT=3008

# PORT (DEPRECATED v6.0)
# ATENÇÃO: Use SERVER_PORT em vez de PORT
# PORT foi descontinuado para evitar duplicação
# PORT=3008  # ← NÃO USE

# Porta do Chrome Proxy Service (Container → Windows)
CHROME_PROXY_PORT=9224

# Host onde o container enxerga o proxy local do Chrome
CHROME_PROXY_HOST=localhost

# Porta do Chrome no Windows (Remote Debugging)
CHROME_PORT=9225

# Host do Chrome (para proxy)
# Docker Desktop: host.docker.internal
# WSL2: 172.17.0.1 ou IP do host
CHROME_HOST=host.docker.internal

# Bind do proxy (0.0.0.0 = aceita de qualquer IP)
CHROME_PROXY_BIND=0.0.0.0

# IP público do container (auto-detectado se não configurado)
# Exemplo: 172.17.0.2 (Docker), 192.168.x.x (bridge custom)
PUBLIC_IP=

# Host para bind do servidor HTTP
HOST=0.0.0.0

# Limite de portas para port hunting (se PORT ocupado)
PORT_HUNT_LIMIT=5

# Timeout para descoberta de servidor (ms)
SERVER_DISCOVERY_TIMEOUT=30000

# ============================================================================
# [3] CHROME BROWSER CONFIGURATION
# ============================================================================

# Modo de conexão com browser
# launcher: Puppeteer inicia Chrome (não recomendado em Docker)
# connect: Conecta via browserURL (HTTP)
# wsEndpoint: Conecta via WebSocket (RECOMENDADO - usa proxy)
# executablePath: Usa binário explícito gerenciado fora do fluxo padrão
# external: Integração com browser externo já provisionado
# auto: Tenta todos com fallback
BROWSER_MODE=wsEndpoint

# Desabilitar launch local do Puppeteer (forçar conexão remota)
PUPPETEER_LOCAL_LAUNCH_DISABLED=true

# Mock Chrome (para testes sem Chrome real)
MOCK_CHROME=0

# ============================================================================
# [4] BROWSER POOL
# ============================================================================

# Tamanho do pool de browsers
BROWSER_POOL_SIZE=3

# Tentativas máximas ao alocar uma página do pool
# Se comentado, o runtime calcula dinamicamente a partir do pool size
# BROWSER_ALLOCATE_MAX_ATTEMPTS=9

# Estratégia de alocação (round-robin, least-loaded, target-affinity)
ALLOCATION_STRATEGY=round-robin

# Intervalo de health check do browser (ms)
HEALTH_CHECK_INTERVAL=30000

# Permitir modo degradado (continuar sem browser saudável)
ALLOW_DEGRADED_MODE=true

# Retry automático em falhas do Chrome
AUTO_RETRY_CHROME=true
MAX_AUTO_RETRIES=2

# Tentativas máximas de conexão
MAX_CONNECTION_ATTEMPTS=5

# Timeout de conexão (ms)
CONNECTION_TIMEOUT=30000

# Retry canônico de boot/reconexão (backoff exponencial com jitter)
BOOT_RETRY_BASE_MS=1000
BOOT_RETRY_MAX_MS=8000
BOOT_RETRY_MAX_ATTEMPTS=10

# Política de readiness degradado (true = permite status "degraded" sem abortar boot)
BOOT_DEGRADED_READY_ALLOWED=true

# TTL de páginas no pool (ms)
# Páginas alocadas por mais tempo que este valor são automaticamente fechadas
# durante o health check (previne memory leaks de contextos esquecidos)
# Default: 3600000ms (1 hora)
BROWSER_PAGE_TTL_MS=3600000

# ============================================================================
# [5] CHROME PROXY SERVICE (v3.0) - Security & Performance Hardening
# ============================================================================

# Integração NERV (sistema de eventos)
NERV_INTEGRATION=true

# Timeout idle de WebSocket (ms)
# 300000 = 5 minutos (LLM-friendly)
# v3.0: Now uses TCP keep-alive + setTimeout (corrected from ping/pong)
WS_IDLE_TIMEOUT_MS=300000

# Origens CORS permitidas (separadas por vírgula)
# IMPORTANTE: Adicione origens de produção aqui
# v3.0: Security fix - rejects unmatched origins (no default fallback)
ALLOWED_ORIGINS=http://localhost:3008,http://127.0.0.1:3008,http://localhost:8080,http://127.0.0.1:8080

# WebSocket Rate Limiting (DoS Protection - v3.0)
# Limite global de conexões WebSocket simultâneas
CHROME_PROXY_MAX_WS_GLOBAL=200

# Limite de conexões WebSocket por IP
CHROME_PROXY_MAX_WS_PER_IP=20

# Tamanho máximo de buffer para respostas JSON (bytes)
# 10485760 = 10MB (previne DoS por buffering excessivo)
# v3.0: Only /json/* paths buffered, others streamed
CHROME_PROXY_MAX_JSON_BUFFER=10485760

# Circuit Breaker Configuration (v3.0 - integrated)
# Número de falhas consecutivas para abrir o circuit breaker
CHROME_CB_THRESHOLD=5

# Tempo de espera antes de tentar reconectar (ms)
CHROME_CB_TIMEOUT=30000

# ============================================================================
# [6] LOGGING E TELEMETRIA
# ============================================================================

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# Buffer do NERV (número de eventos)
NERV_BUFFER_SIZE=1000

# Telemetria do NERV (true/false)
NERV_TELEMETRY=true

# ============================================================================
# [7] KERNEL E EXECUTION ENGINE
# ============================================================================

# Intervalo do ciclo do Kernel (ms)
# 50ms = 20 Hz (padrão)
KERNEL_CYCLE_INTERVAL=50

# ============================================================================
# [8] CONTEXT MANAGEMENT
# ============================================================================

# Estratégia de contexto (sliding_window, cumulative)
CONTEXT_STRATEGY=sliding_window

# Tokens máximos de contexto
CONTEXT_MAX_TOKENS=100000

# Política de sumarização (on_overflow, periodic, none)
SUMMARIZATION_POLICY=on_overflow

# ============================================================================
# [9] MISSIONS E CHECKPOINTS
# ============================================================================

# Diretório base de missões
MISSIONS_DIR=missions

# Número de checkpoints a manter
CHECKPOINT_KEEP_LAST=10

# ============================================================================
# [10] DRIVER FACTORY
# ============================================================================

# Target padrão do driver (chatgpt, gemini)
FACTORY_DEFAULT_TARGET=chatgpt

# Validar drivers no boot (true/false)
FACTORY_VALIDATE_BOOT=false

# Hot pool do driver (mantém drivers pré-aquecidos)
DRIVER_HOT_POOL_ENABLED=true

# Permitir tentativa de auto-start do Chrome quando a stack de boot suportar
AUTO_START_CHROME=false

# MCP Integration (Multi-LLM Tool Server)
MCP_ENABLED=true

# ----------------------------------------------------------------------------
# Optional: Upstream MCP (import tools from an existing MCP server over HTTP)
# ----------------------------------------------------------------------------
# When enabled, this server will call the upstream `tools/list` and register
# all upstream tools locally with a prefix (avoids name collisions).
#
# Example local tool name: mcp_core__tools_list
#
# Enable upstream tool import (true/false)
MCP_UPSTREAM_ENABLED=false

# Upstream MCP endpoint (JSON-RPC 2.0 over HTTP)
# Example: http://localhost:4000/api/mcp
MCP_UPSTREAM_URL=

# Human-friendly alias used in tool descriptions/prefix (default: upstream)
MCP_UPSTREAM_ALIAS=upstream

# Tool name prefix for imported tools (default: mcp_<alias>__)
MCP_UPSTREAM_TOOL_PREFIX=

# Optional extra headers (JSON object) for upstream auth
# Example: {"Authorization":"Bearer YOUR_TOKEN"}
MCP_UPSTREAM_HEADERS_JSON=

# ----------------------------------------------------------------------------
# Optional: Multi-upstream config (advanced)
# ----------------------------------------------------------------------------
# Configure multiple upstream MCP servers in one JSON array. If set, this takes
# precedence over the legacy MCP_UPSTREAM_* variables.
#
# Example:
# MCP_UPSTREAMS_JSON=[{"alias":"core","transport":"http","url":"http://localhost:4000/api/mcp","toolPrefix":"mcp_core__"}]
MCP_UPSTREAMS_JSON=

# Force re-import upstream tools on boot (true/false)
MCP_UPSTREAM_REFRESH=false

# Hooks globais SIGINT/SIGTERM/exit no upstream manager
# false recomendado quando lifecycle do processo já é owner de shutdown
MCP_UPSTREAM_INSTALL_GLOBAL_HOOK=false

# Upstream init timeout (ms) for stdio transports (default: 30000)
MCP_UPSTREAM_INIT_TIMEOUT_MS=30000

# Best-effort retry: if an upstream fails on boot, attempt to re-import tools later.
# Defaults are conservative and OFF by default.
MCP_UPSTREAM_RESTART_ENABLED=false
MCP_UPSTREAM_RESTART_BACKOFF_MS=5000
MCP_UPSTREAM_RESTART_MAX=10

# ----------------------------------------------------------------------------
# GitHub MCP Proxy (Optional - Proxy/Upstream mode via stdio)
# ----------------------------------------------------------------------------
# When enabled, this server spawns the GitHub MCP server (stdio) and imports
# its tools into our registry with a prefix (default: mcp_github__).
#
# Requires: GITHUB_PERSONAL_ACCESS_TOKEN (do NOT commit tokens)
MCP_GITHUB_PROXY_ENABLED=false
MCP_GITHUB_TOOL_PREFIX=mcp_github__
MCP_GITHUB_COMMAND=npx
MCP_GITHUB_ARGS_JSON=["-y","@modelcontextprotocol/server-github"]

# ----------------------------------------------------------------------------
# GitHub MCP Integration (Optional - requires @modelcontextprotocol/server-github)
# ----------------------------------------------------------------------------
# GitHub Personal Access Token for GitHub MCP Server
# Generate at: https://github.com/settings/tokens/new
# Required scopes: repo, read:org, user
#
# SECURITY WARNING: Never commit real tokens to Git!
# Use .env.local (gitignored) or environment secrets manager
#
# Installation:
#   npm install -g @modelcontextprotocol/server-github
#
# Usage: Configure in your MCP client (Claude Desktop, etc.)
# See: docs/integration/GITHUB_MCP_INTEGRATION.md
GITHUB_PERSONAL_ACCESS_TOKEN=

# ============================================================================
# [11] TRIAGE MODULE (Diagnóstico de Interface)
# ============================================================================

# Threshold de lag (ms)
TRIAGE_LAG_THRESHOLD=1500

# Tentativas de retry em lag
TRIAGE_LAG_RETRIES=3

# Delay de snapshot (ms)
TRIAGE_SNAPSHOT_DELAY=600

# Máximo de partes de texto a analisar
TRIAGE_MAX_TEXT_PARTS=1000

# Profundidade máxima de scan
TRIAGE_MAX_DEPTH=15

# Timeout de diagnóstico (ms)
TRIAGE_TIMEOUT=10000

# Timeout de scan (ms)
TRIAGE_SCAN_TIMEOUT=5000

# Thresholds de cor para erro (RGB)
TRIAGE_RED_THRESHOLD=180
TRIAGE_ORANGE_THRESHOLD=200

# Threshold de tamanho de iframe (proporção da tela)
TRIAGE_IFRAME_THRESHOLD=0.4

# ============================================================================
# [12] FRAME NAVIGATOR MODULE
# ============================================================================

# Profundidade máxima de frames
FRAME_NAV_MAX_DEPTH=10

# Timeout de traversal (ms)
FRAME_NAV_TIMEOUT=15000

# Timeout de bounding box (ms)
FRAME_NAV_BBOX_TIMEOUT=2000

# Tentativas de dispose
FRAME_NAV_DISPOSE_RETRIES=3

# Delay de dispose (ms)
FRAME_NAV_DISPOSE_DELAY=100

# ============================================================================
# [13] BIOMECHANICS ENGINE MODULE (Interação Humana)
# ============================================================================

# Iterações máximas de wait
BIOMECH_MAX_ITERATIONS=50

# Intervalo keep-alive (ms)
BIOMECH_KEEP_ALIVE=25000

# Intervalo de poll em wait (ms)
BIOMECH_WAIT_POLL=800

# Tentativas para rect estável
BIOMECH_STABLE_ATTEMPTS=10

# Tolerância de estabilidade (px)
BIOMECH_STABLE_TOLERANCE=0.5

# Poll para rect estável (ms)
BIOMECH_STABLE_POLL=60

# Timeout para rect estável (ms)
BIOMECH_STABLE_TIMEOUT=5000

# Offset de scroll (proporção da tela)
BIOMECH_SCROLL_OFFSET=0.15

# Offset máximo de scroll (proporção)
BIOMECH_SCROLL_MAX=0.3

# Delay pós-scroll (ms)
BIOMECH_POST_SCROLL_DELAY=500

# Threshold de caracteres para Zen Mode
BIOMECH_ZEN_THRESHOLD=2000

# Timeout de Zen Mode (ms)
BIOMECH_ZEN_TIMEOUT=30000

# Timeout de digitação humana (ms)
BIOMECH_HUMAN_TIMEOUT=60000

# Threshold de echo para texto longo
BIOMECH_ECHO_LONG=0.6

# Threshold de echo para texto curto
BIOMECH_ECHO_SHORT=0.5

# TTL do cache de modifiers (ms)
BIOMECH_MODIFIER_TTL=3600000

# ============================================================================
# [14] RECOVERY SYSTEM MODULE
# ============================================================================

# Timeout de kill (ms)
RECOVERY_KILL_TIMEOUT=5000

# Timeout de reload (ms)
RECOVERY_RELOAD_TIMEOUT=30000

# Backoff base Tier 0 (ms)
RECOVERY_TIER0_BACKOFF=1200

# Incremento de backoff Tier 0 (ms)
RECOVERY_TIER0_INCREMENT=800

# Timeout de focus (ms)
RECOVERY_FOCUS_TIMEOUT=2000

# Máximo de retries por tier
RECOVERY_MAX_RETRIES=2

# ============================================================================
# [15] SUBMISSION CONTROLLER MODULE
# ============================================================================

# Duração do lock (ms)
SUBMISSION_LOCK_DURATION=3000

# Delay pré-press (ms)
SUBMISSION_PRE_PRESS=300

# Debounce fallback (ms)
SUBMISSION_DEBOUNCE=400

# Debounce máximo (ms)
SUBMISSION_DEBOUNCE_MAX=600

# Delay pós-send (ms)
SUBMISSION_POST_SEND=500

# Timeout total da submissão (ms)
SUBMISSION_TIMEOUT=10000

# Retries sintéticos máximos
SUBMISSION_MAX_RETRIES=2

# ============================================================================
# [16] DASHBOARD E AUTENTICAÇÃO
# ============================================================================

# Origem do dashboard (para CORS)
DASHBOARD_ORIGIN=http://localhost:3008

# Segurança (strict por padrão)
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=CHANGE_ME_MIN_12_CHARS
DASHBOARD_SOCKET_AUTH_REQUIRED=true
DASHBOARD_COMMANDS_ENABLED=false
DASHBOARD_COMMAND_ROLE=admin
DASHBOARD_TASK_SYNC_MODE=ssot_feed
DASHBOARD_LEGACY_BRIDGE_CONTINGENCY=false
DASHBOARD_EMIT_TASK_UPDATED_COMPAT=false
CONTROL_REQUIRE_REASON=true
CONTROL_REQUIRE_IDEMPOTENCY_KEY=true
CONTROL_STRICT_PAUSE_TO_EDIT=true
RBAC_BOOTSTRAP_OWNER_USERNAME=
RBAC_BOOTSTRAP_OWNER_PASSWORD=
UI_PREFS_PERSISTENCE=sqlite
LEGACY_PATHS_CONTINGENCY=false
MISSION_STEP_DISPATCH_MODE=ssot_queue
MISSION_MANAGER_LEGACY_DISPATCH_ENABLED=false

# JWT (obrigatório para auth/socket do dashboard)
# Gere um valor forte (64+ chars recomendados):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Rate limits (HTTP API)
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_DEV=2000

# ============================================================================
# [17] RUNTIME AVANÇADO (Orquestração, SSOT e HTTP)
# ============================================================================

# Override explícito de endpoint WebSocket do Chrome (quando já houver um browser pronto)
CHROME_WS_ENDPOINT=

# Deixe o proxy cuidar de SIGINT/SIGTERM automaticamente
CHROME_PROXY_AUTO_HANDLE_SIGNALS=true

# Forçar HTTPS mesmo fora de production
FORCE_HTTPS=false

# Caminhos TLS locais (usados quando HTTPS está ativo)
SSL_KEY_PATH=ssl/key.pem
SSL_CERT_PATH=ssl/cert.pem

# Rotação máxima de arquivos de log
LOG_MAX_ARCHIVES=5

# Expiração padrão dos JWTs emitidos pelo dashboard
JWT_EXPIRY=24h

# Timeout global do router HTTP (ms)
API_REQUEST_TIMEOUT=30000

# Timeout de reload quente de configuração (ms)
CONFIG_RELOAD_TIMEOUT_MS=5000

# Timeout para init do SSOT (ms)
SSOT_INIT_TIMEOUT_MS=30000

# Agendadores internos (ms)
TASK_CONTROL_INTERVAL_MS=500
QUEUE_WORKER_INTERVAL_MS=250
QUEUE_WORKER_LOCK_TTL_MS=60000
QUEUE_MAX_CONCURRENT_TASKS=2
MISSION_RUNNER_INTERVAL_MS=1000
MISSION_PLANNER_INTERVAL_MS=1500
ATTEMPT_WATCHDOG_INTERVAL_MS=1500
ATTEMPT_DISPATCHED_STUCK_MS=30000
ATTEMPT_WATCHDOG_RESCHEDULE_DELAY_MS=1000
HEARTBEAT_WATCHDOG_INTERVAL_MS=60000
HEARTBEAT_STALE_THRESHOLD_MS=180000
TASK_ORCHESTRATION_INTERVAL_MS=1250
TASK_ORCHESTRATION_BATCH_SIZE=50
TASK_CONTROL_ABORT_TIMEOUT_MS=1500
TASK_CONTROL_ABORT_MAX_RETRIES=2

# Feed SSOT (dashboard realtime)
SSOT_EVENT_FEED_ENABLED=true
SSOT_EVENT_FEED_FROM_START=false
SSOT_EVENT_FEED_INTERVAL_MS=250
SSOT_EVENT_FEED_BATCH_LIMIT=500

# Telemetria interna do dashboard (ms)
DASHBOARD_TELEMETRY_INTERVAL_MS=1000

# ============================================================================
# [18] FILAS, STORAGE E LIMITES
# ============================================================================

# Profundidade máxima da fila persistida
MAX_QUEUE_DEPTH=10000

# Limites de payload textual em tasks
QUEUE_INPUT_MAX_CHARS=50000
QUEUE_INPUT_MAX_TOTAL_CHARS=200000

# Overrides opcionais de paths persistentes
MAESTRO_DB_PATH=
MAESTRO_ARTIFACTS_DIR=

# Limites máximos por artefato (bytes)
MAX_TEXT_ARTIFACT_BYTES=52428800
MAX_BINARY_ARTIFACT_BYTES=104857600
MAX_JSON_ARTIFACT_BYTES=10485760

# ============================================================================
# [19] SIDECARS OPCIONAIS (Gateway, Audit Agent, Diagnostics)
# ============================================================================

# Inference Gateway (cliente usa enabled=true como fallback; deixe comentado se não quiser fixar)
# INFERENCE_GATEWAY_ENABLED=true
INFERENCE_GATEWAY_HOST=127.0.0.1
INFERENCE_GATEWAY_PORT=3099
INFERENCE_GATEWAY_TIMEOUT_MS=120000
INFERENCE_GATEWAY_DEFAULT_MODEL=llama3.2

# Audit Agent
AUDIT_AGENT_ENABLED=false
AUDIT_AGENT_MODE=semi_auto
AUDIT_AGENT_MAX_CONCURRENT_JOBS=1
AUDIT_AGENT_MAX_PARALLEL_LLM_CALLS=1
AUDIT_AGENT_TRIGGER_DEBOUNCE_MS=5000
AUDIT_AGENT_JOB_COOLDOWN_MS=30000
AUDIT_AGENT_HOST=127.0.0.1
AUDIT_AGENT_PORT=3098
AUDIT_AGENT_PERSIST_DB=true
AUDIT_AGENT_HYDRATE_ON_START=true
AUDIT_AGENT_HYDRATE_LIMIT=200
AUDIT_AGENT_CONTEXT_MCP_BUDGET=5
AUDIT_AGENT_CONTEXT_USE_MCP_TOOLS=true
AUDIT_AGENT_TRIAGE_LLM_ENABLED=false
AUDIT_AGENT_TRIAGE_PROFILE_NAME=
AUDIT_AGENT_LLM_MODEL_TRIAGE=
AUDIT_AGENT_LLM_TIMEOUT_MS=120000
AUDIT_AGENT_TRIAGE_MAX_TOKENS=300
AUDIT_AGENT_PATCH_AUTHOR_LLM_ENABLED=false
AUDIT_AGENT_PATCH_AUTHOR_PROFILE_NAME=
AUDIT_AGENT_LLM_MODEL_PATCH=
AUDIT_AGENT_PATCH_AUTHOR_MAX_TOKENS=700

# Diagnostic agent consumers
DIAGNOSTIC_AGENT_HOST=127.0.0.1
DIAGNOSTIC_AGENT_PORT=3097
DIAGNOSTIC_DEFAULT_TIMEOUT_MS=30000

# ============================================================================
# [20] SNAPSHOT E MONITORAMENTO
# ============================================================================

# Intervalo de snapshot (ms)
# Comentado por padrão (desabilitado)
# SNAPSHOT_INTERVAL_MS=60000

# ============================================================================
# [21] LEGACY (Deprecados)
# ============================================================================

# Habilitar arquivo estado.json (legado)
# DEPRECATED: Use NERV SERVER_READY event
ENABLE_STATE_FILE=false

# ============================================================================
# [21.5] OLLAMA CLOUD & LOCAL INTEGRATION (v5.0)
# ============================================================================
#
# Dual-URL Architecture: Cloud (generation) + Local (embeddings)
# - Ollama Cloud (https://ollama.com): Powerful GPU models for coding/chat
# - Ollama Local (host.docker.internal:11434): Local embeddings for RAG
#
# Migration from v4.x:
# - v4.x used only local Ollama (http://host.docker.internal:11434)
# - v5.0 separates cloud (generation) from local (embeddings)
#
# Documentation:
# - https://docs.ollama.com/cloud (Cloud service overview)
# - https://ollama.com/pricing (Subscription plans)
# - https://ollama.com/settings/api-keys (Create API key)
#
# ============================================================================

# ----------------------------------------------------------------------------
# Ollama Cloud (Generation - https://ollama.com)
# ----------------------------------------------------------------------------
# Ollama Cloud provides powerful cloud GPUs for running large models fast.
# Used for: Text generation (coding, chat)
# Required: API key from https://ollama.com/settings/api-keys

# Ollama Cloud Base URL (default: https://ollama.com)
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# Ollama Cloud API Key (REQUIRED for cloud generation)
# Generate at: https://ollama.com/settings/api-keys
# WARNING: Never commit real API keys to Git! Use .env.local (gitignored)
OLLAMA_CLOUD_API_KEY=

# Enable/disable cloud runtime for non-embedding operations
OLLAMA_CLOUD_ENABLED=true

# Default Models for Cloud Generation
# qwen3-coder-next: 80B MoE (3B active), 256k context, coding agents
# qwen3-next:80b-cloud: 80B hybrid attention, high-sparsity MoE, general chat
# Released: February 2026
OLLAMA_DEFAULT_MODEL=qwen3-coder-next
OLLAMA_CHAT_MODEL=qwen3-next:80b-cloud

# ----------------------------------------------------------------------------
# Copilot Terminal BYOK (opcional; knobs avancados em .env.expert.example)
# ----------------------------------------------------------------------------
# Quando habilitado, a LLM-B usa o campo `provider` nativo do SDK Copilot.
# Segredos devem ficar em .env.local; este baseline mostra apenas o contrato.
COPILOT_BYOK_ENABLED=false
COPILOT_BYOK_PROFILE=
COPILOT_BYOK_PROVIDER_PRESET=
COPILOT_BYOK_MODEL=
COPILOT_BYOK_BASE_URL=
COPILOT_BYOK_MODEL_DISCOVERY_ENABLED=true
# Limites opcionais para seleção/admissão operacional: maxReq, TPM, RPM e RPD.
# Declare em .env.local quando o plano free do provider for menor que a janela de contexto.
# COPILOT_BYOK_MAX_REQUEST_TOKENS=
# COPILOT_BYOK_TOKENS_PER_MINUTE=
# COPILOT_BYOK_REQUESTS_PER_MINUTE=
# COPILOT_BYOK_DAILY_REQUESTS=
# Perfis e segredos ficam apenas em .env.local:
# Presets suportados incluem: kilo-code, ollama-cloud, ollama-local, openrouter, groq,
# gemini, mistral, huggingface, cloudflare-workers-ai, nvidia-nim, cerebras, chutes e zai.
# COPILOT_BYOK_PROFILES_JSON='{"openrouter-free":{"preset":"openrouter","model":"openrouter/free","apiKeyEnv":"OPENROUTER_API_KEY"}}'
# KILO_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# HUGGING_FACE_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Current default: permanent Cloudflare named tunnel for aurelin.org.
# Tunnel name: workspace-mcp-dev
# ChatGPT MCP URL: https://mcp.aurelin.org/mcp
# Current default auth: OAuth with the built-in development issuer on the MCP origin.
# Use Authentication=OAuth in ChatGPT.
# COPILOT_MCP_AUTH_MODE=oauth
# COPILOT_MCP_AUTH_ENFORCEMENT=all
# COPILOT_MCP_PUBLIC_URL=https://mcp.aurelin.org/mcp
# COPILOT_MCP_OAUTH_ISSUER=https://mcp.aurelin.org
# COPILOT_MCP_OAUTH_EXPECTED_ISSUER=https://mcp.aurelin.org
# COPILOT_MCP_OAUTH_AUDIENCE=https://mcp.aurelin.org
# COPILOT_MCP_OAUTH_JWKS_URI=https://mcp.aurelin.org/oauth/jwks.json
# COPILOT_MCP_OAUTH_INITIAL_SCOPES=repo:read,repo:write,repo:validate,repo:admin
# COPILOT_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com,https://claude.ai,https://www.claude.ai
# COPILOT_MCP_DEV_OAUTH_ENABLED=true
# COPILOT_MCP_DEV_OAUTH_ACCESS_TOKEN_TTL_SECONDS=86400
# COPILOT_MCP_DEV_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# COPILOT_MCP_DEV_OAUTH_KEY_FILE=src/copilot/.ai/mcp/oauth-dev-private-key.pem
# COPILOT_MCP_DEV_OAUTH_REFRESH_TOKEN_FILE=src/copilot/.ai/mcp/oauth-refresh-tokens.json
# COPILOT_MCP_DEV_OAUTH_CLIENT_FILE=src/copilot/.ai/mcp/oauth-clients.json
# COPILOT_MCP_DEV_OAUTH_ROTATE_KEY=false
# COPILOT_MCP_PUBLIC_OAUTH_DIAGNOSTICS=true
# COPILOT_MCP_INDEX_AUTO_BUILD=true
# COPILOT_MCP_INDEX_AUTO_BUILD_PATH=src/copilot
# COPILOT_MCP_INDEX_AUTO_BUILD_MAX_FILES=5000
# Fallback only:
# COPILOT_MCP_AUTH_MODE=none-dev
# COPILOT_MCP_AUTH_ENFORCEMENT=off
# COPILOT_MCP_CLOUDFLARE_MODE=named-permanent
# COPILOT_MCP_CLOUDFLARE_TUNNEL_NAME=workspace-mcp-dev
# Optional but recommended for deterministic Cloudflare API audits:
# COPILOT_MCP_CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_ZONE_ID=
# COPILOT_MCP_CLOUDFLARE_ZONE=aurelin.org
# COPILOT_MCP_CLOUDFLARE_PUBLIC_HOSTNAME=mcp.aurelin.org
# COPILOT_MCP_CLOUDFLARE_PUBLIC_URL=https://mcp.aurelin.org/mcp
# COPILOT_MCP_CLOUDFLARE_ORIGIN_URL=http://127.0.0.1:3333
# Wrapper default is http2 for Dev Container egress; valid overrides: auto, http2, quic.
# COPILOT_MCP_CLOUDFLARE_PROTOCOL=http2
# Local cloudflared observability. Set metrics to off to disable.
# COPILOT_MCP_CLOUDFLARE_METRICS_ADDR=127.0.0.1:60123
# COPILOT_MCP_CLOUDFLARE_LOGLEVEL=info
# Preferred secret placement for the remotely-managed tunnel token:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=src/copilot/.ai/cloudflare/workspace-mcp-dev.token
# COPILOT_MCP_CLOUDFLARE_PID_FILE=src/copilot/.ai/cloudflare/cloudflared.pid
# COPILOT_MCP_HTTP_PID_FILE=src/copilot/.ai/cloudflare/mcp-http.pid
# Fallback only: temporary TryCloudflare sessions, no fixed domain.
# `COPILOT_MCP_CLOUDFLARE_MODE=temporary-quick npm run copilot:mcp:cloudflare:quick`
# writes the discovered URL to:
# src/copilot/.ai/cloudflare/quick-tunnel.json
# COPILOT_MCP_CLOUDFLARE_STATE_FILE=src/copilot/.ai/cloudflare/quick-tunnel.json
# COPILOT_MCP_CLOUDFLARE_SMOKE_STATE_FILE=src/copilot/.ai/cloudflare/connector-smoke.json
# Direct token env is supported but less preferable because it is easier to leak in shell history.
# CLOUDFLARE_TUNNEL_TOKEN=
# NVIDIA_API_KEY=
# CEREBRAS_API_KEY=
# CHUTES_API_KEY=
# ZAI_API_KEY=

# ----------------------------------------------------------------------------
# Ollama Local (Embeddings + Optional non-embedding fallback)
# ----------------------------------------------------------------------------
# Local Ollama is always required for embeddings (cloud has no embedding endpoint).
# It can also be used for non-embedding when explicitly requested or as fallback.
# Requires: Local Ollama running (docker-compose up ollama OR ollama serve)

# Ollama Local Base URL (default: http://host.docker.internal:11434)
OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434

# Embedding Model (local only)
# nomic-embed-text: 768D embeddings for RAG
OLLAMA_EMBED_MODEL=nomic-embed-text

# ----------------------------------------------------------------------------
# Non-Embedding Runtime Policy (Cloud-First)
# ----------------------------------------------------------------------------
# Policy for generate/chat/model-info operations:
# - auto (default): cloud first, fallback local if enabled
# - cloud: cloud only
# - local: local only
OLLAMA_NON_EMBEDDING_RUNTIME=auto

# Allow automatic cloud -> local fallback in auto mode
OLLAMA_NON_EMBEDDING_LOCAL_FALLBACK=true

# Local model guardrail profile for non-embedding local usage:
# - light (default): conservative CPU-only list (16GB RAM baseline)
# - custom: use OLLAMA_LOCAL_ALLOWED_MODELS when provided
OLLAMA_LOCAL_MODEL_PROFILE=light

# Optional allowlist for local non-embedding models (comma-separated).
# If set, it overrides profile defaults.
# Example: qwen2.5-coder:3b,llama3.2:3b
OLLAMA_LOCAL_ALLOWED_MODELS=

# ----------------------------------------------------------------------------
# DEPRECATED v4.x Configuration (Backward Compatibility)
# ----------------------------------------------------------------------------
# OLLAMA_BASE_URL is deprecated in v5.0 (use OLLAMA_LOCAL_BASE_URL instead)
# If OLLAMA_LOCAL_BASE_URL is not set, OLLAMA_BASE_URL is used as fallback
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # DEPRECATED - use OLLAMA_LOCAL_BASE_URL

# ----------------------------------------------------------------------------
# Timeouts (ms)
# ----------------------------------------------------------------------------
# Generation timeouts (cloud or local)
OLLAMA_GENERATE_TIMEOUT=60000

# Embedding timeouts (local only)
OLLAMA_EMBED_TIMEOUT=30000

# Hard safety cap for embedding input size (chars)
# Increase carefully: higher values improve context but can increase latency/timeouts
OLLAMA_EMBED_MAX_CHARS=8000
# If true, context overflow errors shrink input immediately (recommended)
OLLAMA_EMBED_CONTEXT_FAST_SHRINK=true

# Model listing timeout
OLLAMA_LIST_TIMEOUT=10000

# Health check timeout
OLLAMA_HEALTH_TIMEOUT=5000

# ----------------------------------------------------------------------------
# Generation Parameters
# ----------------------------------------------------------------------------
# Max Tokens for Generation
# 1000 tokens = ~30-60 seconds on cloud (fast), ~5 minutes on local CPU (slow)
OLLAMA_MAX_TOKENS=1000

# ----------------------------------------------------------------------------
# Timeout Cascade (4 layers - aligned to prevent mismatches)
# ----------------------------------------------------------------------------
# This ensures timeouts fire in the correct order:
# Layer 3 (innermost): OLLAMA_GENERATE_TIMEOUT=60000ms (Ollama client)
# Layer 2: TOOL_EXECUTION_TIMEOUT=75000ms (Tool Registry wrapper)
# Layer 1: MCP_TOOL_TIMEOUT=90000ms (MCP handler)
# Layer 0 (outermost): SERVER_REQUEST_TIMEOUT=120000ms (HTTP server)
#
# Why 4 layers?
# - Each layer must complete before the outer one times out
# - 15s gap between layers allows graceful error handling
# - Prevents zombie processes and hanging connections
TOOL_EXECUTION_TIMEOUT=75000
MCP_TOOL_TIMEOUT=90000
SERVER_REQUEST_TIMEOUT=120000

# ----------------------------------------------------------------------------
# RAG / LSP Defaults
# ----------------------------------------------------------------------------
# RAG profile scope:
# - core: src/tests/config files (faster, code-first)
# - dev: core + scripts + tooling docs
# - full: broad workspace indexing/search scope
RAG_PROFILE_DEFAULT=core

# Docs policy for indexing:
# - include: keep current behavior (code + docs)
# - exclude: skip Markdown/MDX (phase 1 code/config only)
# - only: index Markdown/MDX only (phase 2 docs pass)
RAG_DOCS_MODE=include

# Optional custom scope globs (comma-separated)
# Examples:
#   RAG_INCLUDE_GLOBS=src/**,tests/**
#   RAG_EXCLUDE_GLOBS=**/*.md,**/*.mdx
RAG_INCLUDE_GLOBS=
RAG_EXCLUDE_GLOBS=

# Maximum file size accepted by scanner (bytes)
RAG_INDEX_MAX_FILE_BYTES=2000000

# Enable degraded lexical fallback when embeddings are unavailable
RAG_DEGRADED_MODE_ENABLED=true

# AST-aware smart chunking (RAG v2)
RAG_AST_CHUNK_ENABLED=true
RAG_CHUNK_TARGET_CHARS=1800
RAG_CHUNK_MAX_CHARS=2800

# Adaptive indexing throttling (machine-safe performance)
# Metric:
# - auto: prefer system CPU (fallback to process CPU)
# - system: machine-wide CPU usage
# - process: Node process CPU only (legacy behavior)
RAG_THROTTLE_ENABLED=true
RAG_THROTTLE_METRIC=auto
RAG_THROTTLE_TARGET_CPU=72
RAG_THROTTLE_MIN_DELAY_MS=60
RAG_THROTTLE_MAX_DELAY_MS=5000
RAG_THROTTLE_INITIAL_DELAY_MS=260
RAG_THROTTLE_SAMPLE_INTERVAL_MS=1000
RAG_THROTTLE_SAMPLE_SIZE=8
RAG_THROTTLE_SLOWDOWN_FACTOR=1.28
RAG_THROTTLE_SPEEDUP_FACTOR=0.92
RAG_THROTTLE_HIGH_WATERMARK_PCT=8
RAG_THROTTLE_LOW_WATERMARK_PCT=15
RAG_THROTTLE_LOG_COOLDOWN_MS=4000

# Chunk expansion defaults (rag_expand)
RAG_EXPAND_DEFAULT_LINES=40
RAG_EXPAND_MAX_LINES=240

# Incremental RAG watch daemon
RAG_WATCH_ENABLED=true
RAG_WATCH_DEBOUNCE_MS=3000
RAG_WATCH_BATCH_MAX=64

# LSP/tsserver toolchain
LSP_ENABLED=true
LSP_TOOL_TIMEOUT_MS=15000
LSP_MUTATIONS_ENABLED=false
LSP_MAX_RESULTS=200

# Copilot runtime/test helpers
COPILOT_SDK_ENABLED=true
COPILOT_TERMINAL_ENABLED=true
COPILOT_MODEL=auto
COPILOT_MODEL_PERSISTENT_CACHE_ENABLED=true
LLM_B_TERMINAL_PORT=3009
COPILOT_TEST_ARTIFACT_DIR=artifacts
COPILOT_TEST_LIVE_GROUPS=25
COPILOT_TEST_LOG_FULL=0
COPILOT_TEST_LOG_RAW=0
ENABLE_AUDIT_AGENT_PM2_PROCESSES=false
NODE_COMPILE_CACHE=
XDG_CACHE_HOME=

# ============================================================================
# [21.6] MCP TOOL RESILIENCE (Session 6 - Adaptive Timeout & Circuit Breaker)
# ============================================================================
#
# RESUMO: Sistema inteligente de resiliência para MCP tools
# -----------------------------------------------------------
# Este sistema resolve timeouts e falhas de forma automática e inteligente.
#
# 📊 PRIORIDADES (do mais importante para o menos):
#
# 1️⃣ ADAPTIVE TIMEOUT (PRIMÁRIA - RECOMENDADO: LIGADO)
#    - O que faz: Aprende quanto tempo cada tool realmente precisa
#    - Por que é fundamental: Espera adaptativamente o tempo necessário
#    - Como funciona: P99.9999 (média + 5×desvio) + context penalty
#    - Range: 10s a 300s (5min)
#    - Precisão: ~99.9999% dos casos cobertos (1 falso positivo em 1 milhão)
#    - ✅ Resolve causa raiz: timeouts inadequados
#
# 2️⃣ RETRY AUTOMÁTICO (SECUNDÁRIA - RECOMENDADO: LIGADO)
#    - O que faz: Retenta automaticamente em falhas transitórias
#    - Por que ajuda: Network blips, overload temporário
#    - Como funciona: Exponential backoff + jitter (anti thundering herd)
#    - ✅ Funciona sinergicamente com adaptive timeout
#
# 3️⃣ CIRCUIT BREAKER (PROTEÇÃO - RECOMENDADO: LIGADO)
#    - O que faz: Previne thundering herd quando serviço está down
#    - Por que ajuda: Fail-fast, reduz carga em serviço degradado
#    - Como funciona: 3-state (CLOSED → OPEN → HALF_OPEN)
#    - ✅ Proteção essencial para Ollama
#
# 4️⃣ MODEL FALLBACK (OPCIONAL - DEFAULT: DESLIGADO)
#    - O que faz: Downgrade automático para modelo menor/rápido
#    - Trade-off: Velocidade > Qualidade
#    - ⚠️ Não resolve causa raiz (timeout inadequado)
#    - Use apenas se prioriza velocidade sobre qualidade
#
# CONFIGURAÇÃO RECOMENDADA (defaults abaixo):
# - MCP_TOOL_ADAPTIVE_TIMEOUT=true       ✅ Solução primária
# - MCP_TOOL_RETRY_ENABLED=true          ✅ Resiliência adicional
# - OLLAMA_CIRCUIT_BREAKER_ENABLED=true  ✅ Proteção essencial
# - OLLAMA_MODEL_FALLBACK_ENABLED=false  ❌ Opt-in explícito
#
# ----------------------------------------------------------------------------

# Adaptive Timeout: Aprende com histórico de execução (SOLUÇÃO PRIMÁRIA)
# ----------------------------------------------------------------------------
# **RECOMENDADO: Manter habilitado** - Esta é a solução fundamental para timeouts.
#
# O sistema aprende os tempos de execução de cada tool e ajusta automaticamente
# os timeouts baseado em P99.9999 (média + 5×desvio padrão). Ao invés de desistir
# cedo ou fazer downgrade de modelo, o sistema **espera adaptativamente o tempo
# necessário** baseado em performance real observada.
#
# Filosofia: "Aguardar o tempo correto na maioria esmagadora dos casos"
# - P99.9999 (5 desvios padrão) cobre 99.9999% dos casos normais
# - Apenas 1 em 1.000.000 de execuções válidas excede esse tempo
# - Timeout serve para detectar TRAVAMENTO, não limitar performance
#
# Benefícios:
# - Tools rápidos não esperam timeout fixo desnecessário
# - Tools lentos recebem tempo suficiente (até 5min) sem falhar prematuramente
# - Praticamente ZERO falsos positivos (timeouts prematuros em ops legítimas)
# - Adapta-se automaticamente a mudanças (modelo, carga, rede)
# - Aprende com histórico (primeira chamada: 15s, depois: baseado em média)
#
# Fórmula: timeout = learned_avg + (5 × std_dev) + context_penalty
# Range: 10s (mín) a 300s/5min (máx)
#
# NOTA: Aguarde 5-10 execuções para aprendizado estável. Circuit breaker ativa
# se média consistentemente > 120s (aviso, mas não bloqueia).
#
# DEFAULT: true (habilitado - solução primária recomendada)
MCP_TOOL_ADAPTIVE_TIMEOUT=true

# Retry Automático: Recuperação de falhas transitórias
# ----------------------------------------------------------------------------
# **RECOMENDADO: Manter habilitado** - Funciona bem com adaptive timeout.
#
# Quando habilitado, tools falhos são automaticamente retentados com
# exponential backoff + jitter para evitar thundering herd. Recupera
# automaticamente de falhas transitórias (network, overload temporário).
#
# Retry strategies (baseado no tipo de erro):
# - TRANSIENT (network): retry imediato com backoff exponencial
# - DEGRADED (timeout): retry com backoff (+ model fallback se habilitado)
# - PERMANENT (auth, invalid): sem retry (falha imediata)
# - CIRCUIT_OPEN: sem retry (aguarda circuit breaker recovery)
#
# Error classification (integra com taxonomia existente):
# - ENV_UNAVAILABLE: Erros de infraestrutura (não contam tentativa)
# - TASK_ERROR: Erros de aplicação (contam tentativa)
#
# NOTA: Funciona sinergicamente com adaptive timeout - retry usa o timeout
# aprendido, aumentando chances de sucesso sem desperdiçar tempo.
#
# DEFAULT: true (habilitado - recomendado para resiliência)
MCP_TOOL_RETRY_ENABLED=true

# Máximo de tentativas por tool call (default: 3)
# Exemplo: maxRetries=3 → até 3 tentativas (1 original + 2 retries)
MCP_TOOL_MAX_RETRIES=3

# Delay máximo entre retries (ms, default: 30s)
# Fórmula backoff: delay = baseDelay × 2^(attempt-1) × jitter[0.5-1.0]
# Cap previne delays excessivos
MCP_TOOL_MAX_BACKOFF_MS=30000

# Circuit Breaker para Ollama: Previne thundering herd
# ----------------------------------------------------------------------------
# Implementa pattern 3-state (CLOSED → OPEN → HALF_OPEN → CLOSED)
# para prevenir cascading failures quando Ollama está indisponível
#
# States:
# - CLOSED: Normal (permite requests)
# - OPEN: Após N falhas consecutivas (bloqueia por timeout)
# - HALF_OPEN: Testando recovery (permite 1 request probe)
#
# Benefícios:
# - Falhas fail-fast (sem esperar timeout)
# - Reduz carga no serviço degradado
# - Recovery automático após timeout
#
# RECOMENDADO: Manter habilitado (default: true)
# Desabilite apenas para debug
OLLAMA_CIRCUIT_BREAKER_ENABLED=true

# Threshold de falhas consecutivas para abrir circuit (default: 5)
# Valores baixos = mais sensível (abre rápido)
# Valores altos = mais tolerante (aguenta mais falhas)
OLLAMA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Threshold de sucessos consecutivos para fechar circuit no HALF_OPEN (default: 2)
OLLAMA_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Timeout antes de tentar HALF_OPEN (ms, default: 60s)
# Após este tempo, circuit tenta recovery automático
OLLAMA_CIRCUIT_BREAKER_TIMEOUT=60000

# Tamanho da janela deslizante para cálculo de failure rate (default: 10)
# Janela maior = mais estável, menos sensível a outliers
OLLAMA_CIRCUIT_BREAKER_WINDOW_SIZE=10

# Model Fallback: Downgrade automático em timeout (SOLUÇÃO SECUNDÁRIA/OPCIONAL)
# ----------------------------------------------------------------------------
# ⚠️ ATENÇÃO: Esta é uma otimização SECUNDÁRIA, não a solução fundamental.
# A solução primária é ADAPTIVE TIMEOUT (espera adaptativa do tempo necessário).
#
# Quando habilitado E um Ollama tool dá timeout mesmo com adaptive timeout,
# automaticamente tenta modelo menor/mais rápido como último recurso.
#
# Fallback chain (configurável via getSmallerModel()):
# - qwen3-coder-next (cloud, lento) → qwen2.5-coder:7b (local, médio)
# - qwen2.5-coder:7b → qwen2.5-coder:3b (local, rápido)
# - qwen2.5-coder:3b → qwen2.5-coder:1.5b (local, muito rápido)
# - qwen2.5-coder:1.5b → sem mais fallbacks (pequeno demais)
#
# Nota: o sistema agora normaliza nomes removendo prefixo "Custom/" e tenta
# extrair o modelo diretamente de mensagens de erro (por ex. "qwen2.5-coder:3b
# not found"). Isso garante que um fallback seja acionado mesmo quando a
# resposta original não expõe claramente qual modelo falhou.
#
# Trade-offs:
# ✅ Pode fornecer resposta mais rápida (com modelo menor)
# ❌ Qualidade da resposta pode ser inferior (modelo menor)
# ❌ Não resolve causa raiz (timeout inadequado)
#
# RECOMENDAÇÃO:
# - Use ADAPTIVE TIMEOUT como solução primária (aprende tempo necessário)
# - Use MODEL FALLBACK apenas se prioriza velocidade > qualidade
#
# DEFAULT: false (desabilitado - opt-in explícito se desejar esta otimização)
OLLAMA_MODEL_FALLBACK_ENABLED=false

# ============================================================================
# [21.7] OPENAI-COMPATIBLE API (GitHub Copilot Integration)
# ============================================================================
#
# Expõe Ollama Cloud via API compatível com OpenAI Chat Completions para
# permitir que GitHub Copilot use modelos customizados (qwen3-coder-next).
#
# 📋 Como usar:
# ----------------------------------------------------------------------------
# 1. Habilitar: OPENAI_COMPATIBLE_ENABLED=true
# 2. Reiniciar servidor: npx pm2 restart dashboard-web
# 3. Configurar VSCode settings.json:
#
#    "github.copilot.chat.customOAIModels": {
#      "ollama-cloud": {
#        "name": "Qwen 3 Coder (Cloud)",
#        "url": "http://localhost:3008/v1",
#        "model": "qwen3-coder-next",
#        "toolCalling": false,
#        "vision": false,
#        "thinking": false,
#        "maxInputTokens": 32768,
#        "maxOutputTokens": 16384,
#        "requiresAPIKey": false
#      }
#    }
#
# 4. Usar no Copilot Chat: Selecionar "Qwen 3 Coder (Cloud)" no dropdown
#
# 🔌 Endpoints expostos:
# ----------------------------------------------------------------------------
# - POST /v1/chat/completions (OpenAI Chat Completions API)
# - GET /v1/models (lista modelos disponíveis)
#
# ⚠️ Limitações conhecidas:
# ----------------------------------------------------------------------------
# - ❌ Tool calling não suportado (Ollama não tem função nativa)
#      → Configure toolCalling: false no VSCode para evitar warnings
# - ❌ Vision não suportado (apenas texto)
#      → Mensagens com imagens serão rejeitadas com erro 400
# - ❌ Streaming SSE não implementado (v1.0)
#      → Respostas são sempre completas (não progressivas)
# - ❌ Multiple completions (n > 1) não suportado
#      → Requests com n > 1 serão rejeitados com erro 400
#
# ✅ Resiliência (reutiliza infraestrutura existente):
# ----------------------------------------------------------------------------
# - ✅ Adaptive timeout (se MCP_TOOL_ADAPTIVE_TIMEOUT=true)
# - ✅ Circuit breaker (se OLLAMA_CIRCUIT_BREAKER_ENABLED=true)
# - ✅ Rate limiting automático (100 req/min via Express)
# - ✅ CORS habilitado (localhost permitido)
# - ✅ Auth automática com Ollama Cloud (OLLAMA_CLOUD_API_KEY)
#
# 🔧 Troubleshooting:
# ----------------------------------------------------------------------------
# - "OpenAI-compatible features will be unavailable"
#   → Verifique logs: npx pm2 logs dashboard-web | grep OpenAI
#   → Verifique sintaxe: openai-handler.js e openai-transformer.js
#
# - GitHub Copilot não mostra modelo customizado
#   → Reinicie VSCode após editar settings.json
#   → Verifique que url aponta para http://localhost:3008/v1 (sem /chat/completions)
#
# - Timeout errors no Copilot
#   → Habilite adaptive timeout: MCP_TOOL_ADAPTIVE_TIMEOUT=true
#   → Ou aumente timeout fixo: OLLAMA_GENERATE_TIMEOUT=120000 (2min)
#
# DEFAULT: false (desabilitado - opt-in explícito)
OPENAI_COMPATIBLE_ENABLED=false

# ============================================================================
# [22] PM2 PROCESS MANAGER
# ============================================================================

# Variáveis PM2 (automáticas, não modificar)
# pm_id=<auto>
# PM2_HOME=<auto>

# ============================================================================
# FIM DO ARQUIVO .env.example
# ============================================================================
#
# PRÓXIMOS PASSOS:
# 1. cp .env.example .env
# 2. Ajustar valores para seu ambiente
# 3. Reiniciar serviços: make restart (ou pm2 restart all)
#
# TROUBLESHOOTING:
# - Proxy não conecta: Verifique CHROME_HOST e CHROME_PORT
# - Dashboard não abre: Verifique SERVER_PORT
# - CORS errors: Adicione origem em ALLOWED_ORIGINS
# - Timeouts: Aumente WS_IDLE_TIMEOUT_MS
#
# DOCUMENTAÇÃO:
# - DOCUMENTAÇÃO/WSL_INTEGRATION_GUIDE.md
# - DOCUMENTAÇÃO/CHROME_PROXY_V2_IMPLEMENTATION.md
# - DOCUMENTAÇÃO/PORT_ARCHITECTURE_ANALYSIS.md
#
# ============================================================================
