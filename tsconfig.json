{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./jsconfig.json",
  "compilerOptions": {
    // ============================================================
    // [A] NODE 24 + ESM (TS SERVER / JS TYPECHECK) — CANÔNICO
    // ============================================================

    // JS typechecking (ponto central)
    "checkJs": true,
    "allowJs": true,

    // Só verificação (sem build)
    "noEmit": true,

    // Node 24: alinhar linguagem/runtime
    "target": "ES2024",

    // Alinha com jsconfig (inclui Error.cause e afins)
    "lib": ["ES2024", "ES2022.Error"],

    // ESM real no ecossistema Node
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Evita “mágicas” na sintaxe ESM
    "verbatimModuleSyntax": true,

    // Resolução moderna de pacotes (exports/imports maps)
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,

    // Iteração moderna (ok manter)
    "downlevelIteration": true,

    // Tipos Node + custom declarations do projeto (alinhado ao jsconfig)
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./src/types"],

    // ============================================================
    // [B] PERFORMANCE / RUÍDO — alinhado ao jsconfig
    // ============================================================
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,

    // ============================================================
    // [C] ALIASES — fixar aqui evita drift em Program/Project selection
    // ============================================================
    "baseUrl": ".",
    "paths": {
      "#core/*": ["src/core/*"],
      "#shared/*": ["src/shared/*"],
      "#nerv/*": ["src/nerv/*"],
      "#kernel/*": ["src/kernel/*"],
      "#driver/*": ["src/driver/*"],
      "#agent/*": ["src/agent/*"],
      "#infra/*": ["src/infra/*"],
      "#integration/*": ["src/integration/*"],
      "#types/*": ["src/types/*"],
      "#main": ["src/main.js"],
      "#server/*": ["src/server/*"],
      "#logic/*": ["src/logic/*"],
      "#orchestrator/*": ["src/orchestrator/*"],
      "#missions/*": ["src/missions/*"],
      "#validation/*": ["src/validation/*"]
    }

    // ============================================================
    // [D] HERDADO DO JSCONFIG (mantido lá para consistência)
    // ============================================================
    // strict, esModuleInterop, allowSyntheticDefaultImports, resolveJsonModule, etc.
  },

  // ==============================================================
  // [E] ESCOPO DO PROJETO — cobre o que o tsserver precisa indexar
  // ==============================================================
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",

    // configs comuns em Node ESM/Tooling
    "*.config.js",
    "*.config.mjs",
    "*.config.cjs",
    "ecosystem.config.js",
    ".puppeteerrc.cjs",
    "eslint.config.mjs"
  ],

  // ==============================================================
  // [F] EXCLUSÕES — reduz ruído e custo de indexação
  // ==============================================================
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "logs",
    "fila",
    "respostas",
    "artifacts",
    "profile",
    "public",
    "backups",
    "monitoring",
    "tmp",
    "analysis",
    "local-login",
    "DOCUMENTAÇÃO",
    "src/dashboard-ui/node_modules",
    "src/dashboard-ui/dist",
    ".git",

    "**/node_modules/**",
    "**/*.min.js",
    "**/*.map",
    "**/bundle.js",
    "**/*.bundle.js",

    "**/*.d.ts.map",
    "**/*.js.map"
  ]
}
