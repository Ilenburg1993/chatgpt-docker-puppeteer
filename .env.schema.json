{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatGPT Docker Puppeteer - ENV Schema",
  "description": "Schema de validação para variáveis de ambiente do projeto",
  "version": "6.0",
  "updated": "2026-02-03",
  "type": "object",
  "categories": {
    "STRUCTURAL": {
      "description": "Variáveis que definem IDENTIDADE do sistema",
      "criticality": "FATAL",
      "validation": "pre-boot",
      "properties": {
        "NODE_ENV": {
          "type": "string",
          "enum": ["development", "test", "production"],
          "default": "development",
          "required": true,
          "description": "Ambiente de execução do sistema"
        },
        "SERVER_MODE": {
          "type": "string",
          "enum": ["split", "integrated"],
          "default": "split",
          "required": true,
          "description": "Modo de execução do servidor (split=PM2, integrated=single process)"
        },
        "SERVER_AUTHORITY": {
          "type": "string",
          "enum": ["standalone", "orchestrated"],
          "default": "standalone",
          "required": true,
          "description": "Autoridade do servidor (standalone=autônomo, orchestrated=cluster)"
        },
        "BROWSER_MODE": {
          "type": "string",
          "enum": ["launcher", "connect", "wsEndpoint", "auto"],
          "default": "wsEndpoint",
          "required": true,
          "description": "Modo de conexão com browser (wsEndpoint=via proxy recomendado)",
          "constraints": {
            "if_wsEndpoint": {
              "requires": ["CHROME_PROXY_PORT", "CHROME_PORT", "CHROME_HOST"]
            }
          }
        }
      }
    },
    "INFRASTRUCTURE": {
      "description": "Variáveis necessárias para o sistema EXISTIR na rede",
      "criticality": "FATAL_IF_PRODUCTION",
      "validation": "pre-boot",
      "properties": {
        "SERVER_PORT": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 3008,
          "required": true,
          "description": "Porta do servidor HTTP/Dashboard"
        },
        "CHROME_PROXY_PORT": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 9224,
          "required": true,
          "description": "Porta do Chrome Proxy Service (container side)",
          "depends_on": {
            "BROWSER_MODE": "wsEndpoint"
          }
        },
        "CHROME_PORT": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 9225,
          "required": true,
          "description": "Porta do Chrome Remote Debugging (Windows host)",
          "depends_on": {
            "BROWSER_MODE": "wsEndpoint"
          }
        },
        "CHROME_HOST": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+$",
          "default": "host.docker.internal",
          "required": true,
          "description": "Hostname do Chrome (Docker: host.docker.internal, WSL: IP do host)",
          "depends_on": {
            "BROWSER_MODE": "wsEndpoint"
          }
        },
        "CHROME_PROXY_BIND": {
          "type": "string",
          "pattern": "^(0\\.0\\.0\\.0|127\\.0\\.0\\.1|[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})$",
          "default": "0.0.0.0",
          "required": false,
          "description": "IP de bind do proxy (0.0.0.0=all, 127.0.0.1=localhost)"
        },
        "HOST": {
          "type": "string",
          "pattern": "^(0\\.0\\.0\\.0|127\\.0\\.0\\.1|[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})$",
          "default": "0.0.0.0",
          "required": false,
          "description": "IP de bind do servidor HTTP"
        }
      }
    },
    "OPERATIONAL": {
      "description": "Variáveis que afetam COMPORTAMENTO runtime",
      "criticality": "WARNING",
      "validation": "runtime",
      "properties": {
        "BROWSER_POOL_SIZE": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3,
          "required": false,
          "description": "Tamanho do pool de browsers"
        },
        "ALLOCATION_STRATEGY": {
          "type": "string",
          "enum": ["round-robin", "least-busy", "random"],
          "default": "round-robin",
          "required": false,
          "description": "Estratégia de alocação de browser do pool"
        },
        "HEALTH_CHECK_INTERVAL": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 300000,
          "default": 30000,
          "required": false,
          "description": "Intervalo de health check do browser (ms)"
        },
        "ALLOW_DEGRADED_MODE": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Permitir operação sem browser saudável",
          "constraints": {
            "if_production": {
              "must_be": false
            }
          }
        },
        "AUTO_RETRY_CHROME": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Retry automático em falhas de conexão com Chrome"
        },
        "MAX_AUTO_RETRIES": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2,
          "required": false,
          "description": "Número máximo de tentativas automáticas"
        },
        "MAX_CONNECTION_ATTEMPTS": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "required": false,
          "description": "Tentativas de conexão com Chrome"
        },
        "CONNECTION_TIMEOUT": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 120000,
          "default": 30000,
          "required": false,
          "description": "Timeout de conexão com Chrome (ms)"
        },
        "LOG_LEVEL": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "required": false,
          "description": "Nível de logging do sistema"
        },
        "NERV_BUFFER_SIZE": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "default": 1000,
          "required": false,
          "description": "Tamanho do buffer de eventos NERV"
        },
        "NERV_TELEMETRY": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Ativar telemetria do NERV"
        },
        "NERV_INTEGRATION": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Ativar integração NERV"
        },
        "WS_IDLE_TIMEOUT_MS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000,
          "default": 300000,
          "required": false,
          "description": "Timeout idle de WebSocket (ms)"
        },
        "KERNEL_CYCLE_INTERVAL": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000,
          "default": 50,
          "required": false,
          "description": "Intervalo do ciclo do Kernel (ms)"
        },
        "CONTEXT_STRATEGY": {
          "type": "string",
          "enum": ["sliding_window", "fixed_window", "unlimited"],
          "default": "sliding_window",
          "required": false,
          "description": "Estratégia de gerenciamento de contexto"
        },
        "CONTEXT_MAX_TOKENS": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 1000000,
          "default": 100000,
          "required": false,
          "description": "Máximo de tokens no contexto"
        },
        "SUMMARIZATION_POLICY": {
          "type": "string",
          "enum": ["on_overflow", "periodic", "adaptive", "disabled", "none", "never"],
          "default": "on_overflow",
          "required": false,
          "description": "Política de summarização de contexto"
        },
        "MISSIONS_DIR": {
          "type": "string",
          "default": "missions",
          "required": false,
          "description": "Diretório de missões"
        },
        "CHECKPOINT_KEEP_LAST": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "required": false,
          "description": "Número de checkpoints a manter"
        },
        "FACTORY_DEFAULT_TARGET": {
          "type": "string",
          "enum": ["chatgpt", "gemini"],
          "default": "chatgpt",
          "required": false,
          "description": "Driver LLM padrão"
        },
        "FACTORY_VALIDATE_BOOT": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Validar boot do driver factory"
        },
        "ALLOWED_ORIGINS": {
          "type": "string",
          "pattern": "^https?://",
          "default": "http://localhost:3008",
          "required": false,
          "description": "Origens CORS permitidas (separadas por vírgula)"
        },
        "PUBLIC_IP": {
          "type": "string",
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$",
          "default": "",
          "required": false,
          "description": "IP público do container (auto-detectado se vazio)"
        }
      }
    },
    "TUNING": {
      "description": "Variáveis de otimização e performance",
      "criticality": "NONE",
      "validation": "none",
      "properties": {
        "TRIAGE_LAG_THRESHOLD": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "default": 2000,
          "required": false
        },
        "TRIAGE_LAG_RETRIES": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "required": false
        },
        "TRIAGE_TIMEOUT": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 15000,
          "required": false
        },
        "FRAME_NAV_TIMEOUT": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 20000,
          "required": false
        },
        "BIOMECH_KEEP_ALIVE": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 25000,
          "required": false
        }
      }
    },
    "FEATURE_FLAGS": {
      "description": "Flags para ativar/desativar features",
      "criticality": "NONE",
      "validation": "none",
      "properties": {
        "MOCK_CHROME": {
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "required": false,
          "description": "Usar mock do Chrome (1=sim, 0=não)",
          "constraints": {
            "if_production": {
              "must_be": 0
            }
          }
        },
        "PUPPETEER_LOCAL_LAUNCH_DISABLED": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Desabilitar launch local do Puppeteer"
        },
        "ENABLE_STATE_FILE": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Ativar arquivo de estado (controle.json)"
        },
        "REEXECUTE_POST_CREATE": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Forçar reexecução do post-create.sh"
        },
        "MCP_ENABLED": {
          "type": "boolean",
          "default": true,
          "required": false,
          "description": "Habilita o endpoint MCP (POST/GET /api/mcp)"
        },
        "MCP_UPSTREAM_ENABLED": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Importa tools de um MCP upstream (HTTP JSON-RPC) e registra localmente com prefixo"
        },
        "MCP_UPSTREAM_URL": {
          "type": "string",
          "format": "uri",
          "default": "",
          "required": false,
          "description": "URL do MCP upstream (ex: http://localhost:4000/api/mcp)"
        },
        "MCP_UPSTREAM_ALIAS": {
          "type": "string",
          "default": "upstream",
          "required": false,
          "description": "Alias humano do upstream (usado em descrição/prefixo)"
        },
        "MCP_UPSTREAM_TOOL_PREFIX": {
          "type": "string",
          "default": "",
          "required": false,
          "description": "Prefixo para tools importadas (default: mcp_<alias>__)"
        },
        "MCP_UPSTREAM_HEADERS_JSON": {
          "type": "string",
          "default": "",
          "required": false,
          "description": "Headers extras em JSON para autenticação no upstream (ex: {\"Authorization\":\"Bearer ...\"})"
        },
        "MCP_UPSTREAMS_JSON": {
          "type": "string",
          "default": "",
          "required": false,
          "description": "Config avançada de múltiplos upstreams MCP em JSON (array). Se setado, substitui MCP_UPSTREAM_* legado."
        },
        "MCP_UPSTREAM_REFRESH": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Força re-import de tools upstream no boot (útil para debug)"
        },
        "MCP_UPSTREAM_INIT_TIMEOUT_MS": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000,
          "required": false,
          "description": "Timeout de init (ms) para upstreams stdio"
        },
        "MCP_UPSTREAM_RESTART_ENABLED": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Retry best-effort para importar tools de upstreams que falharam no boot"
        },
        "MCP_UPSTREAM_RESTART_BACKOFF_MS": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 5000,
          "required": false,
          "description": "Backoff base (ms) para retries de upstream (exponencial, com teto)"
        },
        "MCP_UPSTREAM_RESTART_MAX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 10,
          "required": false,
          "description": "Máximo de tentativas de retry por upstream (0 = ilimitado)"
        },
        "MCP_GITHUB_PROXY_ENABLED": {
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Habilita proxy/import de tools do GitHub MCP via stdio para dentro do nosso MCP"
        },
        "MCP_GITHUB_TOOL_PREFIX": {
          "type": "string",
          "default": "mcp_github__",
          "required": false,
          "description": "Prefixo para tools do GitHub importadas (default: mcp_github__)"
        },
        "MCP_GITHUB_COMMAND": {
          "type": "string",
          "default": "npx",
          "required": false,
          "description": "Comando para iniciar GitHub MCP no modo proxy (default: npx)"
        },
        "MCP_GITHUB_ARGS_JSON": {
          "type": "string",
          "default": "[\"-y\",\"@modelcontextprotocol/server-github\"]",
          "required": false,
          "description": "Args em JSON (array) para iniciar GitHub MCP no modo proxy"
        },
        "GITHUB_PERSONAL_ACCESS_TOKEN": {
          "type": "string",
          "default": "",
          "required": false,
          "description": "Token de acesso pessoal do GitHub (usado pelo GitHub MCP server no modo direct/stdio; recomendado via .env.local)"
        }
      }
    }
  },
  "constraints": {
    "unique_ports": {
      "description": "Portas devem ser únicas",
      "variables": ["SERVER_PORT", "CHROME_PORT", "CHROME_PROXY_PORT"]
    },
    "production_constraints": {
      "description": "Restrições para NODE_ENV=production",
      "if": {
        "NODE_ENV": "production"
      },
      "then": {
        "ALLOW_DEGRADED_MODE": false,
        "MOCK_CHROME": 0,
        "LOG_LEVEL": {
          "enum": ["info", "warn", "error"]
        }
      }
    },
    "browser_mode_dependencies": {
      "description": "Dependências de BROWSER_MODE",
      "if": {
        "BROWSER_MODE": "wsEndpoint"
      },
      "then": {
        "required": ["CHROME_PROXY_PORT", "CHROME_PORT", "CHROME_HOST"]
      }
    },
    "mcp_upstream_requires_url": {
      "description": "Quando MCP_UPSTREAM_ENABLED=true, MCP_UPSTREAM_URL deve existir",
      "if": {
        "MCP_UPSTREAM_ENABLED": true,
        "MCP_UPSTREAMS_JSON": ""
      },
      "then": {
        "required": ["MCP_UPSTREAM_URL"]
      }
    },
    "mcp_github_proxy_requires_token": {
      "description": "Quando MCP_GITHUB_PROXY_ENABLED=true, GITHUB_PERSONAL_ACCESS_TOKEN deve existir",
      "if": {
        "MCP_GITHUB_PROXY_ENABLED": true
      },
      "then": {
        "required": ["GITHUB_PERSONAL_ACCESS_TOKEN"]
      }
    }
  },
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "ip_address": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+$"
    },
    "milliseconds": {
      "type": "integer",
      "minimum": 0
    }
  }
}
