# ============================================================================
# .env.production - Ambiente de Produção
# chatgpt-docker-puppeteer
# ============================================================================
#
# Este arquivo contém configurações otimizadas para produção.
# IMPORTANTE: Ajuste os valores marcados com [REQUIRED] antes de usar.
#
# ============================================================================

# [1] AMBIENTE
NODE_ENV=production
SERVER_MODE=split
SERVER_AUTHORITY=standalone

# [2] PORTAS (Produção)
SERVER_PORT=3008
PORT=3008
CHROME_PROXY_PORT=9224
CHROME_PORT=9225

# [REQUIRED] Ajuste para seu ambiente de produção
CHROME_HOST=host.docker.internal
CHROME_PROXY_BIND=0.0.0.0
HOST=0.0.0.0

# [REQUIRED] Defina o IP público do container em produção
# Exemplo: IP do load balancer, IP do host, etc.
PUBLIC_IP=

# [3] CHROME
BROWSER_MODE=wsEndpoint
PUPPETEER_LOCAL_LAUNCH_DISABLED=true
MOCK_CHROME=0

# [4] BROWSER POOL (Produção: pool maior para throughput)
BROWSER_POOL_SIZE=5
ALLOCATION_STRATEGY=least-busy
HEALTH_CHECK_INTERVAL=30000
ALLOW_DEGRADED_MODE=false
AUTO_RETRY_CHROME=true
MAX_AUTO_RETRIES=2
MAX_CONNECTION_ATTEMPTS=5
CONNECTION_TIMEOUT=30000

# [5] CHROME PROXY SERVICE
NERV_INTEGRATION=true
WS_IDLE_TIMEOUT_MS=300000

# [REQUIRED] Defina origens permitidas para CORS em produção
# Adicione domínios de produção aqui
ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# [6] LOGGING (Produção: menos verbose)
LOG_LEVEL=info
NERV_BUFFER_SIZE=2000
NERV_TELEMETRY=true

# [7] KERNEL
KERNEL_CYCLE_INTERVAL=50

# [8] CONTEXT
CONTEXT_STRATEGY=sliding_window
CONTEXT_MAX_TOKENS=100000
SUMMARIZATION_POLICY=on_overflow

# [9] MISSIONS
MISSIONS_DIR=missions
CHECKPOINT_KEEP_LAST=20

# [10] DRIVER FACTORY
FACTORY_DEFAULT_TARGET=chatgpt
FACTORY_VALIDATE_BOOT=true

# [11] TRIAGE (Produção: timeouts mais generosos)
TRIAGE_LAG_THRESHOLD=2000
TRIAGE_LAG_RETRIES=3
TRIAGE_SNAPSHOT_DELAY=600
TRIAGE_MAX_TEXT_PARTS=1000
TRIAGE_MAX_DEPTH=15
TRIAGE_TIMEOUT=15000
TRIAGE_SCAN_TIMEOUT=8000
TRIAGE_RED_THRESHOLD=180
TRIAGE_ORANGE_THRESHOLD=200
TRIAGE_IFRAME_THRESHOLD=0.4

# [12] FRAME NAVIGATOR
FRAME_NAV_MAX_DEPTH=10
FRAME_NAV_TIMEOUT=20000
FRAME_NAV_BBOX_TIMEOUT=3000
FRAME_NAV_DISPOSE_RETRIES=3
FRAME_NAV_DISPOSE_DELAY=100

# [13] BIOMECHANICS ENGINE
BIOMECH_MAX_ITERATIONS=50
BIOMECH_KEEP_ALIVE=25000
BIOMECH_WAIT_POLL=800
BIOMECH_STABLE_ATTEMPTS=10
BIOMECH_STABLE_TOLERANCE=0.5
BIOMECH_STABLE_POLL=60
BIOMECH_STABLE_TIMEOUT=5000
BIOMECH_SCROLL_OFFSET=0.15
BIOMECH_SCROLL_MAX=0.3
BIOMECH_POST_SCROLL_DELAY=500
BIOMECH_ZEN_THRESHOLD=2000
BIOMECH_ZEN_TIMEOUT=30000
BIOMECH_HUMAN_TIMEOUT=60000
BIOMECH_ECHO_LONG=0.6
BIOMECH_ECHO_SHORT=0.5
BIOMECH_MODIFIER_TTL=3600000

# [14] RECOVERY SYSTEM (Produção: recovery mais agressivo)
RECOVERY_KILL_TIMEOUT=5000
RECOVERY_RELOAD_TIMEOUT=45000
RECOVERY_TIER0_BACKOFF=1500
RECOVERY_TIER0_INCREMENT=1000
RECOVERY_FOCUS_TIMEOUT=3000
RECOVERY_MAX_RETRIES=3

# [15] SUBMISSION CONTROLLER
SUBMISSION_LOCK_DURATION=3000
SUBMISSION_PRE_PRESS=300
SUBMISSION_DEBOUNCE=400
SUBMISSION_DEBOUNCE_MAX=600
SUBMISSION_POST_SEND=500

# [16] DASHBOARD (Produção)
# [REQUIRED] Defina origem do dashboard em produção
DASHBOARD_ORIGIN=https://seu-dominio.com

# [REQUIRED] DEFINA UMA SENHA FORTE PARA O DASHBOARD EM PRODUÇÃO
# Exemplo: openssl rand -base64 32
DASHBOARD_PASSWORD=CHANGE_ME_IN_PRODUCTION

# [17] LEGACY
ENABLE_STATE_FILE=false

# ============================================================================
# CHECKLIST DE PRODUÇÃO
# ============================================================================
# [ ] PUBLIC_IP configurado para IP/domínio de produção
# [ ] ALLOWED_ORIGINS inclui domínios de produção
# [ ] DASHBOARD_ORIGIN configurado para domínio de produção
# [ ] DASHBOARD_PASSWORD definido (senha forte)
# [ ] LOG_LEVEL = info (não debug)
# [ ] ALLOW_DEGRADED_MODE = false (fail-fast em produção)
# [ ] FACTORY_VALIDATE_BOOT = true (validação no boot)
# [ ] SSL/TLS configurado (se aplicável)
# [ ] Monitoramento configurado (Prometheus /metrics endpoint)
# [ ] Backups de checkpoints configurados
# [ ] Health checks configurados no load balancer
# ============================================================================
