{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "isolatedDeclarations": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "outDir": "./tmp/types-isolated",
    "rootDir": "./src",
    "tsBuildInfoFile": "/home/node/.cache/typescript/tsconfig.isolated-declarations.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "verbatimModuleSyntax": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "paths": {
      "#core/*": ["./src/core/*"],
      "#shared/*": ["./src/shared/*"],
      "#nerv/*": ["./src/nerv/*"],
      "#kernel/*": ["./src/kernel/*"],
      "#driver/*": ["./src/driver/*"],
      "#agent/*": ["./src/agent/*"],
      "#infra/*": ["./src/infra/*"],
      "#integration/*": ["./src/integration/*"],
      "#types/*": ["./src/types/*"],
      "#main": ["./src/main.js"],
      "#server/*": ["./src/server/*"],
      "#logic/*": ["./src/logic/*"],
      "#orchestrator/*": ["./src/orchestrator/*"],
      "#missions/*": ["./src/missions/*"],
      "#validation/*": ["./src/validation/*"]
    }
  },
  "include": ["src/types/**/*.d.ts", "src/integration/lsp/tsserver-contract.d.ts", "src/core/constants/**/*.ts"],
  "exclude": ["node_modules", "dist", "tmp", "DOCUMENTAÇÃO"],
  "display": "isolated declarations validation (pure .d.ts files)"
}
