{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "allow",
    "suspicious": "allow",
    "pedantic": "allow",
    "perf": "allow",
    "style": "allow",
    "restriction": "allow",
    "nursery": "allow"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": false
      }
    ]
  }
}
