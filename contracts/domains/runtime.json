{
  "domain": "runtime",
  "contracts": [
    {
      "id": "CONTRACT-RUNTIME-MCP-DIAG",
      "title": "MCP Diagnose Disponível",
      "domain": "runtime",
      "description": "O comando mcp:diagnose deve executar com sucesso para preservar triagem semântica.",
      "kind": "operational",
      "severity_default": "P1",
      "type_default": "falha de contrato",
      "matcher": {
        "engine": "signal",
        "signals": [
          "runtime.mcp_diagnose.failed"
        ]
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npm run mcp:diagnose"
      ],
      "owner": "infra-runtime",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-RAG-HEALTH",
      "title": "RAG Health Saudável",
      "domain": "runtime",
      "description": "RAG deve responder health ok para contexto local-first.",
      "kind": "operational",
      "severity_default": "P1",
      "type_default": "gap",
      "matcher": {
        "engine": "signal",
        "signals": [
          "runtime.rag_health.failed"
        ]
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npm run rag:health -- --json"
      ],
      "owner": "infra-rag",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-LSP-TOOLS",
      "title": "Sinais de Ferramentas LSP",
      "domain": "runtime",
      "description": "Diagnóstico MCP deve expor sinais mínimos de ferramentas LSP.",
      "kind": "operational",
      "severity_default": "P2",
      "type_default": "gap",
      "matcher": {
        "engine": "signal",
        "signals": [
          "runtime.lsp_tools.missing"
        ]
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npm run mcp:diagnose"
      ],
      "owner": "infra-lsp",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-LSP-FUNCTIONAL",
      "title": "LSP funcional via MCP",
      "domain": "runtime",
      "description": "Ferramentas LSP devem responder funcionalmente via MCP (diagnostics/definition).",
      "kind": "operational",
      "severity_default": "P1",
      "type_default": "falha de contrato",
      "matcher": {
        "engine": "signal",
        "signals": [
          "runtime.lsp_functional.failed"
        ]
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npm run lsp:health -- --json"
      ],
      "owner": "infra-lsp",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-PROTOCOL-RUNTIME-SMOKE",
      "title": "Smoke Protocolar de Lifecycle",
      "domain": "runtime",
      "description": "Smoke de lifecycle/main-server deve passar em perfis deep/nightly.",
      "kind": "protocol",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "signal",
        "signals": [
          "runtime.smoke.failed"
        ]
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave10_lifecycle_signal_matrix.spec.js tests/regression/test_wave11_main_server_bootstrap_unification.spec.js"
      ],
      "owner": "runtime-lifecycle",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-ABORT-COMMAND-AWAIT",
      "title": "Abort Command Deve Ser Aguardado",
      "domain": "runtime",
      "description": "Emissão de DRIVER_ABORT no TaskControlWatcher deve usar await para evitar falha silenciosa.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "(?<!await\\s)sendCommand\\s*\\(",
        "flags": "gm",
        "scope": "src/agent/task_control_watcher.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave14_task_control_watcher_abort_await.spec.js"
      ],
      "owner": "runtime-task-control",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-IMPORT-SIDE-EFFECT",
      "title": "Entrypoints sem Side-Effect em Import",
      "domain": "runtime",
      "description": "Import puro de entrypoints não deve disparar bootstrap de env/config com logs operacionais.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "falha de contrato",
      "matcher": {
        "engine": "regex",
        "pattern": "import\\s+['\\\"]\\.\\/core\\/env_bootstrap\\.js['\\\"]|validateEnvFile\\s*\\(\\s*\\)\\s*;|\\[DEPRECATED\\]\\x1b\\[0m PORT environment variable is deprecated",
        "flags": "gm",
        "scope": "src/main.js|src/core/config.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --input-type=module -e \"import './src/main.js'; console.log('OK')\"",
        "node --input-type=module -e \"import './src/server/main.js'; console.log('OK')\""
      ],
      "owner": "runtime-bootstrap",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-HOT-POOL-MONITOR-CONSISTENCY",
      "title": "Hot Pool Deve Rebindar Monitor por TaskId",
      "domain": "runtime",
      "description": "Lifecycle monitor não pode remover página apenas por taskId stale após hot-reuse.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "removePageFromPool\\(this\\.taskId\\s*\\)",
        "flags": "gm",
        "scope": "src/infra/browser_pool/PageLifecycleMonitor.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave14_hot_pool_monitor_taskid_rebind.spec.js"
      ],
      "owner": "runtime-browserpool",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-RUNTIME-LOCK-RELEASE-ATTEMPT-CAUSALITY",
