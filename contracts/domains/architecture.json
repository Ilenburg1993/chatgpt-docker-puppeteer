{
  "domain": "architecture",
  "contracts": [
    {
      "id": "CONTRACT-ARCH-CIRCULAR-DEPENDENCY",
      "title": "Dependências Circulares Proibidas",
      "domain": "architecture",
      "description": "Módulos não podem ter dependências circulares.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "tool",
        "tool": "madge",
        "args": [
          "--circular",
          "--format",
          "json",
          "src/"
        ],
        "scope": "src"
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npx madge --circular src/"
      ],
      "owner": "architecture-core",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-ARCH-GOD-CLASS",
      "title": "Classes God Proibidas",
      "domain": "architecture",
      "description": "Classes com mais de 1000 linhas indicam responsabilidade excessiva.",
      "kind": "static",
      "severity_default": "P2",
      "type_default": "upgrade",
      "matcher": {
        "engine": "regex",
        "pattern": "^class\\s+\\w+\\s*{\\s*(?:.|\\n){1000,}",
        "flags": "gm",
        "scope": "src",
        "ignore_comment_like": false,
        "ignore_string_like": false
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "npm run check:forbidden"
      ],
      "owner": "architecture-maintainability",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-ARCH-TIGHT-COUPLING",
      "title": "Acoplamento Excessivo",
      "domain": "architecture",
      "description": "Módulos com mais de 20 imports indicam acoplamento alto.",
      "kind": "static",
      "severity_default": "P2",
      "type_default": "upgrade",
      "matcher": {
        "engine": "custom",
        "script": "analyze-coupling.mjs",
        "scope": "src"
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node scripts/audit/collectors/architecture.mjs"
      ],
      "owner": "architecture-coupling",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-ARCH-SSOT-EXECUTION-OWNER",
      "title": "Ownership SSOT de Dispatch",
      "domain": "architecture",
      "description": "Dispatch direto via kernel.executeTask deve ficar restrito a pontos autorizados do fluxo SSOT.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "\\b(?:this\\.)?kernel\\.executeTask\\s*\\(",
        "flags": "gm",
        "scope": "src",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": [
          "src/agent/queue_worker.js",
          "src/missions/mission_manager.js"
        ]
      },
      "test_recipe": [
        "node --test tests/regression/test_wave15_arch_contract_ssot_execution_owner.spec.js"
      ],
      "owner": "architecture-kernel-ssot",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-DASHBOARD-AUTH-NO-HARDCODED",
      "title": "Dashboard Auth sem Credenciais Hardcoded",
      "domain": "architecture",
      "description": "Controllers de dashboard não podem conter credenciais hardcoded (ex.: admin123/user123).",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "admin123|user123|const\\s+validUsers\\s*=\\s*\\{",
        "flags": "gm",
        "scope": "src/server/api/controllers/dashboard.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave16r_dashboard_auth_no_hardcoded.spec.js"
      ],
      "owner": "architecture-dashboard-security",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-DASHBOARD-CONTROLLER-NO-TOPLEVEL-TIMER",
      "title": "Controller sem Timer em Top-level",
      "domain": "architecture",
      "description": "Controllers não devem iniciar timers em import puro (ex.: startPeriodicCleanup no top-level).",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "^\\s*startPeriodicCleanup\\s*\\(",
        "flags": "gm",
        "scope": "src/server/api/controllers/dashboard.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave16r_dashboard_import_no_timer_side_effect.spec.js"
      ],
      "owner": "architecture-dashboard-runtime",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-MISSION-TRANSITION-SERVICE-ENTRYPOINT",
      "title": "Transição de Missão via Serviço Único",
      "domain": "architecture",
      "description": "Atualizações de status de missão devem ocorrer via mission_execution_service, não por updateMission ad-hoc em controller/runner.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "updateMission\\s*\\([^\\)]*\\{[\\s\\S]{0,260}?status\\s*:",
        "flags": "gm",
        "scope": "src/server/api/controllers/missions.js|src/agent/mission_runner.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave17_mission_transition_service_single_entrypoint.spec.js"
      ],
      "owner": "architecture-mission-domain",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-CONTROL-COMMAND-SINGLE-ENTRYPOINT",
      "title": "Mutações via Control Command Service",
      "domain": "architecture",
      "description": "Controllers de missão/tarefa devem delegar mutações ao control_command_service.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "updateTask\\(|updateMission\\(|insertTask\\(",
        "flags": "gm",
        "scope": "src/server/api/controllers/missions.js|src/server/api/controllers/tasks.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave18_control_commands_single_entrypoint.spec.js"
      ],
      "owner": "architecture-control-plane",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-DASHBOARD-VNEXT-NO-DIRECT-TASKS-MUTATION",
      "title": "Dashboard vNext sem mutação direta em /api/tasks",
      "domain": "architecture",
      "description": "Views/stores vNext ativos devem mutar tasks exclusivamente via /api/control/commands.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "http\\.(post|patch|put)\\(\\s*['\"`]\\/api\\/tasks",
        "flags": "gm",
        "scope": "src/dashboard-ui/src/views/TasksView.vue|src/dashboard-ui/src/views/TaskDetail.vue|src/dashboard-ui/src/views/MissionDetail.vue|src/dashboard-ui/src/stores/tasks_vnext.js|src/dashboard-ui/src/stores/missions_vnext.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave18t_dashboard_views_no_direct_tasks_mutation_calls.spec.js"
      ],
      "owner": "architecture-dashboard-ssot-cutover",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-DASHBOARD-VNEXT-NO-DIRECT-MISSIONS-MUTATION",
      "title": "Dashboard vNext sem mutação direta em /api/missions",
      "domain": "architecture",
      "description": "Views/stores vNext ativos devem mutar missões exclusivamente via /api/control/commands.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "http\\.(post|patch|put|delete)\\(\\s*['\"`]\\/api\\/missions",
        "flags": "gm",
        "scope": "src/dashboard-ui/src/views/TasksView.vue|src/dashboard-ui/src/views/TaskDetail.vue|src/dashboard-ui/src/views/MissionDetail.vue|src/dashboard-ui/src/views/Missions.vue|src/dashboard-ui/src/stores/tasks_vnext.js|src/dashboard-ui/src/stores/missions_vnext.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave19_frontend_hard_cutover_no_legacy_mutations.spec.js"
      ],
      "owner": "architecture-dashboard-ssot-cutover",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "warn"
      }
    },
    {
      "id": "CONTRACT-ARCH-ENTRYPOINT-NO-IMPORT-AUTOSTART",
      "title": "Entrypoint sem heurística frágil de auto-bootstrap",
      "domain": "architecture",
      "description": "Entrypoints não devem acoplar auto-bootstrap em env heurística ampla (NODE_APP_INSTANCE/DAEMON_MODE) que quebre import puro.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "NODE_APP_INSTANCE|PM2_JSON_PROCESSING|process\\.env\\.DAEMON_MODE\\s*===\\s*['\\\"]true['\\\"]",
        "flags": "gm",
        "scope": "src/main.js|src/server/main.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave20b_server_main_import_pm2_env_no_boot.spec.js tests/regression/test_wave20b_main_import_daemon_env_no_boot.spec.js"
      ],
      "owner": "architecture-runtime-bootstrap",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    },
    {
      "id": "CONTRACT-ARCH-SIGNAL-OWNERSHIP-SINGLE",
      "title": "Ownership único de sinais em wrapper PM2",
      "domain": "architecture",
      "description": "Wrapper de processo PM2 não deve limpar listeners globais de forma ampla nem delegar sinais ao impl interno concorrente.",
      "kind": "static",
      "severity_default": "P1",
      "type_default": "bug",
      "matcher": {
        "engine": "regex",
        "pattern": "removeAllListeners\\s*\\(|AUTO_HANDLE_SIGNALS\\s*:\\s*true",
        "flags": "gm",
        "scope": "scripts/chrome-proxy-service.js",
        "ignore_comment_like": true,
        "ignore_string_like": true
      },
      "allowlist": {
        "files": []
      },
      "test_recipe": [
        "node --test tests/regression/test_wave20b_signal_ownership_single_owner.spec.js"
      ],
      "owner": "architecture-runtime-lifecycle",
      "status": "active",
      "version": 1,
      "enforcement": {
        "level": "p1"
      }
    }
  ]
}
