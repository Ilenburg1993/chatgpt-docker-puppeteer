{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local (DevContainer)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "qwen3-coder": {
          "name": "qwen3-coder"
        },
        "llama3": {
          "name": "llama3"
        },
        "mistral": {
          "name": "mistral"
        }
      }
    },
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1"
      },
      "models": {
        "qwen3": {
          "name": "qwen3"
        },
        "qwen3-coder-next": {
          "name": "qwen3-coder-next"
        },
        "qwen3-80b": {
          "name": "qwen3:80b"
        },
        "llama3-70b": {
          "name": "llama3:70b"
        }
      }
    }
  },
  "model": "ollama-cloud/qwen3",
  "small_model": "ollama-local/qwen3-coder"
}
