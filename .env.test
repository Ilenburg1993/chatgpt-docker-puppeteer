# ============================================================================
# .env.test - Ambiente de Testes v6.0
# chatgpt-docker-puppeteer
# ============================================================================
#
# METADATA:
# Version: 6.0
# Schema: .env.schema.json
# Last Updated: 2026-02-03
# Compatible with: devcontainer.json v5.4+, post-create.sh v6.0+
#
# ESTRATÉGIA:
# Usa valores de PRODUÇÃO para testar comportamento real
# LOG_LEVEL=debug para diagnóstico detalhado durante testes
# MOCK_CHROME=1 para testes sem Chrome real (CI/CD)
#
# ============================================================================

# ============================================================================
# [1] STRUCTURAL VARIABLES (Identidade do Sistema)
# ============================================================================
# CRITICIDADE: FATAL se ausente

NODE_ENV=test
SERVER_MODE=split
SERVER_AUTHORITY=standalone
MAESTRO_ENTRY_AUTOSTART=false
BROWSER_MODE=wsEndpoint

# ============================================================================
# [2] INFRASTRUCTURE VARIABLES (Conectividade Essencial)
# ============================================================================
# CRITICIDADE: WARNING em test

# Portas alternativas para evitar conflitos com dev/prod
SERVER_PORT=3009
# PORT=3009  # ← DEPRECATED v6.0: Use SERVER_PORT
CHROME_PROXY_PORT=9234
CHROME_PORT=9235
CHROME_HOST=localhost
CHROME_PROXY_BIND=127.0.0.1
HOST=127.0.0.1
PUBLIC_IP=127.0.0.1

# ============================================================================
# [3] OPERATIONAL VARIABLES (Comportamento Runtime)
# ============================================================================
# CRITICIDADE: INFO em test

# Browser Pool (mínimo para testes)
BROWSER_POOL_SIZE=1
# Tempo de vida de páginas internas no pool (ms) - adicionado em v6.1
BROWSER_PAGE_TTL_MS=3600000
ALLOCATION_STRATEGY=round-robin
HEALTH_CHECK_INTERVAL=10000
ALLOW_DEGRADED_MODE=true
AUTO_RETRY_CHROME=false
MAX_AUTO_RETRIES=1
MAX_CONNECTION_ATTEMPTS=2
CONNECTION_TIMEOUT=5000
BOOT_RETRY_BASE_MS=200
BOOT_RETRY_MAX_MS=2000
BOOT_RETRY_MAX_ATTEMPTS=5
BOOT_DEGRADED_READY_ALLOWED=true

# Chrome Proxy Service
NERV_INTEGRATION=false
WS_IDLE_TIMEOUT_MS=30000
ALLOWED_ORIGINS=http://localhost:3009,http://127.0.0.1:3009

# Logging (ERROR para testes rápidos, DEBUG se diagnosticando)
LOG_LEVEL=error
NERV_BUFFER_SIZE=100
NERV_TELEMETRY=false

# Kernel
KERNEL_CYCLE_INTERVAL=10

# Context
CONTEXT_STRATEGY=sliding_window
CONTEXT_MAX_TOKENS=10000
SUMMARIZATION_POLICY=none

# Missions
MISSIONS_DIR=missions-test
CHECKPOINT_KEEP_LAST=3

# Driver Factory
FACTORY_DEFAULT_TARGET=chatgpt
FACTORY_VALIDATE_BOOT=false

# MCP Integration (Multi-LLM Tool Server)
MCP_ENABLED=true
MCP_UPSTREAM_INSTALL_GLOBAL_HOOK=false

# ============================================================================
# [4] TUNING VARIABLES (Otimização - Testes Rápidos)
# ============================================================================
# CRITICIDADE: NONE

# Triage (timeouts curtos)
TRIAGE_LAG_THRESHOLD=1000
TRIAGE_LAG_RETRIES=1
TRIAGE_SNAPSHOT_DELAY=100
TRIAGE_MAX_TEXT_PARTS=100
TRIAGE_MAX_DEPTH=5
TRIAGE_TIMEOUT=2000
TRIAGE_SCAN_TIMEOUT=1000
TRIAGE_RED_THRESHOLD=180
TRIAGE_ORANGE_THRESHOLD=200
TRIAGE_IFRAME_THRESHOLD=0.4

# Frame Navigator (limites baixos)
FRAME_NAV_MAX_DEPTH=5
FRAME_NAV_TIMEOUT=5000
FRAME_NAV_BBOX_TIMEOUT=1000
FRAME_NAV_DISPOSE_RETRIES=1
FRAME_NAV_DISPOSE_DELAY=50

# Biomechanics Engine (timeouts mínimos)
BIOMECH_MAX_ITERATIONS=10
BIOMECH_KEEP_ALIVE=5000
BIOMECH_WAIT_POLL=100
BIOMECH_STABLE_ATTEMPTS=3
BIOMECH_STABLE_TOLERANCE=1.0
BIOMECH_STABLE_POLL=30
BIOMECH_STABLE_TIMEOUT=2000
BIOMECH_SCROLL_OFFSET=0.15
BIOMECH_SCROLL_MAX=0.3
BIOMECH_POST_SCROLL_DELAY=100
BIOMECH_ZEN_THRESHOLD=500
BIOMECH_ZEN_TIMEOUT=5000
BIOMECH_HUMAN_TIMEOUT=10000
BIOMECH_ECHO_LONG=0.6
BIOMECH_ECHO_SHORT=0.5
BIOMECH_MODIFIER_TTL=60000

# Recovery System (recovery rápido)
RECOVERY_KILL_TIMEOUT=1000
RECOVERY_RELOAD_TIMEOUT=5000
RECOVERY_TIER0_BACKOFF=100

# ============================================================================
# [5] FEATURE FLAGS (Funcionalidades)
# ============================================================================
# CRITICIDADE: NONE

PUPPETEER_LOCAL_LAUNCH_DISABLED=true
MOCK_CHROME=1
RECOVERY_TIER0_INCREMENT=100
RECOVERY_FOCUS_TIMEOUT=500
RECOVERY_MAX_RETRIES=1

# [15] SUBMISSION CONTROLLER (Testes: delays mínimos)
SUBMISSION_LOCK_DURATION=500
SUBMISSION_PRE_PRESS=50
SUBMISSION_DEBOUNCE=100
SUBMISSION_DEBOUNCE_MAX=200
SUBMISSION_POST_SEND=100

# [16] DASHBOARD (Testes: strict)
DASHBOARD_ORIGIN=http://localhost:3009
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=test_dashboard_password_123
DASHBOARD_SOCKET_AUTH_REQUIRED=true
DASHBOARD_COMMANDS_ENABLED=false
DASHBOARD_COMMAND_ROLE=admin
DASHBOARD_TASK_SYNC_MODE=ssot_feed
DASHBOARD_LEGACY_BRIDGE_CONTINGENCY=false
DASHBOARD_EMIT_TASK_UPDATED_COMPAT=false
CONTROL_REQUIRE_REASON=true
CONTROL_REQUIRE_IDEMPOTENCY_KEY=true
CONTROL_STRICT_PAUSE_TO_EDIT=true
RBAC_BOOTSTRAP_OWNER_USERNAME=owner
RBAC_BOOTSTRAP_OWNER_PASSWORD=test_owner_password_123
UI_PREFS_PERSISTENCE=sqlite
LEGACY_PATHS_CONTINGENCY=false
MISSION_STEP_DISPATCH_MODE=ssot_queue
MISSION_MANAGER_LEGACY_DISPATCH_ENABLED=false
JWT_SECRET=test_jwt_secret_change_me_at_least_32_chars_long
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_DEV=2000

# [17] LEGACY
ENABLE_STATE_FILE=false

# ============================================================================
# [18] OLLAMA & MCP INTEGRATION (v4.1 - CPU Optimized)
# ============================================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b
OLLAMA_GENERATE_TIMEOUT=60000
OLLAMA_EMBED_TIMEOUT=30000
OLLAMA_LIST_TIMEOUT=10000
OLLAMA_HEALTH_TIMEOUT=5000
OLLAMA_MAX_TOKENS=1000

# Timeout Cascade (4 layers - aligned to prevent mismatches)
# Layer 3 (innermost): OLLAMA_GENERATE_TIMEOUT=60000ms
# Layer 2: TOOL_EXECUTION_TIMEOUT=75000ms (NEW - registry wrapper)
# Layer 1: MCP_TOOL_TIMEOUT=90000ms (MCP handler)
# Layer 0 (outermost): SERVER_REQUEST_TIMEOUT=120000ms (HTTP server)
TOOL_EXECUTION_TIMEOUT=75000
MCP_TOOL_TIMEOUT=90000
SERVER_REQUEST_TIMEOUT=120000
