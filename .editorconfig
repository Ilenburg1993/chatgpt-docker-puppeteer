# =============================================================================
# .editorconfig — LLM-AUTO Cross-editor consistency
# Version: 5.1 FINAL (31/01/2026)
# =============================================================================
# OBJETIVO:
# • Padronizar edição de arquivos no editor
# • Garantir UTF-8 correto em Windows / WSL / Docker / PowerShell
# • Evitar bugs de BOM em shell / Dockerfile
#
# REGRA DE OURO (ENCODING):
# • PowerShell        → UTF-8 COM BOM
# • Shell / Docker    → UTF-8 SEM BOM
# • Node / JSON / Web → UTF-8 SEM BOM
# =============================================================================

root = true

# =============================================================================
# TIER 1: DEFAULT (aplicado a TODOS os arquivos)
# =============================================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# =============================================================================
# TIER 2: WINDOWS / POWERSHELL (ENCODING CRÍTICO)
# =============================================================================

# ---------------------------------------------------------------------------
# PowerShell — UTF-8 COM BOM (obrigatório no Windows PowerShell)
# ---------------------------------------------------------------------------
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
indent_size = 2
end_of_line = lf

# ---------------------------------------------------------------------------
# Windows Batch — UTF-8 SEM BOM + CRLF
# (compatível com chcp 65001)
# ---------------------------------------------------------------------------
[*.{bat,cmd}]
charset = utf-8
indent_size = 2
end_of_line = crlf

# =============================================================================
# TIER 3: LINGUAGENS DE PROGRAMAÇÃO
# =============================================================================

# JavaScript / TypeScript — 4 espaços
[*.{js,mjs,cjs,jsx,ts,tsx}]
indent_size = 4
#quote_type = single

# Python — PEP 8
[*.py]
indent_size = 4

# Shell scripts — UTF-8 SEM BOM (BOM PROIBIDO)
[*.{sh,bash,zsh}]
charset = utf-8
indent_size = 2
end_of_line = lf

# =============================================================================
# TIER 4: CONFIGURAÇÃO & DADOS
# =============================================================================

[*.{json,jsonc,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
max_line_length = 100

[*.toml]
indent_size = 2

[*.xml]
indent_size = 2

[*.sql]
indent_size = 2

# =============================================================================
# TIER 5: WEB ASSETS
# =============================================================================

[*.{html,htm}]
indent_size = 2

[*.{css,scss,sass,less}]
indent_size = 2

# =============================================================================
# TIER 6: DOCUMENTAÇÃO
# =============================================================================

[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 100

[*.txt]
indent_size = 2
max_line_length = 100

# =============================================================================
# TIER 7: BUILD & TOOLING
# =============================================================================

# Makefile — TAB obrigatório
[{Makefile,GNUmakefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

# Dockerfile — UTF-8 SEM BOM
[Dockerfile*]
charset = utf-8
indent_size = 4
end_of_line = lf

[docker-compose*.{yml,yaml}]
indent_size = 2

[{.dockerignore,.gitignore,.npmignore,.prettierignore}]
indent_size = 2

# =============================================================================
# TIER 8: DEVCONTAINER
# =============================================================================

[.devcontainer/devcontainer.json]
indent_size = 2

[.devcontainer/scripts/*.sh]
indent_size = 2
charset = utf-8
end_of_line = lf

# =============================================================================
# TIER 9: ENVIRONMENT & SECRETS
# =============================================================================

[{.env,.env.*,.env.example}]
indent_size = 2
trim_trailing_whitespace = true

# =============================================================================
# TIER 10: GIT
# =============================================================================

[{.gitattributes,.gitmodules}]
indent_size = 2

[*.gitconfig]
indent_style = tab
indent_size = 4

# =============================================================================
# TIER 11: IDE / EDITOR
# =============================================================================

[.vscode/*.json]
indent_size = 2

[{.prettierrc,.prettierrc.json,.eslintrc,.eslintrc.json,.babelrc,.babelrc.json}]
indent_size = 2

[eslint.config.{js,mjs,cjs}]
indent_size = 4

# =============================================================================
# TIER 12: CI/CD
# =============================================================================

[.github/**/*.{yml,yaml}]
indent_size = 2

[.github/**/*.md]
indent_size = 2

[.pre-commit-config.yaml]
indent_size = 2

# =============================================================================
# TIER 13: PROJECT-SPECIFIC
# =============================================================================

[{package.json,package-lock.json,yarn.lock,pnpm-lock.yaml}]
indent_size = 2

[{tsconfig*.json,jsconfig.json}]
indent_size = 2

[{ecosystem.config.js,.puppeteerrc.cjs}]
indent_size = 4

# =============================================================================
# TIER 14: TESTS
# =============================================================================

[{test_*.js,*_test.js,*.test.js,*.spec.js}]
indent_size = 4

[tests/**/*.js]
indent_size = 4

[tests/fixtures/**/*.{json,txt}]
indent_size = 2

# =============================================================================
# TIER 15: TEMP / GENERATED
# =============================================================================

[*.lock]
indent_size = 2

[temp_*.json]
indent_size = 2

# =============================================================================
# TIER 16: BINARY FILES (DO NOT TOUCH)
# =============================================================================

[*.{png,jpg,jpeg,gif,ico,bmp,svg,webp}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset

[*.{pdf,zip,tar,gz,tgz,7z,rar}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset

[*.{woff,woff2,ttf,otf,eot}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset

[*.{exe,dll,so,dylib,node}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
