# ============================================================================
# .env.expert.example — Catálogo de knobs avançados de ENV
# chatgpt-docker-puppeteer
# ============================================================================
#
# Este arquivo NÃO é carregado automaticamente pelo runtime.
# Ele existe como catálogo dos knobs especializados que ficaram fora do
# `.env.example` principal para não poluir o baseline operacional.
#
# Uso recomendado:
# 1. localize a variável desejada aqui;
# 2. copie apenas a chave necessária para `.env.local`, `.env` ou para o
#    orquestrador do ambiente;
# 3. não crie `.env.expert` como arquivo “ativo” esperando autoload.
#
# ============================================================================

# ============================================================================
# [1] BROWSER / POOL / SPLIT BOOT
# ============================================================================

# Tentativas máximas ao alocar página no browser pool.
# Baseline para pool size 3; se omitido, o runtime calcula dinamicamente.
BROWSER_ALLOCATE_MAX_ATTEMPTS=9

# Controles específicos do boot em modo split
SPLIT_CONNECT_MAX_ATTEMPTS=10
SPLIT_CONNECT_RETRY_BASE_MS=1000
SPLIT_CONNECT_RETRY_MAX_MS=8000
SPLIT_CONNECT_TIMEOUT_MS=5000
SPLIT_HANDSHAKE_TIMEOUT_MS=5000
SPLIT_WAIT_HEALTH=false

# Timeout de cleanup para descobertas de servidor em background
SERVER_DISCOVERY_CLEANUP_TIMEOUT=60000

# ============================================================================
# [2] DRIVER NERV ADAPTER
# ============================================================================

ADAPTER_EXECUTE_TIMEOUT=300000
ADAPTER_SHUTDOWN_TIMEOUT=30000
ADAPTER_HEALTH_INTERVAL=60000
ADAPTER_MAX_DRIVERS=10
ADAPTER_TELEMETRY_BUFFER=1000
ADAPTER_TELEMETRY_FLUSH_INTERVAL=1000
ADAPTER_DEGRADED_WARNING=60000
ADAPTER_EVENT_RETRY=3
ADAPTER_EVENT_BACKOFF=100
ADAPTER_CIRCUIT_THRESHOLD=5
ADAPTER_CIRCUIT_TIMEOUT=60000
ADAPTER_MAX_RETRIES=3
ADAPTER_RETRY_BACKOFF=1000
ADAPTER_TASK_HEARTBEAT_INTERVAL_MS=10000
ADAPTER_DIAGNOSTIC_HTML_MAX_BYTES=1000000

# ============================================================================
# [3] HANDLES / INPUT RESOLVER / SADI
# ============================================================================

HANDLE_CLEANUP_TIMEOUT=3000
HANDLE_DISPOSE_TIMEOUT=1000
HANDLE_MAX_HANDLES=1000

RESOLVER_CACHE_TTL=60000
RESOLVER_TIMEOUT=15000
RESOLVER_VALIDATION_TIMEOUT=5000
RESOLVER_MAX_RETRIES=2
RESOLVER_CACHE_SIZE=10
RESOLVER_MIN_CONFIDENCE=0.7

SADI_DEBUG=false

# ============================================================================
# [4] RUNTIME AUXILIAR / SOCKETS / DIAGNÓSTICO
# ============================================================================

# Endpoint alternativo do NERV via socket.io
NERV_SOCKET_URL=http://localhost:3008

# Base usada por scripts de diagnose MCP/LSP/RAG
MCP_DIAG_URL=http://localhost:3008

# Override do host da API do dashboard consumida por probes locais
DASHBOARD_API_HOST=127.0.0.1

# Inference Gateway: override explícito do enable
INFERENCE_GATEWAY_ENABLED=true

# Snapshot periódico do processo do servidor
SNAPSHOT_INTERVAL_MS=60000

# Override explícito do módulo `jsonc-parser` usado pelos wrappers `jsonc-validate`
# e `scripts/check-devcontainer-sync.sh`.
JSONC_PARSER_MODULE_PATH=/usr/local/share/npm-global/lib/node_modules/jsonc-parser

# ============================================================================
# [5] OLLAMA / RAG LEGADO E SUPERVISÃO
# ============================================================================

# Alias legado para compatibilidade; prefira OLLAMA_LOCAL_BASE_URL
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Supervisor opcional do host Ollama
OLLAMA_SUPERVISOR_ENABLED=false
OLLAMA_HEALTH_POLL_MS=5000

# Manifest de prontidão do índice RAG
RAG_MANIFEST_PATH=/home/node/.local/share/rag-index/manifest.v1.json

# ============================================================================
# [6] COPILOT TERMINAL BYOK / MULTI-PROVIDER
# ============================================================================

# Habilita provider externo nativo do @github/copilot-sdk para a LLM-B.
# Não habilite apenas por ter uma API key no ambiente; deixe true quando quiser
# que as sessões SDK usem o provider customizado.
COPILOT_BYOK_ENABLED=false
COPILOT_BYOK_PROFILE=
COPILOT_BYOK_PROFILES_JSON=

# Presets: openai | openai-compatible | azure | anthropic | ollama-local | ollama-cloud | custom
COPILOT_BYOK_PROVIDER_PRESET=
COPILOT_BYOK_PROVIDER_TYPE=
COPILOT_BYOK_BASE_URL=
COPILOT_BYOK_WIRE_API=completions

# Obrigatório quando BYOK está ativo. O SDK não aceita model=auto com provider custom.
COPILOT_BYOK_MODEL=
COPILOT_BYOK_MODELS=
COPILOT_BYOK_MODELS_JSON=
COPILOT_BYOK_MODELS_ENDPOINT=
COPILOT_BYOK_MODEL_DISCOVERY_ENABLED=true
COPILOT_BYOK_MODEL_DISCOVERY_TIMEOUT_MS=7000
COPILOT_BYOK_MODEL_DISCOVERY_TTL_MS=300000

# Capabilities declaradas ao SDK e ao /model list quando o provider não tem catálogo próprio.
COPILOT_BYOK_CONTEXT_WINDOW_TOKENS=128000
COPILOT_BYOK_SUPPORTS_REASONING=false
COPILOT_BYOK_SUPPORTS_VISION=false

# Azure nativo: use baseUrl como host, sem /openai/v1. Azure Foundry OpenAI-compatible
# deve usar preset openai-compatible e baseUrl completo.
COPILOT_BYOK_AZURE_API_VERSION=2024-10-21

# Headers adicionais em JSON. Não coloque segredos aqui se puder usar
# COPILOT_BYOK_API_KEY/COPILOT_BYOK_BEARER_TOKEN em .env.local.
COPILOT_BYOK_HEADERS_JSON=

# Kilo Gateway / Kilo Code: OpenAI-compatible com Bearer token.
# Base URL oficial: https://api.kilo.ai/api/gateway
# Modelo exemplo: anthropic/claude-sonnet-4.5
KILO_API_KEY=
KILO_CODE_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL=anthropic/claude-sonnet-4.5

# ============================================================================
# [7] PM2 / PROXY
# ============================================================================

# Janela de desligamento gracioso do Chrome Proxy sob PM2
PM2_KILL_TIMEOUT_MS=12000
