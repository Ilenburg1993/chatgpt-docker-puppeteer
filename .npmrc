# ===================================================================
# npm configuration — projeto chatgpt-docker-puppeteer
# Escopo: projeto (npm 11+ compatível)
# ===================================================================

# Evita logs excessivos em CI e DevContainer
loglevel=warn

# Registry canônico (evita drift em mirrors/proxies desatualizados)
registry=https://registry.npmjs.org/
@github:registry=https://registry.npmjs.org/

# Segurança e previsibilidade
audit=false
fund=false

# Performance e frescor de metadados (evita leituras obsoletas de dist-tags)
prefer-online=true
prefer-offline=false
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Compatibilidade: madge@8 ainda declara peer TS ^5.4.4, enquanto o projeto usa TS 6.x
legacy-peer-deps=true

# Compatibilidade com projetos grandes
progress=false

# Garante que engines incompatíveis falhem explicitamente
engine-strict=true

# Garante comportamento consistente entre npm install / npm ci
package-lock=true

# Cache (usa HOME do ambiente para funcionar em DevContainer e CI)
cache=${HOME}/.npm
