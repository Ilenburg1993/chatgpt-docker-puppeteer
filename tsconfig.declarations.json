{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "/home/node/.cache/typescript/tsconfig.declarations.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./tmp/types-public"
  },
  "include": [
    "src/shared/health-check.js",
    "src/shared/inference-gateway-client.js",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "logs",
    "fila",
    "respostas",
    "artifacts",
    "profile",
    "public",
    "backups",
    "monitoring",
    "tmp",
    "analysis",
    "local-login",
    "DOCUMENTAÇÃO",
    ".git",
    "**/node_modules/**",
    "**/*.min.js",
    "**/*.map",
    "**/*.bundle.js",
    "**/*.d.ts.map",
    "**/*.js.map"
  ]
}
