{
  "name": "chatgpt-docker-puppeteer",
  "version": "1.0.0",
  "description": "🤖 Autonomous AI agent for browser automation with Puppeteer - Domain-driven task processing with adaptive validation and real-time monitoring",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": "./index.js",
  "imports": {
    "#main": "./src/main.js",
    "#core/*": "./src/core/*.js",
    "#shared/*": "./src/shared/*.js",
    "#nerv/*": "./src/nerv/*.js",
    "#kernel/*": "./src/kernel/*.js",
    "#driver/*": "./src/driver/*.js",
    "#infra/*": "./src/infra/*.js",
    "#integration/*": "./src/integration/*.mjs",
    "#server/*": "./src/server/*.js",
    "#logic/*": "./src/logic/*.js",
    "#orchestrator/*": "./src/orchestrator/*.js",
    "#missions/*": "./src/missions/*.js",
    "#validation/*": "./src/validation/*.js"
  },
  "directories": {
    "lib": "src",
    "test": "tests",
    "scripts": "scripts",
    "doc": "DOCUMENTAÇÃO"
  },
  "workspaces": [
    "src/dashboard-ui"
  ],
  "files": [
    "src/",
    "scripts/",
    "tests/",
    "public/",
    "index.js",
    "ecosystem.config.cjs",
    "config.json",
    "dynamic_rules.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.js",
    "start:container": "NODE_ENV=development NODE_OPTIONS='--inspect=0.0.0.0:9229 --enable-source-maps --trace-warnings --trace-uncaught --unhandled-rejections=strict' node index.js",
    "dev": "nodemon --exec \"node --inspect=0.0.0.0:9229\" index.js --ignore fila/ --ignore logs/ --ignore respostas/",
    "dashboard:dev": "npm --workspace dashboard-ui run dev",
    "dashboard:build": "npm --workspace dashboard-ui run build",
    "dashboard:preview": "npm --workspace dashboard-ui run preview",
    "daemon:start": "npx pm2 start ecosystem.config.cjs",
    "daemon:stop": "npx pm2 stop agente-gpt dashboard-web chrome-proxy",
    "daemon:restart": "npx pm2 restart agente-gpt dashboard-web chrome-proxy",
    "daemon:reload": "npx pm2 reload agente-gpt dashboard-web chrome-proxy",
    "daemon:monit": "npx pm2 monit",
    "daemon:logs": "npx pm2 logs --lines 50",
    "daemon:flush": "npx pm2 flush",
    "daemon:kill": "npx pm2 delete all",
    "daemon:status": "npx pm2 status",
    "queue:status": "node scripts/status_fila.js",
    "queue:add": "node scripts/gerador_tarefa.js",
    "queue:import": "node scripts/importar_prompts.js",
    "queue:graph": "node scripts/visualizar_fila.js > fila.dot",
    "queue:flow": "node scripts/flow_manager.js",
    "analyze:deps": "npx madge --circular --extensions js src/",
    "analyze:deps:graph": "npx madge --circular --extensions js --image deps-graph.svg src/",
    "analyze:graph": "node scripts/analyze-code-graph.js --stats",
    "analyze:graph:full": "node scripts/analyze-code-graph.js --stats --circular --orphans --nerv",
    "analyze:graph:export": "node scripts/analyze-code-graph.js --export-json --export-dot",
    "analyze:circular": "node scripts/analyze-code-graph.js --circular",
    "analyze:orphans": "node scripts/analyze-code-graph.js --orphans",
    "analyze:nerv": "node scripts/analyze-code-graph.js --nerv",
    "vscode:check": "node scripts/check-vscode-extensions.js",
    "vscode:list": "code --list-extensions --show-versions",
    "vscode:update": "code --update-extensions",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; ['logs','tmp','RUNNING.lock'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})); console.log('[OK] Ambiente limpo.');\"",
    "clean:queue": "node --input-type=module -e \"import fs from 'node:fs'; import path from 'node:path'; const D='fila'; if(fs.existsSync(D))fs.readdirSync(D).filter(f=>f.endsWith('.json')).forEach(f=>fs.rmSync(path.join(D,f))); console.log('[OK] Fila limpa.');\"",
    "clean:logs": "rm -rf logs/*.log logs/crash_reports/*",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:quiet": "eslint . --quiet",
    "lint:report": "eslint . --output-file logs/eslint-report.txt --format stylish",
    "lint:src": "eslint src/",
    "lint:tests": "eslint tests/",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "maintenance": "node scripts/puppeteer_maintenance.js",
    "maintenance:clean-cache": "node scripts/puppeteer_maintenance.js --clean-cache",
    "profiles:rotate": "node scripts/rotate-profiles.js",
    "profiles:stats": "node --input-type=module -e \"import('./scripts/rotate-profiles.js').then(m=>m.getBackupStats()).then(s=>console.log(JSON.stringify(s,null,2)))\"",
    "diagnose": "node scripts/analisar_crash.js",
    "mcp:diagnose": "node scripts/diagnose-mcp.mjs",
    "check:chrome": "node scripts/check-chrome.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:regression",
    "test:unit": "node --test 'tests/unit/**/*.spec.js'",
    "test:integration": "node --test 'tests/integration/**/*.spec.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.spec.js'",
    "test:regression": "node --test 'tests/regression/**/*.spec.js'",
    "mock-chrome": "node scripts/mock-chrome-http.js",
    "test:coverage": "npx c8 npm test",
    "test:watch": "node --test --watch 'tests/**/*.spec.js'",
    "preinstall": "NODE_OPTIONS= node --input-type=module -e \"if(process.env.npm_execpath.includes('yarn')) throw new Error('Use npm instead of yarn')\"",
    "postinstall": "echo '✅ Dependencies installed successfully'",
    "prepare": "NODE_OPTIONS= node --input-type=module -e \"try{await import('husky')}catch(e){}\"",
    "validate": "node scripts/validate_config.js",
    "validate:all": "npm run check:envlocal && npm run lint:quiet && npm run format:check && npm test",
    "check:forbidden": "node scripts/check_forbidden_patterns.js",
    "check:envlocal": "node scripts/check-env-local.mjs",
    "check": "npm run validate:all",
    "summarize-code": "python3 agents/code_explainer/generate_summary.py",
    "rag:health": "node tools/rag/health.mjs",
    "rag:index": "node tools/rag/index.mjs",
    "rag:ask": "node tools/rag/ask.mjs",
    "rag:hybrid": "node tools/rag/hybrid.mjs",
    "rag:reset": "node tools/rag/reset.mjs",
    "rag:full-rebuild": "npm run rag:reset -- --yes && npm run rag:index"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.4",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "8.2.1",
    "ghost-cursor": "^1.4.2",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "ignore": "^5.3.2",
    "js-yaml": "^4.1.1",
    "node-html-parser": "^7.0.2",
    "openai": "^6.17.0",
    "p-limit": "^7.0",
    "pino": "^10.3.0",
    "pm2": "^6.0.14",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.36.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.2",
    "user-agents": "^1.1.669",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/markdown": "^7.5.1",
    "@faker-js/faker": "10.2.0",
    "@types/node": "25.2.2",
    "@types/puppeteer": "^5.4.7",
    "audit-ci": "^7.1.0",
    "c8": "10.1.3",
    "complexity-report": "^2.0.0-alpha",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-i18next": "6.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.3.0",
    "graphviz-cli": "^2.0.0",
    "jscodeshift": "17.3.0",
    "jscpd": "^4.0.8",
    "madge": "^8.0.0",
    "mermaid": "^11.12.2",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^17.1.3",
    "pino-pretty": "^13.1.0",
    "prettier": "3.8.1",
    "puppeteer-core": "^24.36.1",
    "sinon": "21.0.1",
    "supertest": "7.2.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0",
    "pnpm": ">=9.0.0",
    "yarn": ">=1.0.0",
    "bun": ">=1.1.0"
  },
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "author": {
    "name": "Ilenburg1993",
    "url": "https://github.com/Ilenburg1993"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ilenburg1993/chatgpt-docker-puppeteer.git"
  },
  "bugs": {
    "url": "https://github.com/Ilenburg1993/chatgpt-docker-puppeteer/issues"
  },
  "homepage": "https://github.com/Ilenburg1993/chatgpt-docker-puppeteer#readme",
  "keywords": [
    "chatgpt",
    "puppeteer",
    "automation",
    "browser-automation",
    "ai-agent",
    "autonomous-agent",
    "task-queue",
    "websocket",
    "docker",
    "nodejs",
    "pm2"
  ],
  "volta": {
    "node": "24.13.0",
    "npm": "11.8.0"
  }
}
