      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "📌 Attach to PM2 (9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "showAsyncStacks": true,
      "presentation": {
        "hidden": false,
        "group": "attach",
        "order": 1
      }
      // ⚠️  WARNING: Only use this when PM2 is running with --node-args="--inspect=0.0.0.0:9229"
      // To start with debug: pm2 start ecosystem.config.js --node-args="--inspect=0.0.0.0:9229"
      // To check if debug is active: curl -s http://127.0.0.1:9229/json/list
    },
    {
      "type": "node",
      "request": "attach",
      "name": "📌 Attach to PM2 (9230)",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "presentation": {
        "hidden": false,
        "group": "attach",
        "order": 2
      }
      // ⚠️  WARNING: Only use when dashboard is running with --inspect=0.0.0.0:9230
    },
    {
      "type": "node",
      "request": "attach",
      "name": "🐳 Attach to Docker (9229)",
      "port": 9229,
      "address": "localhost",
      "restart": false,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "showAsyncStacks": true,
      "presentation": {
        "hidden": false,
        "group": "attach",
        "order": 3
      }
      // ⚠️  For standalone Docker (not DevContainer)
    },
    {
      "type": "node",
      "request": "attach",
      "name": "🐳 Attach to Docker (9230)",
      "port": 9230,
      "address": "localhost",
      "restart": false,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "presentation": {
        "hidden": false,
        "group": "attach",
        "order": 4
      }
      // ⚠️  For standalone Docker (not DevContainer)
    },
    {
      "name": "🎨 Debug Vite Dev Server (Vue)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/dashboard-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "VITE_CJS_TRACE": "true"
      },
      "presentation": {
        "hidden": false,
        "group": "vue",
        "order": 1
      }
      // Use this to debug Vite configuration issues
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Debug Vue App in Chrome",
      "url": "http://localhost:5173/dashboard/",
      "webRoot": "${workspaceFolder}/src/dashboard-ui",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "${workspaceFolder}/*"
      },
      "presentation": {
        "hidden": false,
        "group": "vue",
        "order": 2
      },
      "preLaunchTask": null
      // ⚠️  Requires Vite dev server running (port 5173)
      // ⚠️  Requires Chrome remote debugging enabled
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full System (Agent + Dashboard)",
      "configurations": ["🚀 Debug Agente (Enhanced)", "📊 Debug Dashboard (Enhanced)"],
      "stopAll": true
    },
    {
      "name": "🧪 Regression Tests (P1-P5)",
      "configurations": ["🧪 Debug P1 Fixes", "🧪 Debug P2 Fixes", "🧪 Debug P3 Fixes", "🧪 Debug P4-P5 Fixes"],
      "stopAll": true
    },
    {
      "name": "🧪 Integration Tests",
      "configurations": ["🧪 Debug Driver NERV", "🧪 Debug Launcher Integration", "🧪 Debug Browser Connection"],
      "stopAll": true
    },
    {
      "name": "🔍 Full Subsystems",
      "configurations": ["🧠 Debug NERV Subsystem", "⚙️ Debug Kernel Engine", "🎮 Debug Driver (ChatGPT/Gemini)"],
      "stopAll": true
    },
    {
      "name": "⚡ Critical Path (Boot + NERV + Kernel)",
      "configurations": ["🔧 Debug Boot Sequence", "🧠 Debug NERV Subsystem", "⚙️ Debug Kernel Engine"],
      "stopAll": true
    }
  ]
}
