{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deploy Cloud Function",
      "type": "cloudcode.cloudfunctions",
      "request": "launch",
      "functionName": "CLOUDE-CONFIG",
      "gen": "GEN_2",
      "revision": "",
      "entryPoint": "CLOUDE-CONFIG",
      "testInput": "CLOUD-TEST"
    },
    {
      "name": "Node: Agente (dev)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "DEBUG": "nerv:*,kernel:*,driver:*",
        "FORCE_COLOR": "1"
      },
      "runtimeArgs": [
        "--enable-source-maps",
        "--max-old-space-size=2048"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Node: Dashboard (dev)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server/main.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "development",
        "PORT": "3008",
        "LOG_LEVEL": "debug",
        "DEBUG": "server:*",
        "FORCE_COLOR": "1"
      },
      "runtimeArgs": [
        "--enable-source-maps",
        "--max-old-space-size=1024"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Node: Test current file",
      "type": "pwa-node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test",
        "LOG_LEVEL": "debug"
      },
      "autoAttachChildProcesses": true
    },
    {
      "name": "Attach: PM2 agente (9229)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Attach: Docker (9229)",
      "type": "pwa-node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": false,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Vite: dashboard",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/dashboard-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "presentation": {
        "group": "vue"
      }
    },
    {
      "name": "Chrome: Vue app",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/dashboard/",
      "webRoot": "${workspaceFolder}/src/dashboard-ui",
      "sourceMaps": true,
      "presentation": {
        "group": "vue"
      }
    },
    {
      "name": "Debug Python Agent HTTP Server",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5679
      },
      "preLaunchTask": "Open Agent Inspector",
      "internalConsoleOptions": "neverOpen",
      "postDebugTask": "Terminate All Tasks"
    },
    {
      "name": "Debug Python Agent in Terminal",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5679
      },
      "preLaunchTask": "Run Python Agent in Terminal",
      "internalConsoleOptions": "neverOpen",
      "postDebugTask": "Terminate All Tasks"
    }
  ],
  "compounds": [
    {
      "name": "Full system",
      "configurations": [
        "Node: Agente (dev)",
        "Node: Dashboard (dev)"
      ],
      "stopAll": true
    },
    {
      "name": "Regression Tests",
      "configurations": ["Node: Test current file"],
      "stopAll": true
    },
    {
      "name": "Dashboard full debug",
      "configurations": [
        "Vite: dashboard",
        "Chrome: Vue app"
      ],
      "stopAll": true
    }
  ]
}
