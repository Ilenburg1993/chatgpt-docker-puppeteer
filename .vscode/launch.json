{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Debug Agente (Enhanced)",
      "program": "${workspaceFolder}/index.js",
      "runtimeArgs": ["--max-old-space-size=2048", "--expose-gc"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "showAsyncStacks": true,
      "trace": false,
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "DEBUG": "nerv:*,kernel:*,driver:*",
        "FORCE_COLOR": "1"
      },
      "console": "integratedTerminal",
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "📊 Debug Dashboard (Enhanced)",
      "program": "${workspaceFolder}/src/server/main.js",
      "runtimeArgs": ["--max-old-space-size=1024"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "showAsyncStacks": true,
      "env": {
        "NODE_ENV": "development",
        "PORT": "3008",
        "LOG_LEVEL": "debug",
        "DEBUG": "server:*",
        "FORCE_COLOR": "1"
      },
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "type": "node",
