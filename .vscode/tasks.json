{
  // workspace tasks for chatgpt-docker-puppeteer
  // grouped by build, test, and utility categories.
  // most commands delegate to Makefile targets for portability.
  "version": "2.0.0",
  "presentation": {
    "panel": "shared"
  },
  "tasks": [
    {
      "label": "lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "format",
      "type": "shell",
      "command": "make format-code",
      "group": "build"
    },
    {
      "label": "typecheck:node",
      "type": "shell",
      "command": "npm run typecheck:node",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "typecheck do backend Node 24 + ESM"
    },
    {
      "label": "typecheck:tools",
      "type": "shell",
      "command": "npm run typecheck:tools",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "typecheck de tests, scripts e ferramentas"
    },
    {
      "label": "typecheck:browser",
      "type": "shell",
      "command": "npm run typecheck:browser",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "typecheck do alvo browser/dashboard"
    },
    {
      "label": "typecheck:full",
      "type": "shell",
      "command": "npm run typecheck:full",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "typecheck consolidado de node, tools e browser"
    },
    {
      "label": "typecheck:strict",
      "type": "shell",
      "command": "npm run typecheck:strict",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "detail": "trilha opt-in de strict mode para dominios priorizados"
    },
    {
      "label": "typecheck:watch:node",
      "type": "shell",
      "command": "npm run typecheck:watch:node",
      "problemMatcher": ["$tsc-watch"],
      "group": "build",
      "isBackground": true,
      "detail": "watch de typecheck do backend Node"
    },

    {
      "label": "test:fast",
      "type": "shell",
      "command": "make test-fast",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "test:integration",
      "type": "shell",
      "command": "make test-integration",
      "group": "test"
    },
    {
      "label": "test:all",
      "type": "shell",
      "command": "make test-all",
      "group": "test"
    },

    {
      "label": "health:core",
      "type": "shell",
      "command": "make health-core",
      "group": "test",
      "detail": "quick health check of core services"
    },
    {
      "label": "health:full",
      "type": "shell",
      "command": "make health",
      "group": "test",
      "detail": "run full health diagnostics (takes longer)"
    },

    {
      "label": "pm2:start",
      "type": "shell",
      "command": "make start",
      "group": "none",
      "detail": "start PM2 agent (alias to npm run daemon:start)"
    },
    {
      "label": "pm2:stop",
      "type": "shell",
      "command": "make stop",
      "group": "none",
      "detail": "stop PM2 agent"
    },
    {
      "label": "pm2:restart",
      "type": "shell",
      "command": "make restart",
      "group": "none",
      "detail": "restart PM2 agent"
    },
    {
      "label": "pm2:status",
      "type": "shell",
      "command": "make status",
      "group": "none",
      "detail": "show PM2 process status"
    },
    {
      "label": "pm2:monitor",
      "type": "shell",
      "command": "make monit",
      "isBackground": true,
      "detail": "start PM2 dashboard (alias 'monit' target in Makefile)"
    },

    {
      "label": "logs:follow",
      "type": "shell",
      "command": "make logs",
      "isBackground": true,
      "group": "none",
      "detail": "tail the logs continuously"
    },
    {
      "label": "test:watch",
      "type": "shell",
      "command": "make test-watch",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": "test",
      "isBackground": true,
      "detail": "watch unit tests (invokes npm run test:watch via Makefile)"
    },

    {
      "label": "queue:status",
      "type": "shell",
      "command": "make queue",
      "group": "none",
      "detail": "display current task queue"
    },
    {
      "label": "queue:flow",
      "type": "shell",
      "command": "make queue-flow",
      "isBackground": true,
      "group": "none",
      "detail": "launch the queue flow manager (interactive)"
    },
    {
      "label": "queue:clean",
      "type": "shell",
      "command": "make queue-clean",
      "group": "none",
      "detail": "clear all tasks from the queue"
    },
    {
      "label": "queue:add",
      "type": "shell",
      "command": "make queue-add"
    },

    {
      "label": "git:safe-push",
      "type": "shell",
      "command": "make git-push-safe",
      "group": "none",
      "detail": "run pre-push validation checks defined in Makefile"
    },
    {
      "label": "git:changed",
      "type": "shell",
      "command": "make git-changed",
      "group": "none",
      "detail": "show changed files ready for commit"
    },

    {
      "label": "deps:check",
      "type": "shell",
      "command": "make deps-consistency",
      "group": "none",
      "detail": "verify package dependency consistency"
    },
    {
      "label": "deps:install",
      "type": "shell",
      "command": "make install-deps",
      "group": "none",
      "detail": "install project dependencies via Makefile wrapper"
    },
    {
      "label": "deps:update",
      "type": "shell",
      "command": "make update-deps",
      "group": "none",
      "detail": "check for outdated dependencies"
    },

    {
      "label": "clean",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "diagnose",
      "type": "shell",
      "command": "make diagnose"
    },
    {
      "label": "backup",
      "type": "shell",
      "command": "make backup"
    },

    {
      "label": "info",
      "type": "shell",
      "command": "make info"
    },
    {
      "label": "version",
      "type": "shell",
      "command": "make version"
    },
    {
      "label": "check-deps",
      "type": "shell",
      "command": "make check-deps"
    },

    {
      "label": "validate:json",
      "type": "shell",
      "command": "node -e \"const fs=require('fs'),path=require('path');const files=['package.json','config.json','controle.json','dynamic_rules.json','ecosystem.config.js'];let errs=0;files.forEach(f=>{if(!fs.existsSync(f))return;try{JSON.parse(fs.readFileSync(f));console.log('✓',f);}catch(e){console.error(path.resolve(f)+':1:'+e.message);errs++;}});process.exit(errs);\"",
      "problemMatcher": {
        "owner": "json-validator",
        "source": "json",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      "group": "test",
      "detail": "verify that critical JSON files parse correctly"
    },
    {
      "label": "validate:shell",
      "type": "shell",
      "command": "bash -c \"if command -v shellcheck >/dev/null 2>&1; then find . -name '*.sh' -not -path './node_modules/*' -not -path './backups/*' -exec shellcheck -f gcc {} +; else echo 'ShellCheck not installed'; fi\"",
      "problemMatcher": {
        "owner": "shellcheck",
        "source": "shellcheck",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)\\s+\\[(.+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      },
      "group": "test",
      "detail": "lint shell scripts using shellcheck"
    },
    {
      "label": "validate:git",
      "type": "shell",
      "command": "git diff --check",
      "problemMatcher": {
        "owner": "git",
        "source": "git",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      "group": "test",
      "detail": "run git diff checker for whitespace errors"
    },
    {
      "label": "validate:node",
      "type": "shell",
      "command": "bash -c 'errors=0; for file in $(find src tests -name \"*.js\" 2>/dev/null); do node --check \"$file\" 2>&1 | grep -v \"Debugger\" && ((errors++)); done; exit $errors'",
      "problemMatcher": {
        "owner": "node-syntax",
        "source": "node",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+)$",
          "file": 1,
          "line": 2,
          "message": 0
        }
      },
      "group": "test",
      "detail": "check JS syntax across src and tests"
    },
    {
      "label": "validate:all",
      "dependsOn": [
        "lint",
        "test:fast",
        "health:core",
        "git:changed",
        "validate:json",
        "validate:shell",
        "validate:git",
        "validate:node"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "detail": "run a suite of linting/validation checks in order"
    },
    // Python agent debug/inspector tasks
    {
      "label": "Validate Python Debug Prerequisites",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [
          5679,
          8087
        ]
      }
    },
    {
      "label": "Run Python Agent HTTP Server",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 -m agentdev run agents/server.py --verbose --port 8087 -- --server",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Validate Python Debug Prerequisites"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|running on|Started server process"
        }
      }
    },
    {
      "label": "Open Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "presentation": {
        "reveal": "never"
      },
      "dependsOn": [
        "Run Python Agent HTTP Server"
      ]
    },
    {
      "label": "Run Python Agent in Terminal",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 -m agentdev run agents/server.py --cli",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|running on|Started server process"
        }
      }
    },
    {
      "label": "Terminate All Tasks",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    },
    {
      "label": "terminal:llm-b",
      "type": "shell",
      "command": "npm --silent run terminal:llm-b",
      "group": "none",
      "detail": "Abrir terminal permanente LLM-B (REPL interativo + inject server :3009)",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "title": "Terminal LLM-B"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^NUNCA$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[TerminalServer\\] Iniciando terminal",
          "endsPattern": "LLM-B pronta"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": { "triggeredFrom": "tasks", "port": 8087 }
    },
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
