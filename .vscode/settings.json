// ===========================================================================
// VS Code — Workspace settings (JSONC)
// Organizado por fases e subfases sem alterar os valores efetivos.
// Contrato: apenas reordenacao, melhor documentacao e agrupamento semantico.
// ===========================================================================
{
  // ===========================================================================
  // FASE 00) OVERRIDES POR LINGUAGEM
  // Formatters, CodeLens e sugestoes especificas por linguagem.
  // ===========================================================================
  // Subfase 00.1) Scopes de linguagem
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[javascript]": {
    "editor.codeLens": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.codeLens": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.suggest.preview": true,
    "editor.suggest.showInlineDetails": true,
    "editor.wordBasedSuggestions": "true",
    "editor.wordWrap": "on"
  },
  "[powershell]": {
    "files.encoding": "utf8bom"
  },
  "[typescript]": {
    "editor.codeLens": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.codeLens": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ===========================================================================
  // FASE 01) IDENTIDADE / TOOLCHAIN BASE / SINAIS GLOBAIS
  // Flags-base do workspace e pistas de navegacao globais.
  // ===========================================================================
  // Subfase 01.1) Flags base
  "appmod.experimental.task.typescript.upgrade": true,
  // Subfase 01.2) Breadcrumbs
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "last",

  // ===========================================================================
  // FASE 02) ARQUIVOS / ENCODING / AUTOSAVE / INTEGRIDADE
  // Comportamento de leitura, salvamento e higiene de arquivos.
  // ===========================================================================
  // Subfase 02.1) Arquivos e encoding
  "files.associations": {},
  "files.autoGuessEncoding": true,
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.refactoring.autoSave": true,
  "files.restoreUndoStack": true,
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "files.simpleDialog.enable": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    // --- Módulos e artefatos de build (alta densidade de arquivos) ---
    // node_modules: ~953 pacotes, ~100 k+ arquivos, 1,1 GB. Nunca mudam durante
    // o trabalho; observá-los consome ~40-60% das cotas de inotify e gera
    // eventos constantes que atravessam VS Code → Copilot. Exclusão obrigatória.
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/backups/**": true,
    // --- Diretórios de runtime do projeto (escrita frequente durante sessões) ---
    // Cada linha escrita em logs/ ou arquivo criado em fila/respostas/ dispara
    // um evento inotify → VS Code processa → overhead em sessões de coding ativo.
    // Estes dirs são gerados/consumidos pelo agente, não são código-fonte.
    "**/logs/**": true,
    "**/fila/**": true,
    "**/respostas/**": true,
    "**/tmp/**": true,
    // Estado interno dos hooks: escrito em toda tool call do Copilot →
    // excluir evita feedback loop de eventos durante a própria sessão.
    "**/.github/hooks/state/**": true,
    // --- Ambientes e caches Python ---
    "**/.venv/**": true,
    "**/.codex/sessions/**": true,
    "**/.codex/shell_snapshots/**": true,
    "**/.codex/tmp/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true
  },

  // ===========================================================================
  // FASE 03) EDITOR — BASE / FORMATACAO / SAVE PIPELINE
  // Configuracoes estruturais do editor e pipeline de escrita.
  // ===========================================================================
  // Subfase 03.1) Base e formatacao
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.codeActions.triggerOnFocusChange": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "never",
    "source.fixAll.prettier": "never",
    "source.organizeLinkDefinitions": "always",
    "source.organizeImports": "explicit",
    "source.sort.json": "never"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.detectIndentation": true,
  "editor.experimental.preferTreeSitter.typescript": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,

  // ===========================================================================
  // FASE 04) EDITOR — UX / RENDER / CURSOR / MINIMAP
  // Ajustes visuais e ergonomicos do editor.
  // ===========================================================================
  // Subfase 04.1) Cursor e renderizacao
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.mouseWheelZoom": true,
  "editor.renderControlCharacters": true,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [
    100,
    120
  ],
  "editor.smoothScrolling": true,
  "editor.stickyScroll.defaultModel": "outlineModel",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.maxLineCount": 5,

  // ===========================================================================
  // FASE 05) EDITOR — SUGESTOES / INTELLISENSE / INLINE
  // Completions, hints e experiencia de assistencia inline.
  // ===========================================================================
  // Subfase 05.1) Sugestoes e inline
  "editor.inlayHints.padding": true,
  "editor.inlineCompletionsAccessibilityVerbose": true,
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.minShowDelay": 100,
  "editor.inlineSuggest.suppressSuggestions": false,
  "editor.inlineSuggest.syntaxHighlightingEnabled": true,
  "editor.largeFileOptimizations": true,
  "editor.lightbulb.enabled": "on",
  "editor.linkedEditing": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "other": "on",
    "strings": "on"
  },
  "editor.quickSuggestionsDelay": 100,
  "editor.snippetSuggestions": "bottom",
  "editor.suggest.filterGraceful": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.matchOnWordStartOnly": false,
  "editor.suggest.preview": true,
  "editor.suggest.selectionMode": "always",
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showInlineDetails": true,
  "editor.suggest.showSnippets": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "matchingDocuments",
  // ===========================================================================
  // FASE 06) EDITOR — NAVEGACAO / FOLDING / MATCHING
  // Navegacao, dobragem e comportamento de leitura.
  // ===========================================================================
  // Subfase 06.1) Navegacao e estrutura
  "editor.folding": true,
  "editor.foldingHighlight": true,
  "editor.foldingMaximumRegions": 5000,
  "editor.foldingStrategy": "auto",
  "editor.gotoLocation.alternativeImplementationCommand": "editor.action.peekImplementation",
  "editor.gotoLocation.alternativeReferenceCommand": "editor.action.referenceSearch.trigger",
  "editor.gotoLocation.alternativeTypeDefinitionCommand": "editor.action.peekImplementation",
  "editor.gotoLocation.multipleDefinitions": "peek",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.matchBrackets": "always",
  "editor.occurrencesHighlight": "singleFile",
  "editor.occurrencesHighlightDelay": 100,
  "editor.selectionHighlight": false,
  "editor.showFoldingControls": "always",
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,
  "editor.wrappingIndent": "indent",

  // ===========================================================================
  // FASE 07) CODELENS / OUTLINE / SINAIS DE LEITURA
  // Sinais auxiliares de leitura e navegacao estrutural.
  // ===========================================================================
  // Subfase 07.1) CodeLens e outline
  "editor.codeLens": true,
  "geminicodeassist.outlines.automaticOutlineGeneration": true,
  "gitlens.codeLens.enabled": true,
  "outline.showFiles": true,
  "outline.showFunctions": true,
  "outline.showModules": true,
  "outline.showVariables": false,

  // ===========================================================================
  // FASE 08) DIFF EDITOR
  // Ajustes do editor de diff e comparacao.
  // ===========================================================================
  // Subfase 08.1) Diff
  "diffEditor.codeLens": true,
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.maxComputationTime": 0,
  "diffEditor.maxFileSize": 100,
  "diffEditor.renderIndicators": true,
  "diffEditor.renderMarginRevertIcon": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "on",

  // ===========================================================================
  // FASE 09) ESLINT / LINTING
  // Regras e execucao do ESLint no workspace.
  // ===========================================================================
  // Subfase 09.1) ESLint
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.debug": false,
  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.lintTask.enable": true,
  "eslint.problems.shortenToSingleLine": true,
  "eslint.quiet": false,
  "eslint.rules.customizations": [
    {
      "rule": "no-shadow",
      "severity": "warn"
    },
    {
      "rule": "no-unused-vars",
      "severity": "warn"
    },
    {
      "rule": "@typescript-eslint/no-unused-vars",
      "severity": "warn"
    },
    {
      "rule": "no-console",
      "severity": "off"
    },
    {
      "rule": "@typescript-eslint/no-floating-promises",
      "severity": "warn"
    }
  ],
  "eslint.run": "onType",
  "eslint.useESLintClass": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  // ===========================================================================
  // FASE 10) JAVASCRIPT — LANGUAGE FEATURES
  // Preferencias e inteligencia especificas de JavaScript.
  // ===========================================================================
  // Subfase 10.1) JavaScript
  "javascript.format.enable": false,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "javascript.preferences.importModuleSpecifier": "shortest",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "javascript.preferences.quoteStyle": "single",
  "javascript.referencesCodeLens.enabled": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.completeJSDocs": true,
  "javascript.suggest.enabled": true,
  "javascript.suggest.names": true,
  "javascript.suggest.paths": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.validate.enable": true,

  // ===========================================================================
  // FASE 11) JS/TS — IMPLICIT PROJECT CONFIG
  // Fallbacks de projeto implicito para arquivos soltos fora dos tsconfig.*.json.
  // ===========================================================================
  // Subfase 11.1) Projeto implicito JS/TS
  "js/ts.implicitProjectConfig.checkJs": true,
  "js/ts.implicitProjectConfig.module": "NodeNext",
  "js/ts.implicitProjectConfig.target": "ES2024",

  // ===========================================================================
  // FASE 12) TYPESCRIPT — LANGUAGE FEATURES / TSSERVER
  // Preferências de TypeScript, tsserver e diagnósticos.
  //
  // ARQUITETURA DO TSSERVER (VS Code):
  //   • useSyntaxServer "auto" → inicia syntax server imediato (hover + coloração)
  //     e promove ao semantic server completo em seguida (diagnósticos + navegação).
  //     ⚠️  "always" desabilita TODO o servidor semântico — sem erros, sem go-to-def.
  //   • nodePath "node" → tsserver usa o Node.js 24 do sistema (não o Electron interno).
  //     Garante alinhamento com o runtime ESM do projeto.
  //   • maxTsServerMemory 6144 → 6 GB para o heap do servidor TS. Cobre repositórios
  //     grandes com multi-lane (tsconfig.node + tools + browser + strict).
  //   • watchOptions "useFsEvents" → inotify nativo (ext4 bind-mount). Sem polling.
  //     excludeDirectories reduz watches em ~60% (node_modules + cache + logs etc.).
  // ===========================================================================
  // Subfase 12.1) TypeScript
  "typescript.disableAutomaticTypeAcquisition": false,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.implementationsCodeLens.showOnAllClassMethods": true,
  "typescript.implementationsCodeLens.showOnInterfaceMethods": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.useLabelDetailsInCompletionEntries": true,
  "typescript.referencesCodeLens.enabled": true,
  "typescript.referencesCodeLens.showOnAllFunctions": true,
  "typescript.reportStyleChecksAsWarnings": true,
  "typescript.suggest.autoImports": true,
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.surveys.enabled": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.tsserver.enableTracing": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.tsserver.log": "off",
  "typescript.tsserver.maxTsServerMemory": 6144,
  // "auto" = syntax server imediato + semantic server completo em paralelo (correto).
  // "always" desabilita o semantic server — NUNCA usar em projeto com checkJs/strict.
  "typescript.tsserver.nodePath": "node",
  "typescript.tsserver.useSyntaxServer": "auto",
  "typescript.tsserver.watchOptions": {
    "fallbackPolling": "dynamicPriorityPolling",
    "watchDirectory": "useFsEvents",
    "watchFile": "useFsEvents",
    // Exclui diretórios pesados do file watcher do tsserver (reduz inotify watches ~60%).
    // node_modules é excluído por maxNodeModuleJsDepth=0 no tsconfig, mas o watcher
    // precisa ser configurado separadamente.
    "excludeDirectories": [
      "**/node_modules",
      "**/.cache",
      "**/logs",
      "**/dist",
      "**/build",
      "**/backups",
      "**/respostas",
      "**/profile",
      "**/artifacts",
      "**/monitoring",
      "**/tmp",
      "**/.git"
    ]
  },
  "typescript.workspaceSymbols.scope": "allOpenProjects",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.validate.enable": true,
  // Subfase 12.2) Python analysis complementar
  "python.analysis.aiHoverSummaries": true,

  // ===========================================================================
  // FASE 13) JSON — FORMAT / VALIDATE / SCHEMAS
  // Validacao e schemas para arquivos JSON e JSONC.
  // ===========================================================================
  // Subfase 13.1) JSON
  "json.format.enable": false,
  "json.maxItemsComputed": 10000,
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [
        "package.json"
      ],
      "url": "https://json.schemastore.org/package"
    },
    {
      "fileMatch": [
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "url": "https://json.schemastore.org/tsconfig"
    },
    {
      "fileMatch": [
        "jsconfig.json"
      ],
      "url": "https://json.schemastore.org/jsconfig"
    },
    {
      "fileMatch": [
        ".eslintrc",
        ".eslintrc.json"
      ],
      "url": "https://json.schemastore.org/eslintrc"
    },
    {
      "fileMatch": [
        ".prettierrc",
        ".prettierrc.json"
      ],
      "url": "https://json.schemastore.org/prettierrc"
    },
    {
      "fileMatch": [
        ".vscode/settings.json"
      ],
      "url": "https://json.schemastore.org/vscode-settings"
    },
    {
      "fileMatch": [
        ".vscode/extensions.json"
      ],
      "url": "https://json.schemastore.org/vscode-extensions"
    },
    {
      "fileMatch": [
        ".vscode/launch.json"
      ],
      "url": "https://json.schemastore.org/launch"
    },
    {
      "fileMatch": [
        ".vscode/tasks.json"
      ],
      "url": "https://json.schemastore.org/tasks"
    },
    {
      "fileMatch": [
        ".devcontainer/devcontainer.json"
      ],
      "url": "https://json.schemastore.org/devcontainer"
    },
    {
      "fileMatch": [
        "docker-compose.json",
        "docker-compose.*.json"
      ],
      "url": "https://json.schemastore.org/docker-compose"
    },
    {
      "fileMatch": [
        ".github/dependabot.yml"
      ],
      "url": "https://json.schemastore.org/dependabot-2.0"
    },
    {
      "fileMatch": [
        "nodemon.json"
      ],
      "url": "https://json.schemastore.org/nodemon"
    },
    {
      "fileMatch": [
        "lerna.json"
      ],
      "url": "https://json.schemastore.org/lerna"
    },
    {
      "fileMatch": [
        "turbo.json"
      ],
      "url": "https://json.schemastore.org/turbo"
    },
    {
      "fileMatch": [
        "biome.json",
        "biome.jsonc"
      ],
      "url": "https://json.schemastore.org/biome"
    },
    {
      "fileMatch": [
        ".vscode/mcp.json"
      ],
      "schema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "json.trace.server": "messages",
  "json.validate.enable": true,

  // ===========================================================================
  // FASE 14) DEV CONTAINERS / REMOTE / SSH / PORTAS
  // Contrato do ambiente remoto, DevContainer e forwarding.
  // ===========================================================================
  // Subfase 14.1) Dev Containers
  "dev.containers.defaultExtensions": [],
  "dev.containers.executeInWSL": true,
  "dev.containers.gpuAvailability": "none",
  // Subfase 14.2) Remote / SSH
  "remote.autoForwardPorts": false,
  "remote.portsAttributes": {
    "9224": {
      "label": "Chrome Proxy Service (DO NOT FORWARD)",
      "onAutoForward": "ignore"
    }
  },
  "remote.restoreForwardedPorts": false,
  "remote.SSH.defaultForwardedPorts": [],
  "remote.SSH.enableAgentForwarding": true,
  "remote.SSH.loglevel": "info",
  "remote.SSH.useLocalServer": true,
  // =========================================================================
  // RESILIÊNCIA DE CONEXÃO VS CODE REMOTE (v5.5 — Session Robustness)
  // =========================================================================
  // Explicitamente desabilita reconnect automático após desconexão.
  // Motivo: reconnect automático gera novo session_id sem disparar sessionStart
  // no hooks system — causando 395 mismatch events observados em auditoria.
  // Ao desabilitar, o VS Code exibe diálogo de reconexão manual, permitindo
  // que o usuário force um ciclo limpo de sessionStart quando necessário.
  // Tradeoff: reconnects manuais, mas hooks sempre inicializados corretamente.
  // Referência: DOCUMENTAÇÃO/HOOKS/ANALISE-SESSOES-ABRUPTAS.md §3.2
  "remote.connectionTimeout": 30,
  // Previne atualizações automáticas de extensões durante sessões ativas
  // (evita incompatibilidade de API proposals como chatParticipantPrivate)
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,

  // ===========================================================================
  // FASE 15) SEARCH / FILESYSTEM UX
  // Busca, filtros e higiene visual de arquivos.
  // ===========================================================================
  // Subfase 15.1) Exclusoes e busca
  "files.exclude": {
    "**/.venv": true,
    "**/.codex/auth.json": true,
    "**/.codex/models_cache.json": true,
    "**/.codex/sessions": true,
    "**/.codex/shell_snapshots": true,
    "**/.codex/state_*.sqlite": true,
    "**/.codex/state_*.sqlite-shm": true,
    "**/.codex/state_*.sqlite-wal": true,
    "**/.codex/tmp": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.git": true,
    "**/.venv": true,
    "**/.codex/auth.json": true,
    "**/.codex/models_cache.json": true,
    "**/.codex/sessions": true,
    "**/.codex/shell_snapshots": true,
    "**/.codex/state_*.sqlite": true,
    "**/.codex/state_*.sqlite-shm": true,
    "**/.codex/state_*.sqlite-wal": true,
    "**/.codex/tmp": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
    // Dirs de runtime: log/queue/output files — jamais úteis em Ctrl+Shift+F
    "**/logs": true,
    "**/fila": true,
    "**/respostas": true,
    "**/backups": true,
    "**/tmp": true,
    "**/.github/hooks/state": true
  },
  "search.followSymlinks": false,
  "search.location": "panel",
  "search.maxResults": 50000,
  "search.quickOpen.includeSymbols": true,
  "search.searchEditor.defaultNumberOfContextLines": 3,
  "search.searchOnType": true,
  "search.searchOnTypeDebouncePeriod": 300,
  "search.searchView.keywordSuggestions": true,
  "search.searchView.semanticSearchBehavior": "automatic",
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "workbench.settings.showAISearchToggle": true,

  // ===========================================================================
  // FASE 16) SCM / GIT / PULL REQUESTS
  // Fluxo de controle de versao, PRs e integracao com GitHub.
  // ===========================================================================
  // Subfase 16.1) SCM e Git
  "git.autofetch": false,
  "git.branchProtection": [
    "main",
