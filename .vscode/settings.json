  // FASE 19) IA / CHAT / COPILOT / MCP / INLINE CHAT / EXTENSÕES
  // ===========================================================================
  "chat.agent.enabled": true,
  "chat.agent.maxRequests": 250,
  "chat.agent.thinking.collapsedTools": "always",
