{
  // ============================================================
  // 0. IDENTIDADE GLOBAL E TOOLCHAIN BASE
  // ============================================================
  "typescript.tsdk": "node_modules/typescript/lib",
  // ============================================================
  // 1. SEGURANÇA, ESTADO E INTEGRIDADE
  // ============================================================
  "files.hotExit": "onExitAndWindowClose",
  "files.restoreUndoStack": true,
  "files.refactoring.autoSave": true,
  "remote.SSH.enableAgentForwarding": true,
  "remote.SSH.useLocalServer": true,
  "remote.SSH.loglevel": "info",
  // ============================================================
  // 2. DEV CONTAINERS / REMOTE
  // ============================================================
  "dev.containers.defaultExtensions": [],
  "dev.containers.executeInWSL": false,
  "dev.containers.gpuAvailability": "none",
  "remote.autoForwardPorts": false,
  "remote.restoreForwardedPorts": false,
  "remote.portsAttributes": {
    "9224": {
      "label": "Chrome Proxy Service (DO NOT FORWARD)",
      "onAutoForward": "ignore"
    }
  },
  // ============================================================
  // 3. EDITOR — FUNDAMENTOS E UX CENTRAL
  // ============================================================
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,
  "editor.wrappingIndent": "indent",
  "editor.rulers": [
    100,
    120
  ],
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.mouseWheelZoom": true,
  "editor.fontLigatures": true,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,
  "editor.renderLineHighlight": "all",
  "editor.matchBrackets": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.largeFileOptimizations": true,
  // ============================================================
  // 4. EDITOR — NAVEGAÇÃO, FOLDING, OUTLINE
  // ============================================================
  "editor.folding": true,
  "editor.foldingStrategy": "auto",
  "editor.foldingHighlight": true,
  "editor.showFoldingControls": "always",
  "editor.foldingMaximumRegions": 5000,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.showUnused": false,
  "editor.showDeprecated": false,
  "breadcrumbs.enabled": false,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "on",
  "outline.showFiles": true,
  "outline.showModules": false,
  "outline.showFunctions": true,
  "outline.showVariables": false,
  // ============================================================
  // 5. EDITOR — MINIMAP, STICKY SCROLL, SEMANTIC
  // ============================================================
  "editor.minimap.enabled": false,
  "editor.minimap.maxColumn": 120,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.stickyScroll.defaultModel": "outlineModel",
  "editor.linkedEditing": true,
  "editor.semanticHighlighting.enabled": "configuredByTheme",
  "editor.semanticTokenColorCustomizations": {
    "enabled": true
  },
  // ============================================================
  // 6. SUGGESTIONS, INLINE, INTELLISENSE
  // ============================================================
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.quickSuggestionsDelay": 50,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.suggest.preview": false,
  "editor.suggest.showInlineDetails": false,
  "editor.suggest.showSnippets": true,
  "editor.snippetSuggestions": "top",
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.selectionMode": "always",
  "editor.suggest.filterGraceful": true,
  "editor.suggest.matchOnWordStartOnly": false,
  "editor.suggest.showStatusBar": true,
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "offWithInlineSuggestions",
  "editor.wordBasedSuggestionsMode": "currentDocument",
  // ============================================================
  // 7. LINGUAGENS — JAVASCRIPT / TYPESCRIPT / JSON
  // (LIMPO: duplicações removidas + contradições eliminadas)
  // ============================================================

  // ============================================================
  // 7.1 JAVASCRIPT — Validação / Formatação
  // ============================================================
  "javascript.validate.enable": true,
  "javascript.format.enable": false,

  // ============================================================
  // 7.2 JAVASCRIPT — Sugestões / IntelliSense
  // ============================================================
  "javascript.suggest.enabled": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.completeJSDocs": true,
  "javascript.suggest.names": true,
  "javascript.suggest.paths": true,

  // ============================================================
  // 7.3 JAVASCRIPT — Imports / Movimentação de Arquivos
  // ============================================================
  "javascript.updateImportsOnFileMove.enabled": "always",

  // ============================================================
  // 7.4 JAVASCRIPT — Preferências de Estilo / Imports (ESM)
  // ============================================================
  "javascript.preferences.quoteStyle": "single",
  "javascript.preferences.importModuleSpecifier": "relative",
  "javascript.preferences.importModuleSpecifierEnding": "js",

  // ============================================================
  // 7.5 JAVASCRIPT — Inlay Hints
  // ============================================================
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.inlayHints.variableTypes.enabled": false,

  // ============================================================
  // 7.6 TYPESCRIPT — Validação / Aquisição Automática
  // ============================================================
  "typescript.validate.enable": true,
  "typescript.disableAutomaticTypeAcquisition": true,

  // ============================================================
  // 7.7 TYPESCRIPT — TS Server (Performance / Watchers)
  // ============================================================
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.useSeparateSyntaxServer": true,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling"
  },

  // ============================================================
  // 7.8 TYPESCRIPT — TS Server (Experimental)
  // ============================================================
  // enableProjectDiagnostics: Analisa TODO o projeto (não só arquivos abertos)
  // ✅ HABILITADO: Agora que dashboard-ui e node_modules estão excluídos,
  //    deve mostrar apenas erros reais sem ruído.
  // ⚠️  Se VSCode ficar lento ou mostrar muitos erros, mude para false.
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.tsserver.experimental.useVsCodeWatcher": true,

  // ============================================================
  // 7.9 TYPESCRIPT — Preferências de Imports / ESM
  // ============================================================
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ============================================================
  // 7.10 TYPESCRIPT — Diagnósticos / Estilo
  // ============================================================
  "typescript.reportStyleChecksAsWarnings": false,

  // ============================================================
  // 7.11 TYPESCRIPT — Inlay Hints
  // ============================================================
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": false,

  // ============================================================
  // 7.12 JS/TS — Implicit Project Config (quando não há jsconfig/tsconfig)
  // ============================================================
  "js/ts.implicitProjectConfig.checkJs": true,
  "js/ts.implicitProjectConfig.module": "NodeNext",

  // ============================================================
// 7.13 JSON — Formatação / Validação / Schemas
// ============================================================
"json.format.enable": true,
"json.validate.enable": true,

// Autocomplete inteligente
"json.suggest.enable": true,

// Schemas
"json.schemaDownload.enable": true,
"json.schemas": [
  // Node / TypeScript / JS tooling
  {
    "fileMatch": ["package.json"],
    "url": "https://json.schemastore.org/package"
  },
  {
    "fileMatch": ["tsconfig.json", "tsconfig.*.json"],
    "url": "https://json.schemastore.org/tsconfig"
  },
  {
    "fileMatch": ["jsconfig.json"],
    "url": "https://json.schemastore.org/jsconfig"
  },
  {
    "fileMatch": [".eslintrc", ".eslintrc.json"],
    "url": "https://json.schemastore.org/eslintrc"
  },
  {
    "fileMatch": [".prettierrc", ".prettierrc.json"],
    "url": "https://json.schemastore.org/prettierrc"
  },

  // VS Code / DevContainer
  {
    "fileMatch": [".vscode/settings.json"],
    "url": "https://json.schemastore.org/vscode-settings"
  },
  {
    "fileMatch": [".vscode/extensions.json"],
    "url": "https://json.schemastore.org/vscode-extensions"
  },
  {
    "fileMatch": [".vscode/launch.json"],
    "url": "https://json.schemastore.org/launch"
  },
  {
    "fileMatch": [".vscode/tasks.json"],
    "url": "https://json.schemastore.org/tasks"
  },
  {
    "fileMatch": [".devcontainer/devcontainer.json"],
    "url": "https://json.schemastore.org/devcontainer"
  },

  // Docker (somente se você realmente usar docker-compose.json)
  {
    "fileMatch": ["docker-compose.json", "docker-compose.*.json"],
    "url": "https://json.schemastore.org/docker-compose"
  },

  // GitHub
  {
    "fileMatch": [".github/dependabot.yml"],
    "url": "https://json.schemastore.org/dependabot-2.0"
  },

  // Common configs
  {
    "fileMatch": ["nodemon.json"],
    "url": "https://json.schemastore.org/nodemon"
  },
  {
    "fileMatch": ["lerna.json"],
    "url": "https://json.schemastore.org/lerna"
  },
  {
    "fileMatch": ["turbo.json"],
    "url": "https://json.schemastore.org/turbo"
  },
  {
    "fileMatch": ["biome.json", "biome.jsonc"],
    "url": "https://json.schemastore.org/biome"
  }
],

// Performance / Debug
"json.maxItemsComputed": 10000,
"json.trace.server": "off",


  // ============================================================
  // 7.14 EDITOR — CodeLens (global)
  // ============================================================
  "editor.codeLens": false,

  // ============================================================
  // 7.15 TYPESCRIPT — Logging / Tracing (Debug)
  // ============================================================
  // 🔍 MODO DEBUG: Logs verbosos para diagnosticar todos os problemas
  "typescript.tsserver.enableTracing": true,
  "typescript.tsserver.log": "verbose",

  // ============================================================
  // 8. FORMATTERS POR LINGUAGEM
  // ============================================================
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  // ============================================================
  // 9. ESLINT / LINTING
  // ============================================================
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.run": "onSave",
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.alwaysShowStatus": false,
  "eslint.quiet": false,
  "eslint.debug": false,
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.problems.shortenToSingleLine": true,
  "eslint.showOutputChannelOn": "onError",
  "eslint.useESLintClass": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.rules.customizations": [
    {
      "rule": "no-shadow",
      "severity": "warn"
    },
    {
      "rule": "no-unused-vars",
      "severity": "warn"
    },
    {
      "rule": "no-console",
      "severity": "off"
    }
  ],
  // ============================================================
  // 10. TERMINAL INTEGRADO
  // ============================================================
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontFamily": "monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.persistentSessionReviveProcess": "onExit",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.shellIntegration.history": 1000,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.hideCondition": "never",
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.confirmOnKill": "editor",
  // ============================================================
  // 11. GIT / SCM / DIFF
  // ============================================================
  "git.enableSmartCommit": true,
  "git.ignoreLimitWarning": true,
  "git.autofetch": false,
  "git.confirmSync": false,
  "git.fetchOnPull": true,
  "git.pruneOnFetch": true,
  "git.followTagsWhenSync": true,
  "git.showProgress": true,
  "git.untrackedChanges": "separate",
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "always",
  "git.timeline.showUncommitted": true,
  "git.branchProtection": [
    "main",
    "master"
  ],
  "scm.defaultViewMode": "tree",
  "scm.diffDecorations": "all",
  "scm.diffDecorationsGutterWidth": 3,
  "scm.alwaysShowProviders": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.renderMarginRevertIcon": true,
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.wordWrap": "on",
  "diffEditor.maxComputationTime": 5000,
  "diffEditor.renderIndicators": true,
  "diffEditor.ignoreTrimWhitespace": true,
  // ============================================================
  // 12. PROBLEMS / DEBUG / TASKS / TESTING
  // ============================================================
  "problems.autoReveal": true,
  "problems.decorations.enabled": true,
  "problems.showCurrentInStatus": true,
  "problems.sortOrder": "severity",
  "problems.defaultViewMode": "tree",
  "problems.visibility": true,
  "problems.maxNumberOfProblems": 10000,
  "problems.resultsPanelMinWidth": 300,
  "problems.tabSize": 10,
  "problems.multiline.enabled": true,
  "problems.multiline.indentSize": 4,
  "debug.inlineValues": "on",
  "debug.focusEditorOnBreak": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.showInlineBreakpointCandidates": true,
  "debug.toolBarLocation": "docked",
  "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
  "testing.automaticallyOpenTestResults": "neverOpen",
  "testing.openTesting": "neverOpen",
  "testing.saveBeforeTest": true,
  "testing.followRunningTest": true,
  "testing.alwaysRevealTestOnStateChange": false,
  "task.autoDetect": "on",
  "task.problemMatchers.neverPrompt": false,
  "task.slowProviderWarning": true,
  "task.quickOpen.detail": true,
  "task.quickOpen.skip": false,
  // ============================================================
  // 13. SEARCH / FILESYSTEM / EXPLORER
  // ============================================================
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "files.associations": { /* intact */},
  "files.watcherExclude": { /* intact */},
  "search.exclude": { /* intact */},
  "search.smartCase": true,
  "search.searchOnType": true,
  "search.searchOnTypeDebouncePeriod": 300,
  "search.globalFindClipboard": true,
  "files.simpleDialog.enable": true,
  "files.saveConflictResolution": "overwriteFileOnDisk",

  // ============================================================
  // 14. IA / COPILOT / MCP
  // ============================================================
  "github.copilot.enable": {
    "*": true,
    "javascript": true,
    "json": true,
    "markdown": true,
    "plaintext": false
  },
  "github.copilot.inlineSuggest.enable": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.localeOverride": "pt-br",
  "github.copilot.chat.welcomeMessage": "once",
  "github.copilot.advanced": { /* intact */},
  "chat.mcp.serverSampling": { /* intact */},
  "claudeCodeChat.permissions.yoloMode": false,
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.preview": false,
    "editor.suggest.showInlineDetails": false
  },
  // ============================================================
  // 15. WORKBENCH / WINDOW / TELEMETRIA
  // ============================================================
"workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.closeEmptyGroups": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 15,
  "workbench.editor.limit.perEditorGroup": true,
  "window.restoreWindows": "none",
  "window.newWindowDimensions": "default",
  "window.titleBarStyle": "custom",
  "window.openFoldersInNewWindow": "off",
  "window.openFilesInNewWindow": "off",
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
"cSpell.language": "en,pt-BR",
"inlineChat.notebookAgent": false,
"inlineChat.enableV2": true,
"chat.mcp.gallery.enabled": true,
"chat.edits2.enabled": true,
"chat.editing.autoAcceptDelay": 3,
"chat.customAgentInSubagent.enabled": true,
"chat.checkpoints.showFileChanges": true,
"chat.agent.maxRequests": 250,
"[powershell]": {
  "files.encoding": "utf8bom"
},
"chat.renderRelatedFiles": true,
"chat.useAgentSkills": true,
"chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
"chat.tools.terminal.autoReplyToPrompts": true,
"github.copilot.chat.anthropic.thinking.budgetTokens": 32000,
"github.copilot.chat.anthropic.tools.websearch.enabled": true,
"github.copilot.chat.codesearch.enabled": true,
"github.copilot.chat.customAgents.showOrganizationAndEnterpriseAgents": true,
"github.copilot.chat.githubMcpServer.enabled": true,
"github.copilot.chat.generateTests.codeLens": true,
"github.copilot.chat.languageContext.fix.typescript.enabled": true,
"github.copilot.chat.languageContext.inline.typescript.enabled": true,
"github.copilot.chat.languageContext.typescript.enabled": true,
"github.copilot.chat.languageContext.typescript.includeDocumentation": true,
"github.copilot.chat.newWorkspace.useContext7": true,
"github.copilot.chat.responsesApiReasoningEffort": "high",
"github.copilot.chat.tools.memory.enabled": true,
"github.copilot.chat.virtualTools.threshold": 128,
"github.copilot.selectedCompletionModel": "Gpt-5 mini",
"githubIssues.assignWhenWorking": true,
"[css]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
},
"[vue]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
},
"claudeCode.allowDangerouslySkipPermissions": true,
"workbench.editor.alwaysShowEditorActions": true,
"workbench.editor.closeOnFileDelete": true,
"workbench.editor.enablePreviewFromCodeNavigation": true,
"workbench.editor.enablePreviewFromQuickOpen": true,
"chat.agentSessionProjection.enabled": true,
"chat.editMode.hidden": false,
"chat.editing.explainChanges.enabled": true,
"chat.editor.wordWrap": "on",
"chat.experimental.useSkillAdherencePrompt": true,
"chat.includeReferencedInstructions": true,
"chat.mcp.assisted.nuget.enabled": true,
"chat.tips.enabled": true,
"chat.tools.terminal.sandbox.enabled": false,
"terminal.integrated.shellIntegration.environmentReporting": true,
"windowsaistudio.enableRemoteFine-tuningAndInference": true,
"editor.autoIndentOnPaste": true,
"editor.occurrencesHighlightDelay": 100,
"workbench.externalBrowser": "chrome",
"windowsaistudio.openAIInferencePort": 11434,
"cSpell.enabled": false,
"github.copilot.chat.agent.autoFix": true,
"github.copilot.chat.anthropic.tools.websearch.maxUses": 10,
"github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,
"github.copilot.chat.copilotMemory.enabled": true,
"github.copilot.chat.languageContext.typescript.cacheTimeout": 800,
"github.copilot.chat.switchAgent.enabled": true,
"remote.SSH.defaultForwardedPorts": [

],
}
