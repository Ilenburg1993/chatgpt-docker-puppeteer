# =============================================================================
# .gitattributes — Canonical Git attributes for WSL2 / DevContainer / Windows
# Version: 2.5
#
# Goal:
#   Keep executable/devcontainer-critical files LF-only across Windows, WSL2,
#   Linux containers and CI, while protecting real binary artifacts from Git EOL
#   normalization and diff heuristics.
#
# Notes:
#   - Git attributes are repository policy and override contributor-local
#     core.autocrlf behavior for matching paths.
#   - `eol=lf` controls line endings, not text encoding or BOM.
#   - BOM/encoding policy should be enforced by editorconfig, hooks or CI.
#   - After changing this file, run:
#       git add --renormalize .
# =============================================================================

# -----------------------------------------------------------------------------
# Baseline
# -----------------------------------------------------------------------------
# Let Git classify files, normalize text to LF in the index, and leave binary
# content untouched. More specific rules below make critical paths explicit.
* text=auto eol=lf

# -----------------------------------------------------------------------------
# DevContainer / Docker / runtime-critical files
# -----------------------------------------------------------------------------
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
compose*.yml text eol=lf
compose*.yaml text eol=lf

.devcontainer/*.sh text eol=lf
.devcontainer/**/*.sh text eol=lf
.devcontainer/nss-gatekeeper.sh text eol=lf
.devcontainer/scripts/*.sh text eol=lf
.devcontainer/scripts/**/*.sh text eol=lf
.devcontainer/*.json text eol=lf
.devcontainer/*.jsonc text eol=lf
.devcontainer/** text eol=lf

# -----------------------------------------------------------------------------
# Shells / executable scripts — LF mandatory
# -----------------------------------------------------------------------------
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ksh text eol=lf
*.awk text eol=lf
*.sed text eol=lf
*.envrc text eol=lf

# PowerShell.
# Canonical project shell is bash, but PowerShell is instrumental in this repo.
# PowerShell 7+ handles UTF-8/LF well; BOM policy is intentionally not expressed
# here because .gitattributes line-ending policy does not control BOM.
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# -----------------------------------------------------------------------------
# Windows command scripts — CRLF mandatory
# -----------------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf

