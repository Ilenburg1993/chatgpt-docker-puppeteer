{
  "$schema": "https://json.schemastore.org/jsconfig",

  "compilerOptions": {
    // ============================================================
    // [A] PLATAFORMA E MÓDULOS — Node.js 20+ (CommonJS)
    // ============================================================
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2024"
    ],

    // ============================================================
    // [B] JAVASCRIPT PURO (SEM TYPESCRIPT)
    // ============================================================
    "allowJs": true,

    // ATIVE se você quer maximizar diagnóstico e IntelliSense:
    "checkJs": true,
    // Mantém JS dinâmico permissivo
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,

    // ============================================================
    // [C] INTEROPERABILIDADE E COMPATIBILIDADE
    // ============================================================
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // ============================================================
    // [D] INTELLISENSE / ALIASES DE CAMINHO
    // ============================================================
    "baseUrl": ".",
    "paths": {
      "#/*": ["src/*"],
      "#core/*": ["src/core/*"],
      "#shared/*": ["src/shared/*"],
      "#nerv/*": ["src/nerv/*"],
      "#kernel/*": ["src/kernel/*"],
      "#driver/*": ["src/driver/*"],
      "#infra/*": ["src/infra/*"],
      "#server/*": ["src/server/*"],
      "#logic/*": [
        "src/logic/*"
      ],
      "#orchestrator/*": [
        "src/orchestrator/*"
      ],
      "#missions/*": [
        "src/missions/*"
      ],
      "#validation/*": [
        "src/validation/*"
      ]
    },

    // ============================================================
    // [E] TIPOS (APENAS NODE)
    // ============================================================
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],

    // ============================================================
    // [F] QUALIDADE (diagnósticos úteis sem "punição" excessiva)
    // ============================================================
    "skipLibCheck": true,

    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,

    // Mantidos permissivos por design
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // ============================================================
    // [G] PERFORMANCE DO LANGUAGE SERVICE
    // ============================================================
    "disableSizeLimit": false,
    "assumeChangesOnlyAffectDirectDependencies": true
  },

  // ==============================================================
  // [H] ESCOPO DO PROJETO — ARQUIVOS MONITORADOS
  // ==============================================================
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",

    "*.js",
    "*.mjs",
    "*.cjs",

    "ecosystem.config.js",
    ".puppeteerrc.cjs",
    "eslint.config.mjs"
  ],

  // ==============================================================
  // [I] EXCLUSÕES — ARTEFATOS, DADOS E RUÍDO
  // ==============================================================
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "logs",
    "fila",
    "respostas",
    "profile",
    "public",
    "backups",
    "monitoring",
    "tmp",
    "analysis",
    "local-login",
    "DOCUMENTAÇÃO",

    ".git",

    ".tmp.drivedownload",
    ".tmp.driveupload",

    "**/node_modules/**",
    "**/.tmp.*/**",
    "**/.*",

    "**/*.min.js",
    "**/*.map",
    "**/bundle.js",
    "**/*.bundle.js"
  ]
}
