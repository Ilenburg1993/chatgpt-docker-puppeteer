{
  "$schema": "https://json.schemastore.org/jsconfig",
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "tools/**/*",
    "*.config.js",
    "*.config.mjs",
    "*.config.cjs",
    "ecosystem.config.js",
    ".puppeteerrc.cjs",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "logs",
    "fila",
    "respostas",
    "artifacts",
    "profile",
    "public",
    "backups",
    "monitoring",
    "tmp",
    "analysis",
    "local-login",
    "DOCUMENTAÇÃO",
    "src/dashboard-ui/**",
    ".git",
    "**/node_modules/**",
    "**/*.min.js",
    "**/*.map",
    "**/bundle.js",
    "**/*.bundle.js",
    "**/*.d.ts.map",
    "**/*.js.map"
  ]
}
