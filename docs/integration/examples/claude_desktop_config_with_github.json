{
  "mcpServers": {
    "chatgpt-docker": {
      "url": "http://localhost:3008/api/mcp",
      "transport": "http"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_YOUR_TOKEN_HERE"
      }
    }
  }
}
