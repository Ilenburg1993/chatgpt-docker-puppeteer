      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [
        "status=ok requires network_status=ok or diagnostics_status not fatal",
        "local_dns_cache_status=ok requires local_dns_cache_local_probe_status=ok|proven|true when DNS is default-on",
        "endpoint_registry_status=ok requires canonical registry readable"
      ],
      "notes": []
    },
    "postAttach.summary": {
      "path": "/tmp/devcontainer-post-attach.summary",
      "format": "keyValueSummary",
      "producer": ".devcontainer/scripts/post-attach.sh",
