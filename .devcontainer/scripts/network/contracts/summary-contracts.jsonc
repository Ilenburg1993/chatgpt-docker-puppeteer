    },
    "copilotAdvisor.summary": {
      "path": "/tmp/devcontainer-copilot-route-advisor.summary",
      "format": "keyValueSummary",
      "producer": ".devcontainer/scripts/network/copilot-route-advisor.sh",
      "producerVersion": "v1.1.0",
      "role": "passive-route-advisor-summary",
      "statusKey": "status",
      "requiredKeys": [
        "status",
        "script_version",
        "advisor_status",
        "endpoint_registry_status",
        "lock_status",
        "github_route_status",
        "local_dns_cache_status",
        "manager_status",
        "manager_plane_overall_status",
        "manager_endpoint_registry_status",
        "report",
        "completed_at"
      ],
      "recommendedKeys": [
        "endpoints_total",
        "endpoints_current_failed",
        "endpoints_with_better_candidate",
        "recommendations"
      ],
      "optionalKeys": [],
      "acceptedStatusValues": ["ok", "advisory", "degraded", "failed", "skipped", "lock-failed", "unknown"],
      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [
        "Advisor is passive: it must never imply /etc/hosts or /etc/resolv.conf mutation",
        "endpoints_with_better_candidate > 0 is advisory, not automatic route application"
      ],
      "notes": []
    },
    "networkControlPlane.status": {
      "path": "/tmp/devcontainer-network-control-plane.status",
      "format": "singleTokenStatus",
      "producer": ".devcontainer/scripts/network-control-plane-state.sh",
      "producerVersion": "v1.1.0",
      "role": "aggregated-control-plane-status",
      "statusKey": "status",
      "requiredKeys": ["<single-token-status-line>"],
      "recommendedKeys": [],
      "optionalKeys": [],
      "acceptedStatusValues": ["ok", "advisory", "degraded", "failed", "fatal"],
      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [],
      "notes": []
    },
    "networkControlPlane.summary": {
      "path": "/tmp/devcontainer-network-control-plane.summary",
      "format": "keyValueSummary",
      "producer": ".devcontainer/scripts/network-control-plane-state.sh",
      "producerVersion": "v1.1.0",
      "role": "aggregated-control-plane-summary",
      "statusKey": "status",
      "requiredKeys": [
        "status",
        "script",
        "script_version",
        "completed_at",
        "project_root",
        "health_status",
        "post_start_status",
        "registry_status",
        "registry_file",
        "registry_rows",
        "registry_bad_rows",
        "current_resolv_nameservers",
        "current_resolv_first_nameserver",
        "current_hosts_api_github_com_ip",
        "dns_status",
        "dns_resolv_conf_drift",
        "manager_status",
        "route_status",
        "route_summary_kind",
        "route_action_status",
        "proxy_status",
        "advisor_status",
        "events_ok",
        "events_advisory",
        "events_warning",
        "events_degraded",
        "events_failed",
        "events_fatal",
        "next_actions",
        "report",
        "events",
        "json"
      ],
      "recommendedKeys": [
        "dns_local_probe_proven",
        "dns_docker_embedded_split_status",
        "dns_warmup_status",
        "manager_endpoint_registry_status",
        "manager_endpoints_ok",
        "manager_endpoints_total",
        "manager_recommendation_action",
        "manager_recommended_transport",
        "manager_next_diagnostic_actions",
        "route_selected_ip",
        "route_current_ip",
        "route_verify_status",
        "proxy_recommendation_action",
        "advisor_recommendations"
      ],
      "optionalKeys": [],
      "acceptedStatusValues": ["ok", "advisory", "degraded", "failed", "fatal"],
      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [
        "status is derived from event severities",
        "dns_resolv_conf_drift=true must make status at least degraded",
        "registry_status=ok with manager_endpoint_registry_status=invalid must make status at least degraded",
        "route_summary_kind not runtime-route with route_status starting benchmark must make status at least degraded"
      ],
      "notes": []
    }
  },
  "crossArtifactInvariants": [
    {
      "id": "dns-current-runtime-wins",
      "severity": "degraded",
      "rule": "If localDns.summary says resolv_conf_points_to_cache=true but networkControlPlane.current_resolv_first_nameserver does not match localDns.bind_address, dns_resolv_conf_drift must be true and aggregate status must be at least degraded."
    },
    {
      "id": "dns-default-on-needs-proof",
      "severity": "degraded",
      "rule": "When DNS cache is enabled/default-on, localDns.summary status=ok requires local_probe_proven=true and local_probe_status ok/proven/true. process-only proof is insufficient."
    },
    {
      "id": "route-runtime-vs-action",
      "severity": "degraded",
      "rule": "githubRoute.summary must not contain benchmark-ok/benchmarking as runtime status. Benchmark and doctor outputs belong to githubRoute.action.summary."
    },
    {
      "id": "manager-registry-consensus",
      "severity": "degraded",
      "rule": "If registry local audit is ok but manager endpoint_registry_status is invalid, aggregate status must be at least degraded and next_actions must include npm run network:manager:doctor."
    },
    {
      "id": "manager-worst-host-needs-endpoint-count",
      "severity": "degraded",
      "rule": "manager endpoints_total=0 together with current_worst_host not in [unknown, none] is invalid-contract."
    },
    {
      "id": "proxy-is-opt-in",
      "severity": "advisory",
      "rule": "Proxy status off/disabled is healthy unless DEVCONTAINER_ENABLE_LOCAL_COPILOT_PROXY=true or manager explicitly recommends manual opt-in."
    },
    {
      "id": "post-create-is-structural",
      "severity": "failed",
      "rule": "post-create artifacts must not claim runtime network health for DNS/route/proxy/manager. They may only report structural baselines, expected versions, artifacts and declared contracts."
    },
    {
      "id": "network-control-plane-aggregate-authority",
      "severity": "info",
      "rule": "When present and fresh, networkControlPlane.summary is the preferred human/machine read model over individual component summaries. Individual summaries remain sources of truth for their own component details."
    }
  ],
  "validatorProfile": {
    "name": "summary-contracts-v1",
    "recommendedCommand": "node scripts/tools/network-summary-contracts.mjs validate .devcontainer/scripts/network/contracts/summary-contracts.jsonc",
    "fallbackShellChecks": [
      "grep -R $'\\r' /tmp/devcontainer-*.summary /tmp/devcontainer-*.status 2>/dev/null must be empty",
      "awk -F= 'NF<2 && $0 !~ /^$/ { bad++ } END { exit bad?1:0 }' /tmp/devcontainer-*.summary",
      "python3 -m json.tool /tmp/devcontainer-network-control-plane.state.json"
    ],
    "validationLevels": {
      "syntax": ["JSONC parse", "no duplicate artifact ids", "no duplicate requiredKeys per artifact"],
      "contract": [
        "required files match artifact formats",
        "required keys present when artifact exists",
        "status values accepted",
        "no duplicate keys in summaries"
      ],
      "semantic": [
        "crossArtifactInvariants",
        "freshness",
        "runtime-vs-action separation",
        "no-secret key/value heuristics"
      ]
    }
  },
  "migration": {
    "from": "implicit per-script summaries",
    "to": "explicit summary-contracts.jsonc v1.0.0",
    "nextSteps": [
      "Add package scripts network:contracts:validate and network:contracts:explain.",
      "Add Makefile targets network-contracts-validate and network-contracts-explain.",
      "Teach network-control-plane-state.sh to optionally read this contract in doctor mode without requiring Node.",
      "Teach post-create.sh to audit presence of this contract but not require runtime artifacts during post-create.",
      "Later generate TypeScript validators from this JSONC contract."
    ]
  }
}
