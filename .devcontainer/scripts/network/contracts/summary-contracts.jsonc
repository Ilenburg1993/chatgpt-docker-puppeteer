// =============================================================================
// summary-contracts.jsonc — DevContainer Network/Copilot summary contracts
// Version: v1.0.0
// Generated: 2026-05-20
//
// Canonical path:
//   .devcontainer/scripts/network/contracts/summary-contracts.jsonc
//
// Purpose:
//   Declare the machine-readable contracts for /tmp/devcontainer-* status,
//   summary, action.summary, events, metrics and aggregate state artifacts.
//
// This file is JSONC for maintainers, but the object below is deliberately
// valid JSON after comment stripping. Do not put secrets here.
// =============================================================================
{
  "$schema": "https://example.invalid/devcontainer/network/summary-contracts.schema.json",
  "schemaVersion": "1.0.0",
  "name": "devcontainer-network-summary-contracts",
  "canonicalPath": ".devcontainer/scripts/network/contracts/summary-contracts.jsonc",
  "generatedAt": "2026-05-20",
  "status": "canonical-draft",
  "scope": "Contracts for key=value status/summary/action artifacts emitted by the DevContainer GitHub/Copilot network control plane.",
  "designPrinciples": [
    "Contracts are read/write agreements, not runtime probes.",
    "post-create emits structural baseline only; post-start emits runtime orchestration; post-attach emits passive UX; network-control-plane emits consolidated truth.",
    "Action/benchmark summaries are never runtime truth unless explicitly named runtime summaries.",
    "Unknown is allowed for unavailable data, but contradictions are degraded or failed.",
    "No artifact may contain secrets, tokens, Authorization headers, cookies, raw env dumps, SSH keys or PAT values.",
    "All paths are local container paths. External URLs are only allowed in endpoint registry/diagnostic reports, never as secret-bearing values."
  ],
  "common": {
    "fileFormats": {
      "singleTokenStatus": {
        "description": "One line, one token. Example: ok",
        "lineRules": ["LF line endings", "no CRLF", "no ANSI color", "no spaces before/after token", "max 128 bytes"]
      },
      "keyValueStatus": {
        "description": "Small key=value status file. Usually includes status and script_version.",
        "lineRules": [
          "LF line endings",
          "blank lines allowed but discouraged",
          "comments are not allowed in runtime output",
          "keys are unique"
        ]
      },
      "keyValueSummary": {
        "description": "Machine-readable key=value summary. Values are single-line strings.",
        "lineRules": [
          "LF line endings",
          "key=value per line",
          "key names: ^[a-z][a-z0-9_]*$",
          "no duplicate keys",
          "no control characters",
          "no raw multiline values",
          "max line length 8192 bytes"
        ]
      },
      "eventsTsv": {
        "description": "Event stream TSV with header. Preferred header: timestamp<TAB>severity<TAB>component<TAB>code<TAB>message, or epoch<TAB>event<TAB>details for legacy post-create.",
        "lineRules": [
          "LF line endings",
          "tab separated",
          "header required",
          "messages one-line sanitized",
          "no secrets"
        ]
      },
      "metricsTsv": {
        "description": "Metrics TSV. Header required; no secrets; numeric columns must use decimal strings or unknown."
      },
      "jsonState": {
        "description": "JSON object generated from summaries/events; must parse with JSON.parse and must not contain comments."
      }
    },
    "statusValues": {
      "healthy": ["ok", "ready-ok", "running", "present", "fresh", "valid", "recorded", "complete"],
      "neutral": [
        "off",
        "disabled",
        "skipped",
        "not-run",
        "not-attempted",
        "not-needed",
        "missing-optional",
        "unknown",
        "observe"
      ],
      "advisory": ["advisory", "warning", "present-stale", "legacy", "inconsistent", "lock-timeout"],
      "degraded": [
        "degraded",
        "ready-degraded",
        "stale",
        "unhealthy",
        "failed-soft",
        "partial",
        "summary-missing",
        "drift",
        "invalid"
      ],
      "failed": ["failed", "fatal", "lock-failed", "missing", "unreadable", "invalid-contract"]
    },
    "severityOrder": ["ok", "info", "advisory", "warning", "degraded", "failed", "fatal"],
    "fallbackValues": ["unknown", "none", "not-run", "not-attempted", "skipped", "unavailable"],
    "fieldTypes": {
      "status": {
        "type": "enumToken",
        "values": "common.statusValues.*",
        "requiredByDefault": true
      },
      "summary_kind": {
        "type": "token",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "script_version": {
        "type": "versionOrToken",
        "pattern": "^(v?[0-9]+(\\.[0-9]+){1,3}|[a-z0-9._-]+-[vV]?[0-9]+(\\.[0-9]+){1,3}|unknown|missing)$"
      },
      "completed_at": {
        "type": "timestamp",
        "formats": ["rfc3339-ish", "unknown"]
      },
      "created_at": {
        "type": "timestamp",
        "formats": ["rfc3339-ish", "unknown"]
      },
      "report": {
        "type": "pathOrUnknown"
      },
      "events": {
        "type": "pathOrUnknown"
      },
      "json": {
        "type": "pathOrUnknown"
      },
      "enabled": {
        "type": "booleanString"
      },
      "rows": {
        "type": "uintString"
      },
      "bad": {
        "type": "uintString"
      },
      "*_status": {
        "type": "statusToken"
      },
      "*_file": {
        "type": "pathOrUnknown"
      },
      "*_path": {
        "type": "pathOrUnknown"
      },
      "*_rows": {
        "type": "uintString"
      },
      "*_bad_rows": {
        "type": "uintString"
      },
      "*_count": {
        "type": "uintString"
      },
      "*_total": {
        "type": "uintString"
      },
      "*_ok": {
        "type": "uintString"
      },
      "*_ms": {
        "type": "numberOrUnknown"
      },
      "*_seconds": {
        "type": "uintString"
      },
      "*_epoch": {
        "type": "uintStringOrZero"
      },
      "*_sha256": {
        "type": "sha256OrUnknown"
      },
      "*_ip": {
        "type": "ipOrUnknownOrNone"
      },
      "*_host": {
        "type": "hostnameOrUnknown"
      },
      "*_url": {
        "type": "httpsUrlOrUnknown"
      },
      "*_actions": {
        "type": "csvTokensOrNone"
      },
      "*_recommendations": {
        "type": "csvTokensOrNone"
      }
    },
    "securityRules": [
      "Never write token, password, secret, Authorization, Cookie, Set-Cookie, GH_TOKEN, GITHUB_TOKEN, PAT, SSH key or private URL query credentials.",
      "If a value may contain a secret, emit redacted or omitted instead.",
      "Avoid raw environment dumps; summaries should contain derived statuses, paths, versions and counts only.",
      "Reports may be more verbose, but control-plane summaries must stay safe for copy/paste into issues."
    ],
    "freshness": {
      "defaultMaxAgeSeconds": 86400,
      "staleArtifactPolicy": "stale artifacts are advisory unless they contradict current runtime facts; contradictions are degraded",
      "currentRuntimeFacts": ["/etc/resolv.conf", "/etc/hosts", "process state read by component-specific scripts"]
    }
  },
  "artifacts": {
    "postCreate.status": {
      "path": "/tmp/devcontainer-post-create.status",
      "format": "keyValueStatus",
      "producer": ".devcontainer/scripts/post-create.sh",
      "producerVersion": "v1.2.2",
      "role": "structural-gate-status",
      "statusKey": "status",
      "requiredKeys": ["status", "script_version", "script_audit_status", "endpoint_registry_status", "created_at"],
      "recommendedKeys": ["package_json_status", "makefile_status", "toolchain_contract_status"],
      "optionalKeys": [],
      "acceptedStatusValues": ["ready-ok", "ready-degraded", "failed", "fatal"],
      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [
        "status=ready-ok only when script_audit_status=OK and endpoint_registry_status=ok and package/make/devcontainer/dockerfile statuses are ok",
        "created_at must be a single-line timestamp; no secrets"
      ],
      "notes": []
    },
    "postCreate.summary": {
      "path": "/tmp/devcontainer-post-create.summary",
      "format": "keyValueSummary",
      "producer": ".devcontainer/scripts/post-create.sh",
      "producerVersion": "v1.2.2",
      "role": "structural-baseline",
      "statusKey": "status",
      "expectedSummaryKind": "post-create-structural",
      "requiredKeys": [
        "summary_kind",
        "status",
        "script_name",
        "script_version",
        "project_root",
        "devcontainer_version",
        "dockerfile_version",
        "package_json_version",
        "makefile_version",
        "script_audit_status",
        "endpoint_registry_file",
        "endpoint_registry_status",
        "endpoint_registry_rows",
        "endpoint_registry_bad_rows",
        "local_dns_expected",
        "manager_expected",
        "network_control_plane_expected",
        "state_file"
      ],
      "recommendedKeys": [
        "package_json_status",
        "makefile_status",
        "toolchain_contract_status",
        "toolchain_contract_missing",
        "toolchain_contract_report",
        "health_status_file",
        "health_summary_file",
        "health_report_file",
        "health_events_file",
        "sync_local_auth_status_file",
        "sync_local_auth_summary_file",
        "sync_local_auth_report_file"
      ],
      "optionalKeys": [],
      "acceptedStatusValues": ["ready-ok", "ready-degraded", "failed", "fatal"],
      "consumers": ["post-attach.sh", "network-control-plane-state.sh", "Makefile/package network:* summaries"],
      "criticalInvariants": [
        "summary_kind MUST be post-create-structural",
        "endpoint_registry_status=ok requires endpoint_registry_rows > 0 and endpoint_registry_bad_rows=0",
        "toolchain_contract_status=ok requires toolchain_contract_missing=0"
      ],
      "notes": [
        "post-create is structural only; it must not represent runtime DNS/proxy/route health. Runtime state belongs to post-start and network-control-plane."
      ]
    },
    "postStart.summary": {
      "path": "/tmp/devcontainer-post-start.summary",
      "format": "keyValueSummary",
      "producer": ".devcontainer/scripts/post-start.sh",
      "producerVersion": "v3.0.2",
