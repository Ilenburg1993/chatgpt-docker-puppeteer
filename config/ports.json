{
  "$schema": "./ports.schema.json",
  "version": "1.0.0",
  "description": "Centralized port configuration to avoid conflicts",
  "lastUpdated": "2026-01-30",
  "ports": {
    "chrome": {
      "primary": 9224,
      "alternatives": [
        19224,
        29224,
        39224
      ],
      "description": "Chrome Remote Debugging Protocol",
      "required": true,
      "autoDetectConflict": true,
      "autoResolve": true
    },
    "proxy": {
      "primary": 9224,
      "alternatives": [
        19224,
        29224,
        39224
      ],
      "description": "Chrome Proxy Service (WebSocket URL rewriting)",
      "required": true,
      "autoDetectConflict": true,
      "autoResolve": true
    },
    "server": {
      "primary": 3008,
      "alternatives": [
        3009,
        3010,
        3011
      ],
      "description": "Express API + Socket.io Dashboard",
      "required": true,
      "autoDetectConflict": true,
      "autoResolve": true
    },
    "reserved": {
      "description": "Ports reserved but not currently used",
      "ports": [
        9223
      ]
    }
  },
  "conflictResolution": {
    "strategy": "auto",
    "options": {
      "auto": "Automatically use first available alternative port",
      "ask": "Ask user which port to use",
      "kill": "Kill conflicting process (requires confirmation)",
      "fail": "Fail with error message"
    },
    "currentStrategy": "auto"
  },
  "logging": {
    "enabled": true,
    "logFile": "logs/port-manager.log",
    "logLevel": "info",
    "includeProcessInfo": true
  },
  "monitoring": {
    "enabled": true,
    "interval": 30000,
    "alertOnConflict": true
  }
}
