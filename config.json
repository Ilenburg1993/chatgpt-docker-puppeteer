{
  "// =====================================================================": "",
  "// CONFIGURAÇÃO GLOBAL — CHATGPT DOCKER PUPPETEER": "",
  "// Arquivo de controle operacional e cognitivo do sistema": "",
  "//": "",
  "// 🏗️ ARQUITETURA: Data/Logic Separation Pattern": "",
  "// =====================================================": "",
  "//": "",
  "// Este arquivo implementa a CAMADA DE DADOS da arquitetura de configuração.": "",
  "// A separação entre dados (JSON) e lógica (JavaScript) é INTENCIONAL e segue": "",
  "// padrões de engenharia de software consolidados (similar a Database + ORM).": "",
  "//": "",
  "// 📁 ESTRUTURA DO SISTEMA DE CONFIGURAÇÃO:": "",
  "//": "",
  "// ┌─────────────────────────────────────────────────────────────────────┐": "",
  "// │ config.json (ESTE ARQUIVO) — Camada de Dados                       │": "",
  "// │ • Formato: JSON declarativo (human-readable, VCS-friendly)          │": "",
  "// │ • Responsabilidade: Armazena valores de configuração persistentes   │": "",
  "// │ • Editável: Sim (manualmente ou via API)                            │": "",
  "// │ • Versionável: Sim (Git diffs limpos)                               │": "",
  "// │ • Validação: Nenhuma (raw data)                                     │": "",
  "// └─────────────────────────────────────────────────────────────────────┘": "",
  "//                                   ↓ require(PATHS.CONFIG)              ": "",
  "// ┌─────────────────────────────────────────────────────────────────────┐": "",
  "// │ src/core/config.js — Camada de Lógica (Smart Accessor)             │": "",
  "// │ • Formato: JavaScript module (EventEmitter singleton)               │": "",
  "// │ • Responsabilidade: Valida, cache, expõe getters reativos           │": "",
  "// │ • Validação: Zod schema (runtime type safety)                       │": "",
  "// │ • Cache: RAM (this.currentConfig)                                   │": "",
  "// │ • Hot-Reload: Sim (reload() method + events)                        │": "",
  "// │ • Events: Sim (EventEmitter - reatividade no sistema)               │": "",
  "// └─────────────────────────────────────────────────────────────────────┘": "",
  "//                                   ↓ require('@core/config')            ": "",
  "// ┌─────────────────────────────────────────────────────────────────────┐": "",
  "// │ 9+ Módulos Consumidores (Production Code)                           │": "",
  "// │ • ConnectionOrchestrator, Server, Kernel, Drivers, etc.             │": "",
  "// │ • Acesso: SEMPRE via src/core/config.js (NUNCA diretamente ao JSON) │": "",
  "// └─────────────────────────────────────────────────────────────────────┘": "",
  "//": "",
  "// ✅ BENEFÍCIOS DESTA ARQUITETURA:": "",
  "//": "",
  "// 1. Separation of Concerns: Dados vs Lógica (manutenibilidade)": "",
  "// 2. Type Safety: Validação Zod previne configs inválidas (robustez)": "",
  "// 3. Performance: RAM cache evita leituras de disco repetidas": "",
  "// 4. Hot-Reload: Atualização sem restart (zero downtime)": "",
  "// 5. Reactivity: EventEmitter permite reação a mudanças (pub/sub)": "",
  "// 6. Editability: JSON é human-friendly e API-writable (ergonomia)": "",
  "// 7. Version Control: Diffs limpos no Git (rastreabilidade)": "",
  "// 8. Abstraction: Camada lógica isola consumidores do formato físico": "",
  "//": "",
  "// ⚠️ ANTI-PATTERNS A EVITAR:": "",
  "//": "",
  "// ❌ NUNCA importe config.json diretamente: require('./config.json')": "",
  "// ✅ SEMPRE use o accessor: const CONFIG = require('@core/config')": "",
  "//": "",
  "// ❌ NUNCA escreva diretamente no JSON sem validação": "",
  "// ✅ SEMPRE use o endpoint API: PATCH /api/v1/config/dna": "",
  "//": "",
  "// ❌ NUNCA unifique config.json + config.js (quebraria abstrações)": "",
  "// ✅ SEMPRE mantenha separação Data/Logic (padrão de arquitetura)": "",
  "//": "",
  "// 📚 REFERÊNCIAS:": "",
  "//": "",
  "// • Next.js: next.config.js (lógica) + .env (dados)": "",
  "// • NestJS: ConfigModule (lógica) + .env (dados)": "",
  "// • TypeORM: ormconfig.json (dados) + DataSource class (lógica)": "",
  "//": "",
  "// 🔍 DEBUGGING:": "",
  "//": "",
  "// • Ver configuração atual: curl http://localhost:2998/api/v1/config/dna": "",
  "// • Recarregar config: CONFIG.reload('manual-trigger')": "",
  "// • Validar sintaxe: node -e \"require('./config.json');\"": "",
  "//": "",
  "// =====================================================================": "",
  "//": "",
  "// 🖥️ CENÁRIO CANÔNICO DE EXECUÇÃO:": "",
  "// =====================================================================": "",
  "//": "",
  "// • Host: Windows": "",
  "// • Container: Linux (DevContainer)": "",
  "// • Execução do app: Linux (Node.js)": "",
  "// • Browser real: Chrome externo no Windows": "",
  "// • Controle: Puppeteer via Remote DevTools + Chrome Proxy Service": "",
  "// =====================================================================": "",

  "// ---------------------------------------------------------------------": "",
  "// [A] MODO DE OPERAÇÃO DO BROWSER": "",
  "// ---------------------------------------------------------------------": "",
  "// launcher     → Puppeteer inicia o browser (NÃO usado aqui)": "",
  "// connect      → Conecta via browserURL (http://host:port)": "",
  "// wsEndpoint   → Conecta via WebSocket endpoint (CANÔNICO - USA PROXY)": "",
  "// auto         → Tenta todos com fallback automático": "",
  "BROWSER_MODE": "wsEndpoint",

  "// Endpoint DevTools do Chrome externo (Windows)": "",
  "// IMPORTANTE: Usa Chrome Proxy Service para resolver networking Docker↔Windows": "",
  "// Container não consegue acessar ws://localhost do Windows diretamente (use proxy container-facing na porta 9224)": "",
  "// Proxy reescreve URLs (localhost → IP público) e proxia WebSocket transparentemente": "",
  "DEBUG_PORT": "http://localhost:9224",

  "// =====================================================================": "",
  "// [A.1] CHROME PROXY CONFIGURATION": "",
  "// =====================================================================": "",
  "// DOCKER DESKTOP EDITION: Proxy acessa Chrome via host.docker.internal": "",
  "// Arquitetura: Container (Proxy 0.0.0.0:9224) → host.docker.internal:9225 → Chrome": "",
  "// Scripts:": "",
  "//   • Windows: START-CHROME-SIMPLE.bat (Chrome bind 0.0.0.0)": "",
  "//   • Container: wsl-chrome-integration.sh (validação + proxy)": "",
  "//   • Proxy:   scripts/chrome-proxy-service.js (Node.js puro)": "",
  "// Documentação: DOCUMENTAÇÃO/WSL_INTEGRATION_GUIDE.md": "",
  "// CHROME_PROXY_ENABLED: Desabilitado - proxy rodando como processo PM2 separado": "",
  "CHROME_PROXY_ENABLED": false,
  "CHROME_PROXY_HOST": "localhost",

  "// Fallback Strategy (gerenciado pelo ConnectionOrchestrator):": "",
  "// 1. Tenta localhost:9224 (proxy no próprio container) - PREFERENCIAL": "",
  "// 2. Tenta host.docker.internal:9224 (proxy via Docker DNS)": "",
  "// 3. Tenta host.docker.internal (conexão direta ao Chrome; porta é detalhe operacional)": "",
  "// 4. Tenta outras combinações (portas 9223, hosts 172.17.0.1, etc)": "",
  "ALLOW_BROWSER_FALLBACK": true,

  "// Permite reconnect automático se o browser remoto cair": "",
  "ALLOW_BROWSER_RECONNECT": true,
  "BROWSER_RECONNECT_INTERVAL_MS": 3000,
  "BROWSER_MAX_RECONNECT_ATTEMPTS": 20,

  "// ---------------------------------------------------------------------": "",
  "// [B] MODELO / LLM / CONTEXTO DE UI": "",
  "// ---------------------------------------------------------------------": "",
  "// Modelo preferencial (GPT-5.2 é o padrão, com fallback para GPT-5-mini)": "",
  "// O código deve tolerar divergência entre UI e ID nominal": "",
  "DEFAULT_MODEL_ID": "gpt-5.2",

  "// Permite downgrade automático se o modelo não estiver disponível": "",
  "ALLOW_MODEL_FALLBACK": true,
  "MODEL_FALLBACK_PRIORITY": ["gpt-5.2", "gpt-5-mini"],

  "// ---------------------------------------------------------------------": "",
  "// [C] CONCORRÊNCIA E PARALELISMO": "",
  "// ---------------------------------------------------------------------": "",
  "// Limite global de tarefas simultâneas": "",
  "MAX_CONCURRENT_TASKS": 1,

  "// Limite de passos paralelos dentro de uma mesma tarefa": "",
  "MAX_PARALLEL_STEPS": 1,

  "// Bloqueia paralelismo quando confiança do ambiente é baixa": "",
  "SERIALIZE_ON_LOW_CONFIDENCE": true,

  "// ---------------------------------------------------------------------": "",
  "// [D] TIMEOUTS OPERACIONAIS (ms)": "",
  "// ---------------------------------------------------------------------": "",
  "PROGRESS_TIMEOUT_MS": 60000,
  "TASK_TIMEOUT_MS": 180000,
  "STEP_TIMEOUT_MS": 60000,

  "// Janela para recuperação de estado RUNNING após stall": "",
  "RUNNING_RECOVERY_MS": 45000,

  "// Timeout máximo de espera por resposta visível da UI": "",
  "UI_RESPONSE_TIMEOUT_MS": 30000,

  "// ---------------------------------------------------------------------": "",
  "// [E] HEARTBEAT, WATCHDOG E DETECÇÃO DE FALHAS": "",
  "// ---------------------------------------------------------------------": "",
  "HEARTBEAT_INTERVAL_MS": 5000,
  "HEARTBEAT_TIMEOUT_MS": 20000,

  "// Janela de tolerância antes de o watchdog intervir": "",
  "WATCHDOG_GRACE_PERIOD_MS": 30000,

  "// Permite reinício automático do fluxo após falha crítica": "",
  "ALLOW_AUTORESTART_ON_WATCHDOG": true,

  "// ---------------------------------------------------------------------": "",
  "// [F] SERVIDOR INTERNO / CONTROLE DE CICLO DE VIDA": "",
  "// ---------------------------------------------------------------------": "",
  "SERVER_STARTUP_TIMEOUT_MS": 30000,
  "SERVER_SHUTDOWN_TIMEOUT_MS": 15000,

  "// Porta lógica do servidor interno (se aplicável)": "",
  "SERVER_PORT": 3008,

  "// Habilita TaskSyncBridge para sincronização realtime de tasks": "",
  "ENABLE_TASK_SYNC_BRIDGE": true,

  "// ---------------------------------------------------------------------": "",
  "// [G] POLÍTICAS DE SEGURANÇA E DOMÍNIOS": "",
  "// ---------------------------------------------------------------------": "",
  "// Lista branca explícita de domínios permitidos": "",
  "allowedDomains": ["chatgpt.com", "openai.com", "claude.ai", "gemini.google.com"],

  "// Bloqueia qualquer navegação fora da lista acima": "",
  "ENFORCE_DOMAIN_WHITELIST": true,

  "// ---------------------------------------------------------------------": "",
  "// [H] CONFIANÇA DO AMBIENTE / HEURÍSTICAS": "",
  "// ---------------------------------------------------------------------": "",
  "// Grau mínimo de confiança para habilitar recursos avançados": "",
  "// 0 = nunca confia | 1 = permissivo | 2 = estrito": "",
  "MIN_ENV_CONFIDENCE": 1,

  "// Ajuste dinâmico de comportamento baseado em confiança": "",
  "ADAPT_BEHAVIOR_BY_CONFIDENCE": true,

  "// ---------------------------------------------------------------------": "",
  "// [I] LOGGING, DIAGNÓSTICO E VERBOSIDADE": "",
  "// ---------------------------------------------------------------------": "",
  "LOG_LEVEL": "info",

  "// Emite eventos estruturados para debugging profundo": "",
  "ENABLE_STRUCTURED_LOGS": true,

  "// Mantém histórico estendido de decisões automáticas": "",
  "PERSIST_DECISION_TRACE": true,

  "// ---------------------------------------------------------------------": "",
  "// [J] FLAGS EXPERIMENTAIS / RESERVA ESTRUTURAL": "",
  "// ---------------------------------------------------------------------": "",
  "// Flags mantidas mesmo quando inativas — reserva arquitetural": "",
  "EXPERIMENTAL_UI_PROBING": false,
  "EXPERIMENTAL_MULTI_TAB": false,
  "EXPERIMENTAL_SELF_HEALING": false
}
