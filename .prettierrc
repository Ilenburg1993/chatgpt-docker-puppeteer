{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 4,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 120,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "quoteProps": "as-needed",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "plugins": [
    "prettier-plugin-packagejson",
    "prettier-plugin-sh",
    "prettier-plugin-organize-imports",
    "prettier-plugin-jsdoc"
  ],
  "jsdocCapitalizeDescription": false,
  "jsdocCommentLineStrategy": "keep",
  "jsdocVerticalAlignment": false,
  "jsdocSeparateTagGroups": false,
  "jsdocPrintWidth": 120,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", ".prettierrc", ".eslintrc"],
      "options": {
        "tabWidth": 2,
        "trailingComma": "none"
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "tabWidth": 2,
        "proseWrap": "always",
        "printWidth": 100
      }
    },
    {
      "files": ["package.json", "package-lock.json"],
      "options": {
        "tabWidth": 2,
        "trailingComma": "none"
      }
    }
  ]
}
