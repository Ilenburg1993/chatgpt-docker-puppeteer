# ============================================================================
# .env.local.example — Exemplo (copie para .env.local)
# chatgpt-docker-puppeteer
# ============================================================================
#
# Por segurança, este arquivo é um TEMPLATE (sem segredos).
# Para usar:
#   cp .env.local.example .env.local
#   # edite .env.local e preencha os campos necessários
#
# Nota:
# - A aplicação carrega `.env`, `.env.${NODE_ENV}`, `.env.local` e `.env.${NODE_ENV}.local`.
# - No DevContainer, os hooks também sincronizam `.env.local` para shells
#   e tentam persistir `gh` em ~/.config/gh quando houver
#   `GITHUB_PERSONAL_ACCESS_TOKEN`.
# - Para processos do VS Code fora do shell, prefira também exportar essas
#   mesmas variáveis no host (o devcontainer usa `${localEnv:*}` em remoteEnv).
# - Se a mesma chave existir em `.env*.local`, o valor local sobrescreve o do host.
# - Knobs avançados não sensíveis vivem em `.env.expert.example`; copie apenas
#   o que fizer sentido para `.env.local`.
#
# ============================================================================

# ============================================================================
# [0] Auth Global — GitHub / CLIs / Agentes
# ============================================================================
# GitHub CLI + automações locais:
# - `GH_TOKEN` / `GITHUB_TOKEN`: auth por ambiente (runtime)
# - `GITHUB_PERSONAL_ACCESS_TOKEN`: auth persistida do `gh`
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
COPILOT_GITHUB_TOKEN=

# ============================================================================
# [0.1] LLM Providers — chaves comuns
# ============================================================================
# OpenAI / compatíveis
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
COPILOT_BYOK_API_KEY=
COPILOT_BYOK_BEARER_TOKEN=
KILO_API_KEY=
KILO_CODE_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# Google / Gemini / Vertex
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=

# Open routers / agregadores / provedores alternativos
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# AWS Bedrock / runtime compatível com SDKs AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_DEFAULT_REGION=

# Ollama Cloud (já usado no projeto)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# ============================================================================
# [0.2] Copilot Terminal BYOK — arquivo unico do operador
# ============================================================================
# O operador deve inserir TODOS os segredos, perfis e metadados BYOK aqui.
# Exemplos:
#   /byok profiles
#   /byok use kilo
#   /byok use sdk
#   /byok model anthropic/claude-sonnet-4.5
#   /restart
COPILOT_BYOK_ENABLED=false
COPILOT_BYOK_PROFILE=
COPILOT_BYOK_MODEL_DISCOVERY_ENABLED=true
COPILOT_BYOK_MODEL_DISCOVERY_TIMEOUT_MS=7000
COPILOT_BYOK_MODEL_DISCOVERY_TTL_MS=300000
COPILOT_BYOK_PROFILES_JSON='{"kilo":{"preset":"kilo-code","model":"kilo-auto/free","models":"kilo-auto/free,kilo-auto/balanced,anthropic/claude-sonnet-4.5","bearerTokenEnv":"KILO_API_KEY","contextWindowTokens":200000,"supportsReasoning":true,"supportsVision":true,"metadata":{"owner":"terminal-llm-b","notes":"Kilo Gateway OpenAI-compatible via https://api.kilo.ai/api/gateway; default uses free route for smoke tests."}},"ollama-cloud":{"preset":"ollama-cloud","model":"qwen3-coder-next","apiKeyEnv":"OLLAMA_CLOUD_API_KEY","supportsReasoning":false,"supportsVision":false},"ollama-local":{"preset":"ollama-local","model":"qwen3-coder-next","baseUrl":"http://localhost:11434","supportsReasoning":false,"supportsVision":false}}'

# ============================================================================
# [1] GitHub MCP — Proxy/Upstream (server-side)
# ============================================================================
# Quando true, o servidor spawna o GitHub MCP via stdio e reexporta as tools como:
#   mcp_github__<toolName>
MCP_GITHUB_PROXY_ENABLED=false

# Prefixo das tools do GitHub importadas
MCP_GITHUB_TOOL_PREFIX=mcp_github__

# Como iniciar o GitHub MCP (stdio)
MCP_GITHUB_COMMAND=npx
MCP_GITHUB_ARGS_JSON='["-y","@modelcontextprotocol/server-github"]'

# Token: reaproveita `GITHUB_PERSONAL_ACCESS_TOKEN` definido acima

# Retry best-effort (se upstream falhar no boot ou cair durante calls)
MCP_UPSTREAM_RESTART_ENABLED=true
MCP_UPSTREAM_RESTART_BACKOFF_MS=5000
MCP_UPSTREAM_RESTART_MAX=10

# ============================================================================
# [2] Upstreams genéricos (opcional)
# ============================================================================
# Se setado, tem precedência sobre o legado MCP_UPSTREAM_*
MCP_UPSTREAMS_JSON=

# ============================================================================
# [3] Dashboard (opcional)
# ============================================================================
# DASHBOARD_PASSWORD=
