# ============================================================================
# .env.local.example — Exemplo (copie para .env.local)
# chatgpt-docker-puppeteer
# ============================================================================
#
# Por segurança, este arquivo é um TEMPLATE (sem segredos).
# Para usar:
#   cp .env.local.example .env.local
#   # edite .env.local e preencha os campos necessários
#
# Nota:
# - A aplicação carrega `.env`, `.env.${NODE_ENV}`, `.env.local` e `.env.${NODE_ENV}.local`.
# - No DevContainer, os hooks também sincronizam `.env.local` para shells
#   e tentam persistir `gh` em ~/.config/gh quando houver
#   `GITHUB_PERSONAL_ACCESS_TOKEN`.
# - Para processos do VS Code fora do shell, prefira também exportar essas
#   mesmas variáveis no host (o devcontainer usa `${localEnv:*}` em remoteEnv).
# - Se a mesma chave existir em `.env*.local`, o valor local sobrescreve o do host.
# - Knobs avançados não sensíveis vivem em `.env.expert.example`; copie apenas
#   o que fizer sentido para `.env.local`.
#
# ============================================================================

# ============================================================================
# [0] Auth Global — GitHub / CLIs / Agentes
# ============================================================================
# GitHub CLI + automações locais:
# - `GH_TOKEN` / `GITHUB_TOKEN`: auth por ambiente (runtime)
# - `GITHUB_PERSONAL_ACCESS_TOKEN`: auth persistida do `gh`
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
COPILOT_GITHUB_TOKEN=

# ============================================================================
# [0.1] LLM Providers — chaves comuns
# ============================================================================
# OpenAI / compatíveis
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
COPILOT_BYOK_API_KEY=
COPILOT_BYOK_BEARER_TOKEN=
KILO_API_KEY=
KILO_CODE_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# Google / Gemini / Vertex
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=

# Open routers / agregadores / provedores alternativos
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
GROQ_API_KEY=
GROQ_KEY=
MISTRAL_API_KEY=
MISTRAL_KEY=
HUGGING_FACE_API_KEY=
HUGGING_FACE_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_TOKEN_FILE=src/copilot/.ai/cloudflare/workspace-mcp-dev.token
CLOUDFLARE_TUNNEL_TOKEN=
COPILOT_MCP_AUTH_MODE=oauth
COPILOT_MCP_AUTH_ENFORCEMENT=all
COPILOT_MCP_PUBLIC_URL=https://mcp.aurelin.org/mcp
COPILOT_MCP_OAUTH_ISSUER=https://mcp.aurelin.org
COPILOT_MCP_OAUTH_EXPECTED_ISSUER=https://mcp.aurelin.org
COPILOT_MCP_OAUTH_AUDIENCE=https://mcp.aurelin.org
COPILOT_MCP_OAUTH_JWKS_URI=https://mcp.aurelin.org/oauth/jwks.json
COPILOT_MCP_OAUTH_INITIAL_SCOPES=repo:read,repo:write,repo:validate,repo:admin
COPILOT_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com
COPILOT_MCP_DEV_OAUTH_ENABLED=true
COPILOT_MCP_DEV_OAUTH_KEY_FILE=src/copilot/.ai/mcp/oauth-dev-private-key.pem
COPILOT_MCP_DEV_OAUTH_ROTATE_KEY=false
COPILOT_MCP_INDEX_AUTO_BUILD=true
COPILOT_MCP_INDEX_AUTO_BUILD_PATH=src/copilot
COPILOT_MCP_INDEX_AUTO_BUILD_MAX_FILES=5000
# Optional fallback only; do not enable for the canonical ChatGPT connector.
# COPILOT_MCP_STATIC_BEARER_TOKEN=
COPILOT_SDK_ENABLED=true
COPILOT_TERMINAL_ENABLED=true
COPILOT_MODEL=auto
COPILOT_MODEL_PERSISTENT_CACHE_ENABLED=true
LLM_B_TERMINAL_PORT=3009
NVIDIA_API_KEY=
NVIDIA_KEY=
CEREBRAS_API_KEY=
CEREBRAS_KEY=
CHUTES_API_KEY=
CHUTES_AI=
ZAI_API_KEY=
Z_AI_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# AWS Bedrock / runtime compatível com SDKs AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_DEFAULT_REGION=

# Ollama Cloud (já usado no projeto)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# ============================================================================
# [0.2] Copilot Terminal BYOK — arquivo unico do operador
# ============================================================================
# O operador deve inserir TODOS os segredos, perfis e metadados BYOK aqui.
# Exemplos:
#   /byok profiles
#   /byok use kilo
#   /byok use sdk
#   /byok model anthropic/claude-sonnet-4.5
#   /restart
COPILOT_BYOK_ENABLED=false
COPILOT_BYOK_PROFILE=
COPILOT_BYOK_MODEL_DISCOVERY_ENABLED=true
COPILOT_BYOK_MODEL_DISCOVERY_TIMEOUT_MS=7000
COPILOT_BYOK_MODEL_DISCOVERY_TTL_MS=300000
COPILOT_BYOK_PROFILES_JSON='{"kilo":{"preset":"kilo-code","model":"kilo-auto/free","models":"kilo-auto/free,kilo-auto/balanced,anthropic/claude-sonnet-4.5","bearerTokenEnv":"KILO_API_KEY","contextWindowTokens":200000,"supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"S","costPolicy":"free-first","owner":"terminal-llm-b"}},"ollama-cloud":{"preset":"ollama-cloud","model":"qwen3-coder-next","apiKeyEnv":"OLLAMA_CLOUD_API_KEY","supportsReasoning":false,"supportsVision":false,"metadata":{"tier":"S","source":"cloud"}},"ollama-local":{"preset":"ollama-local","model":"qwen3-coder-next","baseUrl":"http://localhost:11434","supportsReasoning":false,"supportsVision":false,"metadata":{"tier":"local","privacy":"local"}},"openrouter-free":{"preset":"openrouter","model":"openrouter/free","apiKeyEnv":"OPENROUTER_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"S","freeFirst":true,"docs":"https://openrouter.ai/docs/api-reference/models/get-models"}},"groq-free":{"preset":"groq","model":"qwen/qwen3-32b","apiKeyEnv":"GROQ_API_KEY","supportsReasoning":true,"supportsVision":false,"metadata":{"tier":"S","speed":"very-high","freeLimit":"6k TPM observed on current plan; route only compact/fresh turns unless upgraded"},"maxRequestTokens":6000,"tokensPerMinute":6000},"gemini-free":{"preset":"gemini","model":"gemini-2.5-flash","apiKeyEnv":"GEMINI_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"S","context":"very-large"}},"mistral-free":{"preset":"mistral","model":"codestral-latest","apiKeyEnv":"MISTRAL_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"S","coding":true}},"huggingface-free":{"preset":"huggingface","model":"openai/gpt-oss-120b:fastest","apiKeyEnv":"HUGGING_FACE_API_KEY","supportsReasoning":true,"supportsVision":false,"metadata":{"tier":"A","router":"auto"}},"cloudflare-workers-ai":{"preset":"cloudflare-workers-ai","model":"@cf/meta/llama-3.1-8b-instruct","apiKeyEnv":"CLOUDFLARE_API_TOKEN","supportsReasoning":false,"supportsVision":false,"metadata":{"tier":"A","requires":"CLOUDFLARE_ACCOUNT_ID"}},"nvidia-nim":{"preset":"nvidia-nim","model":"openai/gpt-oss-120b","apiKeyEnv":"NVIDIA_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"A","hosted":"integrate.api.nvidia.com"}},"cerebras-free":{"preset":"cerebras","model":"gpt-oss-120b","apiKeyEnv":"CEREBRAS_API_KEY","supportsReasoning":true,"supportsVision":false,"metadata":{"tier":"S","speed":"extreme"}},"chutes-ai":{"preset":"chutes","model":"Qwen/Qwen3-Next-80B-A3B-Instruct","apiKeyEnv":"CHUTES_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"S","endpoint":"https://llm.chutes.ai/v1"}},"zai":{"preset":"zai","model":"glm-4.6","apiKeyEnv":"ZAI_API_KEY","supportsReasoning":true,"supportsVision":true,"metadata":{"tier":"A","family":"GLM"}}}'

# ============================================================================
# [1] GitHub MCP — Proxy/Upstream (server-side)
# ============================================================================
# Quando true, o servidor spawna o GitHub MCP via stdio e reexporta as tools como:
#   mcp_github__<toolName>
MCP_GITHUB_PROXY_ENABLED=false

# Prefixo das tools do GitHub importadas
MCP_GITHUB_TOOL_PREFIX=mcp_github__

# Como iniciar o GitHub MCP (stdio)
MCP_GITHUB_COMMAND=npx
MCP_GITHUB_ARGS_JSON='["-y","@modelcontextprotocol/server-github"]'

# Token: reaproveita `GITHUB_PERSONAL_ACCESS_TOKEN` definido acima

# Retry best-effort (se upstream falhar no boot ou cair durante calls)
MCP_UPSTREAM_RESTART_ENABLED=true
MCP_UPSTREAM_RESTART_BACKOFF_MS=5000
MCP_UPSTREAM_RESTART_MAX=10

# ============================================================================
# [2] Upstreams genéricos (opcional)
# ============================================================================
# Se setado, tem precedência sobre o legado MCP_UPSTREAM_*
MCP_UPSTREAMS_JSON=

# ============================================================================
# [3] Dashboard (opcional)
# ============================================================================
# DASHBOARD_PASSWORD=
